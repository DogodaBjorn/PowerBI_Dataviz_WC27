        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "THIS REPORT REFUSES TO CLAIM",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#B5AFA0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Inflation-adjusted money. ",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#F2EFE6"
                    }
                  },
                  {
                    "value": "USD as recorded; a 1970 dollar is not a 2020 dollar.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#B5AFA0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "True profit and loss. ",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#F2EFE6"
                    }
                  },
                  {
                    "value": "Revenue minus budget is a gross gap, not a P&L.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#B5AFA0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Distinct film counts. ",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#F2EFE6"
                    }
                  },
                  {
                    "value": "Listings are rows; duplicate title-and-date pairs are counted at left.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#B5AFA0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Full-catalogue claims. ",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#F2EFE6"
                    }
                  },
                  {
                    "value": "A listing can only be judged on a bar it clears.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#B5AFA0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What popularity means. ",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#F2EFE6"
                    }
                  },
                  {
                    "value": "TMDB does not publish the formula, so it is ranked under protest and never called quality.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#B5AFA0"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Causation of any kind. ",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#F2EFE6"
                    }
                  },
                  {
                    "value": "The payoff page shows that money and evidence coincide in a few listings. It does not say why, and neither do I.",
                    "textStyle": {
                      "fontFamily": "Arial",
                      "fontSize": "10pt",
                      "color": "#B5AFA0"
                    }
                  }
                ]
              }
            ]
          }
