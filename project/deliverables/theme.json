{
  "$schema": "https://raw.githubusercontent.com/microsoft/powerbi-desktop-samples/main/Report%20Theme%20JSON%20Schema/reportThemeSchema-2.159.json",
  "name": "Goodnight Inn (goodnight-inn-hanger)",
  "dataColors": [
    "#B5175F",
    "#3E2C55",
    "#82798A",
    "#B8B0BE",
    "#D9D2CC"
  ],
  "accent": "#B5175F",
  "good": "#1D5FA8",
  "neutral": "#82798A",
  "bad": "#B45309",
  "minimum": "#B45309",
  "center": "#DCD6DA",
  "maximum": "#1D5FA8",
  "null": "#D9D2CC",
  "background": "#FFFFFF",
  "secondaryBackground": "#F5F3F0",
  "backgroundLight": "#FFFFFF",
  "backgroundNeutral": "#E4DEE3",
  "foreground": "#24192B",
  "foregroundNeutralSecondary": "#5B5163",
  "firstLevelElements": "#24192B",
  "secondLevelElements": "#5B5163",
  "thirdLevelElements": "#E4DEE3",
  "fourthLevelElements": "#82798A",
  "tableAccent": "#B5175F",
  "shapeStroke": "#E4DEE3",
  "disabledText": "#82798A",
  "hyperlink": "#B5175F",
  "visitedHyperlink": "#B5175F",
  "textClasses": {
    "callout": {
      "fontFace": "Verdana",
      "fontSize": 26,
      "color": "#24192B"
    },
    "largeTitle": {
      "fontFace": "Trebuchet MS",
      "fontSize": 20,
      "color": "#24192B"
    },
    "title": {
      "fontFace": "Trebuchet MS",
      "fontSize": 13,
      "color": "#24192B"
    },
    "header": {
      "fontFace": "Verdana",
      "fontSize": 11,
      "color": "#24192B"
    },
    "label": {
      "fontFace": "Verdana",
      "fontSize": 11,
      "color": "#24192B"
    },
    "semiboldLabel": {
      "fontFace": "Verdana",
      "fontSize": 11,
      "color": "#24192B"
    },
    "boldLabel": {
      "fontFace": "Verdana",
      "fontSize": 11,
      "color": "#24192B"
    },
    "largeLabel": {
      "fontFace": "Verdana",
      "fontSize": 13,
      "color": "#24192B"
    },
    "smallLabel": {
      "fontFace": "Verdana",
      "fontSize": 10,
      "color": "#24192B"
    },
    "lightLabel": {
      "fontFace": "Verdana",
      "fontSize": 11,
      "color": "#5B5163"
    },
    "largeLightLabel": {
      "fontFace": "Verdana",
      "fontSize": 13,
      "color": "#5B5163"
    },
    "smallLightLabel": {
      "fontFace": "Verdana",
      "fontSize": 10,
      "color": "#5B5163"
    },
    "dataTitle": {
      "fontFace": "Verdana",
      "fontSize": 10,
      "color": "#5B5163"
    },
    "smallDataLabel": {
      "fontFace": "Verdana",
      "fontSize": 10,
      "color": "#24192B"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#E4DEE3"
              }
            },
            "radius": 12,
            "width": 1
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ],
        "title": [
          {
            "show": true,
            "fontFamily": "Trebuchet MS",
            "fontSize": 13,
            "fontColor": {
              "solid": {
                "color": "#24192B"
              }
            },
            "bold": true
          }
        ],
        "subTitle": [
          {
            "fontFamily": "Verdana",
            "fontSize": 10,
            "fontColor": {
              "solid": {
                "color": "#5B5163"
              }
            }
          }
        ],
        "visualHeader": [
          {
            "show": true,
            "foreground": {
              "solid": {
                "color": "#5B5163"
              }
            },
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "visualTooltip": [
          {
            "fontFamily": "Verdana",
            "fontSize": 10,
            "background": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "titleFontColor": {
              "solid": {
                "color": "#5B5163"
              }
            },
            "valueFontColor": {
              "solid": {
                "color": "#24192B"
              }
            }
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F5F3F0"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F5F3F0"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
}
