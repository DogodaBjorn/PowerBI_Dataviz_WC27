                      "fontSize": "16px",
                      "color": "#12233D"
                    }
                  },
                  {
                    "value": "  net present value: benefits minus capex and disruption through 2032, in 2025 dollars at the organisers' rate.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
