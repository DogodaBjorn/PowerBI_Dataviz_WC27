		sortByColumn: Sort
		lineageTag: 6fe3fcca-cd0e-5bc6-bd9a-f206d947c552
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Title]

	column Sort
		dataType: int64
		formatString: 0
		lineageTag: 38a3f411-b75a-5007-ad7d-f35383134f8b
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Sort]

	partition WaitOption = calculated
		mode: import
		source = ```
				DATATABLE ( "Key", STRING, "Title", STRING, "Sort", INTEGER, { { "B", "B · Breakfast instead of kiosks", 1 }, { "T2", "Tranche 2 · Airport extensions, +80 rooms", 2 }, { "T3", "Tranche 3 · The refresh of the 10 oldest hotels (in package C)", 3 } } )
				```

	annotation PBI_ResultType = Table
