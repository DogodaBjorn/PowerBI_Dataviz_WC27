/// The three options that wait (What waits, and why): package B and tranches 2 and 3. Disconnected row source of the What-waits table: its measures switch on Key.
table WaitOption
	lineageTag: 7af52c5f-1b1e-51df-ad0f-607f5a088584

	column Key
		dataType: string
		lineageTag: fd03f0fd-a068-53c8-8e74-b3f83129f552
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Key]

	column Title
