/// Brand dimension with the investment budget per brand.
table Brands
	lineageTag: 74b777e8-06f0-5160-adb1-44b521338dfe

	column Brand
		dataType: string
		lineageTag: 17a5d7ae-4ba9-54e0-8df7-013a8e070d07
		summarizeBy: none
		sourceColumn: Brand

	column InvestmentBudgetUSD
		dataType: int64
		formatString: 0
		lineageTag: 4e2f1d0a-cc7e-5ecd-9813-207a7604ace5
		summarizeBy: none
		sourceColumn: InvestmentBudgetUSD


	partition Brands = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Excel.Workbook(Web.Contents(DataFile), null, true),
				    Sheet = Source{[Item="Brands",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"Brand", "InvestmentBudgetUSD"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"Brand", type text}, {"InvestmentBudgetUSD", Int64.Type}})
				in
				    Typed


	annotation PBI_ResultType = Table
