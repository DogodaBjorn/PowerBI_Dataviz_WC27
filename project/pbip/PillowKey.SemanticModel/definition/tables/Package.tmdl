		sourceColumn: [Growth]

	column CapexUSD
		dataType: double
		formatString: \$#,0;(\$#,0)
		lineageTag: 8aa117a6-e7b4-51bb-ba48-ea1e6ccb4a55
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [CapexUSD]

	column ContainsRefresh
		dataType: string
		lineageTag: f5c5b788-2523-5a66-ba0b-f528d7213720
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [ContainsRefresh]

	column RoomsAdded
		dataType: int64
		formatString: #,0
		lineageTag: a285f82e-f8f7-547e-a34a-c80081ca48c0
		summarizeBy: none
