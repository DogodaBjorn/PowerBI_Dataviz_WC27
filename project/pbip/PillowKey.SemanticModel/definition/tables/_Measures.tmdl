	/// Build comparison chart: the cumulative net impact of the plan being built while it is within the budget (the Night line); blank over the budget and while nothing is picked.
	measure 'Build Cumulative Line' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( NOT over, [Build Cumulative Net (sel)] )
		formatString: +\$#,0,,.\M;−\$#,0,,.\M;\$0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 83f0320b-6489-542f-8850-3980e606cc13

	/// Build comparison chart: the same line while the plan is over the budget (drawn in Tangerine); blank otherwise.
	measure 'Build Cumulative Line (over)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( over, [Build Cumulative Net (sel)] )
		formatString: +\$#,0,,.\M;−\$#,0,,.\M;\$0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 58435927-58d8-5bd6-8c1f-42dbcf90003c

