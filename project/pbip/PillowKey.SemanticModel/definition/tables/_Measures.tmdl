	/// F3 bars: response-weighted NPS 2025 with its label as finished text ('+6.8', a true minus), so no session locale prints a decimal comma.
	measure 'NPS 2025 (label-safe)' = [NPS (weighted) 2025]
		displayFolder: 15 Storytelling rebuild
		lineageTag: d6dee643-6c63-52ae-b181-d807054cb277

		formatStringDefinition = ```
				VAR __t = ( VAR __q = ( [NPS (weighted) 2025] ) RETURN IF ( ROUND ( __q, 1 ) = 0, "0.0", IF ( __q < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __q ), "0.0", "en-US" ) ) ) RETURN """" & __t & """;""" & __t & """;""" & __t & """"
				```

	/// Build bar chart (BuildMove): the NPV through 2032 of a picked move alone, scenario in view; blank for a move that is not picked, so the chart lists the plan only.
	measure 'Build Bar NPV' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR me = SELECTEDVALUE ( BuildMove[ProjectID] ) RETURN IF ( n > 0 && me IN ids, CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = me ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8a83f685-d73a-5b44-b51c-5ab7d4d448f3

	/// Build bar chart: the picked move's NPV with its label as finished text ('+$3.4M', '−$0.6M').
	measure 'Build Bar NPV (label-safe)' = [Build Bar NPV]
		displayFolder: 15 Storytelling rebuild
		lineageTag: 106e2b5d-f778-5109-b4e7-7ac45b9b6116

		formatStringDefinition = ```
				VAR __t = ( VAR __v = ( [Build Bar NPV] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) RETURN """" & __t & """;""" & __t & """;""" & __t & """"
				```

	/// Build bar chart: Night for a move that adds NPV (Night is 'your plan'), Tangerine for one that costs NPV; the signed label carries it too (R-G3).
	measure 'Build Bar Color' = VAR v = [Build Bar NPV] RETURN IF ( ISBLANK ( v ), BLANK (), IF ( ROUND ( v / 1000000, 2 ) < 0, "#E05A22", "#12233D" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8c5cc901-0e8c-53be-8ce9-1dcc1bb4c219

	/// F1 stacked area, the band on top of the margin after commissions: what the booking channels take, in points of revenue (margin before minus margin after commissions).
	measure 'Trend Commission Take GI' = [Trend Margin before GI] - [Trend Margin after GI]
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: c09d8765-3c7f-5290-be4b-26db5a9fcf3f

	/// F2 chart, end labels of the Goodnight Inn line: the OTA share in the first and the last year of the data only. Whole percent, so it needs no label-safe twin.
	measure 'Trend OTA GI (ends)' = VAR __y = SELECTEDVALUE ( 'Date'[Year] ) VAR __y0 = YEAR ( CALCULATE ( MIN ( MonthlyPerformance[Month] ), REMOVEFILTERS () ) ) VAR __y1 = YEAR ( CALCULATE ( MAX ( MonthlyPerformance[Month] ), REMOVEFILTERS () ) ) RETURN IF ( __y = __y0 || __y = __y1, [Trend OTA GI] )
		formatString: 0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 56380a9b-c61b-5359-8785-81247eaf25cd

	/// F2 chart, end label of the sister brands' line: the OTA share in the last year of the data only. Whole percent.
	measure 'Trend OTA Sisters (end)' = VAR __y = SELECTEDVALUE ( 'Date'[Year] ) VAR __y0 = YEAR ( CALCULATE ( MIN ( MonthlyPerformance[Month] ), REMOVEFILTERS () ) ) VAR __y1 = YEAR ( CALCULATE ( MAX ( MonthlyPerformance[Month] ), REMOVEFILTERS () ) ) RETURN IF ( __y = __y1, [Trend OTA Sisters] )
		formatString: 0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 6e56b466-14b9-5fb3-b637-f22e02aed46b

	/// F4 dot plot, the hotel's row: Airport 3, City 2, Highway 1. A hotel within one point of occupancy of another in its row steps 0.3 off the row, alternately below and above in order of 2025 occupancy (Gatwick below, Montréal above), so close dots stay apart. For a location type (the average markers) the row itself. A layout value, not a metric.
	measure 'F4 Row Y' = VAR base = SWITCH ( SELECTEDVALUE ( Hotels[LocationType] ), "Airport", 3, "City", 2, "Highway", 1 ) VAR me = SELECTEDVALUE ( Hotels[HotelID] ) VAR t = SELECTEDVALUE ( Hotels[LocationType] ) VAR br = SELECTEDVALUE ( Hotels[Brand] ) RETURN IF ( ISBLANK ( me ), base, VAR rw = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Hotels ), Hotels[LocationType] = t, Hotels[Brand] = br ), "@o", VAR hid = Hotels[HotelID] RETURN CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), Hotels[HotelID] = hid ) ) VAR near = FILTER ( rw, VAR o = [@o] VAR hid = Hotels[HotelID] RETURN COUNTROWS ( FILTER ( rw, Hotels[HotelID] <> hid && ABS ( [@o] - o ) < 0.01 ) ) > 0 ) VAR myo = MAXX ( FILTER ( rw, Hotels[HotelID] = me ), [@o] ) VAR k = COUNTROWS ( FILTER ( near, [@o] >= myo ) ) RETURN base + IF ( COUNTROWS ( FILTER ( near, Hotels[HotelID] = me ) ) > 0, IF ( MOD ( k, 2 ) = 1, -0.3, 0.3 ), 0 ) )
		formatString: 0.0
		displayFolder: 15 Storytelling rebuild
		lineageTag: 943df758-9e97-5d65-88ee-599f1e8a17d3

	/// F4 dot plot: Night for the seven fullest hotels of the brand in 2025, Warm Grey for the rest (R-G3: no blue on page 1's marks). The seven are named beside their dots.
	measure 'F4 Dot Color' = VAR me = SELECTEDVALUE ( Hotels[HotelID] ) VAR br = SELECTEDVALUE ( Hotels[Brand] ) VAR t7 = TOPN ( 7, ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Hotels ), Hotels[Brand] = br ), "@o", VAR hid = Hotels[HotelID] RETURN CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), Hotels[HotelID] = hid ) ), [@o], DESC ) RETURN IF ( ISBLANK ( me ), BLANK (), IF ( COUNTROWS ( FILTER ( t7, Hotels[HotelID] = me ) ) > 0, "#12233D", "#8E897D" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: c67f418d-da2a-5885-824a-18f287ff91a0

	/// F4 dot plot, the average markers: 2025 occupancy of the location type in context (rooms sold over rooms available, not an average of hotel percentages).
	measure 'F4 Type Avg' = [Occupancy % 2025]
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 954f17f1-5a63-5b94-86f0-94c7b247f82f

	/// Months, of the last 24 in the data, in which the hotels in context sold 90 percent or more of their available room nights ('topped 90%': the month's occupancy at or above 90%).
	measure 'Months Topped 90% (last 24)' = VAR d1 = CALCULATE ( MAX ( MonthlyPerformance[Month] ), REMOVEFILTERS () ) VAR d0 = EDATE ( d1, -23 ) VAR mths = CALCULATETABLE ( VALUES ( MonthlyPerformance[Month] ), REMOVEFILTERS ( 'Date' ), MonthlyPerformance[Month] >= d0 ) RETURN COUNTROWS ( FILTER ( mths, CALCULATE ( DIVIDE ( SUM ( MonthlyPerformance[RoomsSold] ), SUM ( MonthlyPerformance[RoomsAvailable] ) ), REMOVEFILTERS ( 'Date' ) ) >= 0.9 ) ) + 0
		formatString: 0
		displayFolder: 15 Storytelling rebuild
		lineageTag: e363be7a-ef25-51e1-8c4c-0f5f2096ce95

	/// Staff cost in the period (part of operating expenses).
	measure 'Staff Cost' = SUM ( MonthlyPerformance[StaffCost] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 15 Storytelling rebuild
		lineageTag: e8364872-adaf-5518-86ea-e707a242bb84

	/// Staff cost as a share of total revenue (F1 note: running costs).
	measure 'Staff Cost % of Revenue' = DIVIDE ( [Staff Cost], [Total Revenue] )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 70fbd61b-b34b-57af-a907-1da1e7835d71

	/// Page-1 subtitle (R-P1-1): the year, the comparison and the audience.
	measure 'Subtitle P1 Briefing (text)' = VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) - 1 RETURN "Goodnight Inn in " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Base year" ) & ", against the " & ( VAR __n = n RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " other Pillow & Key Group brands. For the Board: what is wrong, before page 2 says what to fund."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 2ad9557c-7c91-562a-80f7-7bab191f019c

	/// F1 note (R-P1-3, N-2): the 2023-2025 fall of the margin after commissions split into commissions and running costs, the staff share as the main running cost, and room-rate growth since 2023 against the sister brands (plan 09 R1).
	measure 'F1 Note (text)' = VAR gn = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN 1 * CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > 1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) VAR c23 = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) - CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) VAR c25 = gn - CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR comm = ROUND ( ( c25 - c23 ) * 100, 1 ) VAR ops = ROUND ( ( CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) - gn ) * 100, 1 ) VAR s23 = CALCULATE ( [Staff Cost % of Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) VAR s25 = CALCULATE ( [Staff Cost % of Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR pa = ROUND ( DIVIDE ( CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ), CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) ) - 1, 3 ) VAR plo = ROUND ( MINX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN DIVIDE ( CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ), CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) ) - 1 ), 3 ) VAR phi = ROUND ( MAXX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN DIVIDE ( CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ), CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) ) - 1 ), 3 ) RETURN IF ( comm > 0 && ops > 0, "Commissions took " & FORMAT ( comm, "0.0", "en-US" ) & " of those points and running costs " & FORMAT ( ops, "0.0", "en-US" ) & " (staff " & IF ( s25 >= s23, "rose", "fell" ) & " from " & ( VAR __p = ( s23 ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " to " & ( VAR __p = ( s25 ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " of revenue). ", "" ) & "Room rates " & IF ( pa < 0, "fell ", "rose " ) & ( VAR __p = ( ABS ( pa ) ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & ", " & IF ( pa > phi, "faster than the other brands.", IF ( pa < plo, "slower than the other brands.", "in line with the other brands, so no price premium absorbs it." ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: f88fcce5-b25b-5b98-9232-84c61d5be430

	/// F2 note (R-P1-4): what booking direct changes for one room night (from the folio's shown amounts), the bridge to member rates, and the 2021-mix counterfactual.
	measure 'F2 Note (text)' = VAR o = ROUND ( DIVIDE ( CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ), CALCULATE ( [Channel Room Nights], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ) ), 2 ) VAR oc = ROUND ( DIVIDE ( CALCULATE ( [Distribution Cost], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ), CALCULATE ( [Channel Room Nights], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ) ), 2 ) VAR d = ROUND ( DIVIDE ( CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ), CALCULATE ( [Channel Room Nights], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ) ), 2 ) VAR dc = ROUND ( DIVIDE ( CALCULATE ( [Distribution Cost], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ), CALCULATE ( [Channel Room Nights], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ) ), 2 ) VAR dp = d - o VAR dk = ( d - dc ) - ( o - oc ) VAR x = CALCULATE ( [Distribution Cost above 2021 Mix 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) RETURN "Booked direct, the guest pays " & FORMAT ( ABS ( dp ), "$#,0.00", "en-US" ) & IF ( dp >= 0, " more", " less" ) & " and we keep " & FORMAT ( ABS ( dk ), "$#,0.00", "en-US" ) & IF ( dk >= 0, " more", " less" ) & ". " & IF ( dp >= 0, "Nothing rewards the guest for booking direct; member rates change that. ", "" ) & "At the 2021 channel mix, 2025 commissions would be " & ( VAR __v = ( ABS ( x ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & IF ( x >= 0, " lower.", " higher." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 4a63674e-4605-5afd-b76e-8aa3d1771daf

	/// F3 count line (R-P1-5): how many hotels the three age bands hold, counted from the model (hotels with and without a renovation date).
	measure 'F3 Count (text)' = VAR nAll = CALCULATE ( COUNTROWS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) VAR dated = CALCULATE ( COUNTROWS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", NOT ISBLANK ( Hotels[Renovation Age Sort] ) ) VAR u = nAll - dated RETURN dated & " of " & nAll & " hotels" & IF ( u = 0, ".", "; " & u & IF ( u = 1, " has", " have" ) & " no renovation date." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: c5f7dd9b-42a4-5e94-88dc-ea6b5c0acfe3

	/// F3 note (R-P1-5): renovation spend per hotel since 2018 against the sister brands, the last start, and the causality caveat (05 caveat A2).
	measure 'F3 Note (text)' = VAR sp = CALCULATE ( [Renovation Spend per Hotel since 2018], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ) ) VAR lo = MINX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN CALCULATE ( [Renovation Spend per Hotel since 2018], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ) ) ) VAR hi = MAXX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN CALCULATE ( [Renovation Spend per Hotel since 2018], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ) ) ) VAR last = YEAR ( CALCULATE ( MAX ( Renovations[StartDate] ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ) ) ) VAR o1 = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[Renovation Age Sort] = 1 ) VAR o2 = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[Renovation Age Sort] = 2 ) VAR o3 = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[Renovation Age Sort] = 3 ) VAR olo = MIN ( MIN ( o1, o2 ), o3 ) VAR ohi = MAX ( MAX ( o1, o2 ), o3 ) RETURN "Since 2018 Goodnight Inn spent " & ( VAR __v = ( sp ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " per hotel on renovation; the other brands spent " & ( VAR __v = ( lo ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " to " & ( VAR __v = ( hi ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ". " & "None has started since " & last & ". " & IF ( ohi - olo <= 0.02, "Older hotels lose guest loyalty before they lose rooms: an association, not proof of cause.", "An association, not proof of cause." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 62309ed8-b20e-5b90-a712-b484b5504f9e

	/// F4 title (R-P1-6): the hotel that topped 90 % occupancy in the most of the last 24 months; 'our airports run full' while the airports are the fullest location type and it is one.
	measure 'F4 Title (text)' = VAR hs = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[Brand] = "Goodnight Inn" ), "@m", VAR h = Hotels[HotelID] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@o", VAR h = Hotels[HotelID] RETURN CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ) ) VAR th = MAXX ( TOPN ( 1, hs, [@m], DESC, [@o], DESC ), Hotels[HotelID] ) VAR tm = MAXX ( FILTER ( hs, Hotels[HotelID] = th ), [@m] ) VAR air = [Occupancy Airport GI] VAR best = MAX ( [Occupancy City GI], [Occupancy Highway GI] ) RETURN IF ( air >= best && LOOKUPVALUE ( Hotels[LocationType], Hotels[HotelID], th ) = "Airport", "Our airports run full: ", "" ) & LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], th ) & " topped 90% occupancy in " & tm & " of the last 24 months"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 79e91d5d-ce2c-5b0a-9f13-a6f95fcf6a5e

	/// F4 note: the next two hotels by months topped 90 %, and the one extension on offer outside them (Kingston) with its count.
	measure 'F4 Note (text)' = VAR hs = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[Brand] = "Goodnight Inn" ), "@m", VAR h = Hotels[HotelID] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@o", VAR h = Hotels[HotelID] RETURN CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ) ) VAR t3 = TOPN ( 3, hs, [@m], DESC, [@o], DESC ) VAR h1 = MAXX ( TOPN ( 1, t3, [@m], DESC, [@o], DESC ), Hotels[HotelID] ) VAR r2 = FILTER ( t3, Hotels[HotelID] <> h1 ) VAR h2 = MAXX ( TOPN ( 1, r2, [@m], DESC, [@o], DESC ), Hotels[HotelID] ) VAR h3 = MAXX ( FILTER ( r2, Hotels[HotelID] <> h2 ), Hotels[HotelID] ) VAR ext = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Category], InvestmentProjects[Brand] ), InvestmentProjects[Category] = "Expansion" && InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID] ) VAR eh =ADDCOLUMNS ( ext, "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR other = FILTER ( eh, NOT ( [@h] IN { h1, h2, h3 } ) ) VAR kh = MAXX ( other, [@h] ) VAR km = MAXX ( FILTER ( hs, Hotels[HotelID] = kh ), [@m] ) RETURN LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], h2 ) & " did in " & MAXX ( FILTER ( hs, Hotels[HotelID] = h2 ), [@m] ) & ", " & LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], h3 ) & " in " & MAXX ( FILTER ( hs, Hotels[HotelID] = h3 ), [@m] ) & IF ( COUNTROWS ( other ) = 1, "; " & LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], kh ) & ", the " & ( VAR __n = COUNTROWS ( ext ) RETURN SWITCH ( __n, 1, "first", 2, "second", 3, "third", 4, "fourth", 5, "fifth", FORMAT ( __n, "0", "en-US" ) & "th" ) ) & " extension on offer, in " & IF ( km = 0, "none", FORMAT ( km, "0", "en-US" ) ), "" ) & "."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: ba103e85-65ac-5f63-a5f2-c2b65ae81a6b

	/// Page-2 headline (D6, doc 22 section 4): what A costs now and what it earns a year by 2032, scenario in view.
	measure 'Headline P2 (text)' = "Fix the middleman first: " & ( VAR __v = ( [Rec Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " now earns " & ( VAR __v = ( [Rec Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: fdde1c1c-b230-5954-8801-4288f3ba71ae

	/// Page-2 subtitle (R-P2-1): the budget that waits for the gate, the case in view, and the valuation rule with why the yearly figure is shown too.
	measure 'Subtitle P2 (text)' = VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR h = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) RETURN "The other " & ( VAR __v = ( budget - [Rec Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " waits for one Board decision in mid-2028. " & [Selected Scenario] & " case. NPV through " & h & " at " & FORMAT ( LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ), "0%", "en-US" ) & " in " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Base year" ) & " dollars is the contest's rule and counts nothing after " & h & ", so we also show what each move earns a year once it is live."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 2db176a3-ef97-52f9-a12f-36e38557f148

	/// Page-2 source line (R-P2-12): the source and the three valuation parameters, read from FinanceParameters.
	measure 'Footer P2 (text)' = "Source: Pillow & Key Group dataset and finance parameters (" & FORMAT ( LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ), "0%", "en-US" ) & " discount rate, " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Base year" ) & " dollars, horizon " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "). Parts are rounded to add up."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8ac5c564-37f8-574e-8b35-36e5c61646be

	/// Hero and selector row: the move's 'a year on cost', scenario in view.
	measure 'Move Yield (text)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) RETURN IF ( ISBLANK ( p ), BLANK (), VAR y = CALCULATE ( [A Year on Cost], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) RETURN ( VAR __p = ( y ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 28846e23-8a61-58f0-afc0-c75b9eff12f7

	/// Hero row: the move's decision status as a word (A, 2028 gate, not now): status is a word first, a colour second (P-6).
	measure 'Move Status (text)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) RETURN IF ( ISBLANK ( p ), BLANK (), LOOKUPVALUE ( MoveDecision[Status], MoveDecision[ProjectID], p ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 483746bc-13c4-5f13-bed5-620e60e52ee6

	/// Selector row: the move's profit a year by 2032 as text.
	measure 'Move Run-rate (text)' = VAR v = [Move Run-rate (num)] RETURN IF ( ISBLANK ( v ), BLANK (), ( VAR __v = ( v ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: d5693e44-fef2-50ac-8dc3-a0e4695bb7d8

	/// Hero title (R-P2-3): how many moves pass both tests (a year on cost at or above our cost of money, NPV through 2032 at least zero), then the first move in hero order that passes the first test only. Scenario in view; the order never moves.
	measure 'Hero Title (text)' = VAR t = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Brand], InvestmentProjects[Hero Sort] ), InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID], "@o", InvestmentProjects[Hero Sort] ), "@y", VAR p = [@p] RETURN CALCULATE ( [A Year on Cost], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR k = COUNTROWS ( FILTER ( t, ROUND ( [@y], 3 ) >= LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ) && ROUND ( [@v] / 1000000, 2 ) >= 0 ) ) + 0 VAR f = TOPN ( 1, FILTER ( t, ROUND ( [@y], 3 ) >= LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ) && NOT ( ROUND ( [@v] / 1000000, 2 ) >= 0 ) ), [@o], ASC ) VAR fp = MAXX ( f, [@p] ) VAR fy = MAXX ( f, [@y] ) VAR pl = ( fp IN { "GI-02" } ) RETURN ( VAR __w = ( VAR __n = k RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) RETURN UPPER ( LEFT ( __w, 1 ) ) & MID ( __w, 2, 500 ) ) & IF ( k = 1, " move passes", " moves pass" ) & " both tests" & IF ( ISBLANK ( fp ), "", "; the " & SWITCH ( fp, "GI-01", "booking app", "GI-02", "kiosks", "GI-03", "energy programme", "GI-04", "Toronto extension", "GI-05", "Gatwick extension", "GI-06", "Kingston extension", "GI-07", "refresh", "GI-08", "Boston hotel", "GI-09", "breakfast upgrade", "GI-10", "revenue management system", "" ) & IF ( pl, " earn ", " earns " ) & ( VAR __p = ( fy ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost but " & IF ( pl, "pay", "pays" ) & " back after " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: f6a8d74e-cd60-5ac2-98c3-3986ae2047ac

	/// Decision card: A's 'a year on cost', scenario in view.
	measure 'Rec A Year on Cost (text)' = ( VAR __p = ( [Rec A Year on Cost (sel)] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 338c6458-504b-5f40-bf68-28eeda6807d8

	/// Decision card, line 1 (R-P2-6): the downside, always the Low case.
	measure 'Rec Line 1 (text)' = VAR rr = [Rec Run-rate Low] RETURN "Worst case (Low): " & ( VAR __v = ( [Rec NPV Low] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ", and " & IF ( rr > 0, "still ", "" ) & ( VAR __v = ( rr ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 67815844-3fbc-53db-a271-b5c39482d257

	/// Decision card, line 2 (R-P2-6, E13): how much of A the booking app carries (NPV, or the yearly figure when A does not pay back by 2032), and what each year without it leaves with the agencies.
	measure 'Rec Line 2 (text)' = VAR npv = [Rec NPV (sel)] RETURN "The app carries it: " & IF ( ROUND ( npv / 100000, 0 ) < 0, ( VAR __v = ( [App Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " of that " & ( VAR __v = ( [Rec Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), ( VAR __v = ( [App NPV (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " of the " & ( VAR __v = ( npv ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) ) & ". Every year without it leaves about " & ( VAR __v = ( [App Commission Saving (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " with the agencies."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 2fec4c4d-c1f4-5307-95da-c3d906a5bea1

	/// Decision card, both lines with a line break (alt text and tables; on the canvas two cards, spike S-7).
	measure 'Rec Lines (text)' = [Rec Line 1 (text)] & UNICHAR ( 10 ) & [Rec Line 2 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 60da4e88-dd24-5a4b-b18c-f50955f26fa6

	/// Ledger, 'What we track' (R-P2-5, doc 22 section 4): the measure, a line break, the move(s) that act on it. The kiosks' guest-score change stays in dataset units, never summed, never NPS.
	measure 'Ledger Measure (text)' = VAR c = SELECTEDVALUE ( Finding[Code] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "F4" ), MoveDecision[ProjectID] ) VAR rp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Finding] = "F3" && MoveDecision[Tranche] = 3 ), MoveDecision[ProjectID] ) VAR s = [Selected Scenario] VAR gs = CALCULATE ( SUM ( InvestmentScenarios[SatisfactionChangePts] ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = kp, InvestmentScenarios[Scenario] = s ) RETURN SWITCH ( c, "F2", "distribution cost, % of room revenue" & UNICHAR ( 10 ) & "booking app with member rates", "F1", "operating margin after commissions" & UNICHAR ( 10 ) & "app + revenue management + kiosks", "F4", "self check-in hotels · rooms added" & UNICHAR ( 10 ) & "kiosks live " & FORMAT ( LOOKUPVALUE ( InvestmentProjects[Completion Date], InvestmentProjects[ProjectID], kp ), "mmm yyyy", "en-US" ) & "; guest score " & IF ( gs < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( gs ), "0.00", "en-US" ) & " there (dataset units)", "F3", "refresh of the " & COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = rp ) ) & " oldest hotels" & UNICHAR ( 10 ) & "why: see What waits, and why" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 2131a4db-d79d-5d43-87c7-0137bb08f416

	/// Ledger, 2025: distribution cost and the margin after commissions as they were; no kiosk and no added room yet; the refresh not started.
	measure 'Ledger 2025 (text)' = VAR c = SELECTEDVALUE ( Finding[Code] ) VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "F4" ), MoveDecision[ProjectID] ) RETURN SWITCH ( c, "F2", ( VAR __p = ( [Dist Cost % 2025 GI] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ), "F1", ( VAR __p = ( [KPI Margin after GI] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ), "F4", "0 of " & COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kp ) ) & " · 0", "F3", "not started" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 7c44dc34-fca2-53ad-8705-0e8a898bea5c

	/// Ledger, 2032 with A (metric contracts M-102, M-103): the 2025 brand plus A's full yearly effect, in 2025 dollars, scenario in view.
	measure 'Ledger 2032 (text)' = VAR c = SELECTEDVALUE ( Finding[Code] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "F4" ), MoveDecision[ProjectID] ) VAR rp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Finding] = "F3" && MoveDecision[Tranche] = 3 ), MoveDecision[ProjectID] ) VAR rooms = SUMX ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[AddedRooms] ), InvestmentProjects[ProjectID] IN aIds ), InvestmentProjects[AddedRooms] ) + 0 RETURN SWITCH ( c, "F2", ( VAR __p = ( [Dist Cost % 2032 with A (sel)] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ), "F1", ( VAR __p = ( [Margin after 2032 with A (sel)] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ), "F4", IF ( kp IN aIds, COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kp ) ), 0 ) & " of " & COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kp ) ) & " · " & rooms, "F3", IF ( rp IN aIds, "started", "not started" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: cfc63fe7-22cf-5e54-985b-e4560c6b6c07

	/// Ledger status words (P-6): the share of the 2021-2025 rise in distribution cost that A undoes and of the 2023-2025 fall in the margin it recovers, in words; F4 and F3 wait for the gate.
	measure 'Ledger Status (text)' = VAR c = SELECTEDVALUE ( Finding[Code] ) RETURN SWITCH ( c, "F2", ( VAR __x = [Dist Cost Rise Undone % (sel)] RETURN SWITCH ( TRUE (), __x <= 0, "none of", __x < 0.2, "a little of", __x < 0.3, "a quarter of", __x < 0.4, "a third of", __x < 0.6, "half", __x < 0.7, "two thirds of", __x < 0.85, "three quarters of", __x < 1, "most of", "all of" ) ) & " the rise since 2021 undone", "F1", ( VAR __x = [Margin Fall Recovered % (sel)] RETURN SWITCH ( TRUE (), __x <= 0, "none of", __x < 0.2, "a little of", __x < 0.3, "a quarter of", __x < 0.4, "a third of", __x < 0.6, "half", __x < 0.7, "two thirds of", __x < 0.85, "three quarters of", __x < 1, "most of", "all of" ) ) & " the fall since 2023 recovered", "F4", "rooms decided at the 2028 gate", "F3", "deferred to the 2028 gate" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 016e5dd0-586a-58df-bf94-8616d2ce8222

	/// Capital plan title (R-P2-7): the budget, tranche 1 now and the decisions at the gate.
	measure 'Capital Plan Title (text)' = VAR k = COUNTROWS ( FILTER ( { [Tranche 2 Capex], [Tranche 3 Capex] }, [Value] > 0 ) ) RETURN "The $" & FORMAT ( CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) / 1000000, "#,0", "en-US" ) & "M plan: " & ( VAR __v = ( [Tranche 1 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " now, " & ( VAR __n = k RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " decisions in 2028"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 91081d48-99f4-5e20-bf8b-18a5246d96dd

	/// Capital plan, the label of segment 1, line 1 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T1 L1 (text)' = "Tranche 1 · package A"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: fb6862fc-da95-54e3-9080-f9abfe269d8f

	/// Capital plan, the label of segment 1, line 2 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T1 L2 (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR y1 = YEAR ( CALCULATE ( MIN ( InvestmentProjects[Planned Start] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( aIds, InvestmentProjects[ProjectID] ) ) ) RETURN ( VAR __v = ( [Tranche 1 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " · " & y1
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 3e7641a4-4e89-58f5-9ab4-553152ae77ff

	/// Capital plan, the label of segment 1, all lines with line breaks.
	measure 'Plan T1 (text)' = [Plan T1 L1 (text)] & UNICHAR ( 10 ) & [Plan T1 L2 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 16440f5d-a154-5a91-ab4a-83609bf37152

	/// Capital plan, the label of segment 2, line 1 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T2 L1 (text)' = VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) RETURN "Tranche 2 · " & CONCATENATEX ( th, [@n], " and ", [@o], ASC ) & " +" & MAXX ( th, [@r] ) & " rooms"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8c03794f-8c71-5a44-99f0-473a64d0508c

	/// Capital plan, the label of segment 2, line 2 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T2 L2 (text)' = ( VAR __v = ( [Tranche 2 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " · 2028 gate"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 9fc7fc1a-195f-5ab3-aa82-5dc7acbb0193

	/// Capital plan, the label of segment 2, line 3 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T2 L3 (text)' = ( VAR __v = ( [Tranche 2 Run-rate] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year once live · " & ( VAR __p = ( [Tranche 2 Year on Cost] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 592afa66-fef1-506e-a664-531850b3035d

	/// Capital plan, the label of segment 2, all lines with line breaks.
	measure 'Plan T2 (text)' = [Plan T2 L1 (text)] & UNICHAR ( 10 ) & [Plan T2 L2 (text)] & UNICHAR ( 10 ) & [Plan T2 L3 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: f6b4f477-d3db-5c11-bbbf-e7144ad04e43

	/// Capital plan, the label of segment 3, line 1 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T3 L1 (text)' = VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 3 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) RETURN "Tranche 3 · the " & SWITCH ( MAXX ( th, [@p] ), "GI-01", "booking app", "GI-02", "kiosks", "GI-03", "energy programme", "GI-04", "Toronto extension", "GI-05", "Gatwick extension", "GI-06", "Kingston extension", "GI-07", "refresh", "GI-08", "Boston hotel", "GI-09", "breakfast upgrade", "GI-10", "revenue management system", "" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 45fbecb5-2a0c-5ff3-b310-6b704c8bbc56

	/// Capital plan, the label of segment 3, line 2 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T3 L2 (text)' = ( VAR __v = ( [Tranche 3 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " · 2028 gate"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 367af642-26ae-5975-8830-380ba88a733f

	/// Capital plan, the label of segment 3, line 3 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T3 L3 (text)' = ( VAR __v = ( [Tranche 3 Run-rate] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year once live · " & ( VAR __p = ( [Tranche 3 Year on Cost] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 6b4aad43-4945-5c36-b7f4-7bdee15fd366

	/// Capital plan, the label of segment 3, all lines with line breaks.
	measure 'Plan T3 (text)' = [Plan T3 L1 (text)] & UNICHAR ( 10 ) & [Plan T3 L2 (text)] & UNICHAR ( 10 ) & [Plan T3 L3 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 94cffbbb-3639-51c3-838f-737b0a27217d

	/// Capital plan, the label of segment 4, line 1 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T4 L1 (text)' = "Not needed · " & ( VAR __v = ( [Not Needed Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 664bd8e5-0cc4-54fa-be44-f44fa5d0eff0

	/// Capital plan, the label of segment 4, all lines with line breaks.
	measure 'Plan T4 (text)' = [Plan T4 L1 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: bca77378-af5c-5409-a398-5bbd49adc4fe

	/// The gate rule (R-P2-7), the one release rule of the report: when the Board releases tranche 2 and when the refresh comes back. The 0.6 points are the app's Low-case change in distribution cost.
	measure 'Gate Rule (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR appIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "F2" ), "@p", MoveDecision[ProjectID] ) VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR pts = - CALCULATE ( SUM ( InvestmentScenarios[DistributionCostChangePts] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( appIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = "Low" ) * 100 RETURN "The 2028 gate, once all " & ( VAR __n = COUNTROWS ( aIds ) RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " moves are live: the Board releases tranche 2 if distribution cost has fallen at least " & FORMAT ( pts, "0.0", "en-US" ) & " points (the app's Low case) and " & CONCATENATEX ( th, [@n], " and ", [@o], ASC ) & " still topped 90% in 6 of the last 12 months. The refresh comes back to the same meeting with a case that looks beyond " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ". A decision rule, not a forecast."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 1b0a5773-64af-5a87-895e-509c7c69a1fb

	/// The gate in one line for the What-waits table (When we decide); the full rule is Gate Rule (text).
	measure 'Gate Rule Short (text)' = "At the 2028 gate, if the app delivers and the airports stay full."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 68a5d61c-e817-56a5-b80b-9d460547ef84

	/// Capital plan milestone strip: the go-live of A's moves in order, the dependency, and the year A turns cash positive (undiscounted cumulative), scenario in view.
	measure 'Milestones (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR t = ADDCOLUMNS ( aIds, "@d", LOOKUPVALUE ( InvestmentProjects[Completion Date], InvestmentProjects[ProjectID], [@p] ), "@dep", LOOKUPVALUE ( InvestmentProjects[DependsOn], InvestmentProjects[ProjectID], [@p] ) ) VAR pb = [Preset A Payback Year] RETURN CONCATENATEX ( t, SWITCH ( [@p], "GI-01", "App", "GI-02", "Kiosks", "GI-03", "Energy", "GI-04", "Toronto +40", "GI-05", "Gatwick +40", "GI-06", "Kingston +40", "GI-07", "refresh", "GI-08", "Boston", "GI-09", "Breakfast", "GI-10", "RMS", "" ) & " live " & FORMAT ( [@d], "mmm yyyy", "en-US" ) & IF ( [@dep] <> "", " (" & IF ( ( [@p] IN { "GI-02" } ), "they need", "it needs" ) & " the " & LOWER ( SWITCH ( [@dep], "GI-01", "App", "GI-02", "Kiosks", "GI-03", "Energy", "GI-04", "Toronto +40", "GI-05", "Gatwick +40", "GI-06", "Kingston +40", "GI-07", "refresh", "GI-08", "Boston", "GI-09", "Breakfast", "GI-10", "RMS", "" ) ) & ")", "" ), " · ", [@d], ASC ) & " · " & IF ( ISBLANK ( pb ), "Not cash positive by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ), "Cash positive " & pb ) & " (" & [Selected Scenario] & ")"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: a041666e-4a3a-5c48-993c-84f2fba3a944

	/// Proof chart title (R-W-1): every package the contest rules allow, and how many beat A's NPV through 2032 in the case in view (none, in all three).
	measure 'Proof Title (text)' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) VAR av = [Rec NPV (sel)] VAR beat = COUNTROWS ( FILTER ( t, [@v] > av ) ) + 0 RETURN "We checked all " & COUNTROWS ( t ) & " packages the rules allow: " & IF ( beat = 0, "none beats A", beat & IF ( beat = 1, " beats A", " beat A" ) ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: e9f35ecd-10c2-5c13-abf2-1efb8922ee59

	/// Proof chart subtitle: how many packages pay back by 2032 in the case in view and the $5M step above the largest of them.
	measure 'Proof Subtitle (text)' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) VAR pos = FILTER ( t, [@v] >= 0 ) VAR k = COUNTROWS ( pos ) + 0 VAR cap = ( INT ( MAXX ( pos, Package[CapexUSD] ) / 5000000 ) + 1 ) * 5 RETURN IF ( k = 0, "None pays back by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ".", "Only " & k & IF ( k = 1, " pays", " pay" ) & " back by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & IF ( k = 1, ", under $", ", all under $" ) & cap & "M." ) & " Each dot is a package."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 1dc5368a-c4e3-5605-98db-f84478519337

	/// What waits, 'The numbers' (R-W-2): four lines per option, scenario in view; the tranches show no NPV (a gated start is not modelled), the refresh its package C for reference.
	measure 'Wait Numbers (text)' = VAR k = SELECTEDVALUE ( WaitOption[Key] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR b = [Preset B Package] VAR bIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = b ), "@p", PackageProject[ProjectID] ) VAR capA = [Rec Capex] VAR capB = [Preset B Capex] VAR npvA = [Rec NPV (sel)] VAR npvB = [Preset B NPV (sel)] VAR cP = [Preset C Package] VAR cIds = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = cP ), "@p", PackageProject[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ) ) VAR bLo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = b ) VAR bHi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = b ) RETURN SWITCH ( k, "B", ( VAR __v = ( capB ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " capex" & UNICHAR ( 10 ) & ( VAR __v = ( npvB ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " NPV through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & UNICHAR ( 10 ) & ( VAR __v = ( [Preset B Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & UNICHAR ( 10 ) & ( VAR __v = ( bLo ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " to " & ( VAR __v = ( bHi ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), "T2", ( VAR __v = ( [Tranche 2 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " capex" & UNICHAR ( 10 ) & ( VAR __v = ( [Tranche 2 Run-rate] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year once live" & UNICHAR ( 10 ) & ( VAR __p = ( [Tranche 2 Year on Cost] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost" & UNICHAR ( 10 ) & "no NPV shown", "T3", ( VAR __v = ( [Tranche 3 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " capex" & UNICHAR ( 10 ) & ( VAR __v = ( [Tranche 3 Run-rate] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year once live" & UNICHAR ( 10 ) & ( VAR __p = ( [Tranche 3 Year on Cost] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost" & UNICHAR ( 10 ) & "package C (" & CONCATENATEX ( cIds, SWITCH ( [@p], "GI-01", "App", "GI-02", "Kiosks", "GI-03", "Energy", "GI-04", "Toronto +40", "GI-05", "Gatwick +40", "GI-06", "Kingston +40", "GI-07", "refresh", "GI-08", "Boston", "GI-09", "Breakfast", "GI-10", "RMS", "" ), " + ", [@o], ASC ) & ") " & ( VAR __v = ( [Preset C NPV (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 6a85cf65-3d1b-5608-89dd-499aa3d9037f

	/// What waits, 'Why it's on the table' (R-W-2): B's wider guest-score reach, the airports' months above 90 %, and the hotels renovated last against the rest of the brand (NPS 2021 to 2025).
	measure 'Wait Why (text)' = VAR k = SELECTEDVALUE ( WaitOption[Key] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR b = [Preset B Package] VAR bIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = b ), "@p", PackageProject[ProjectID] ) VAR capA = [Rec Capex] VAR capB = [Preset B Capex] VAR npvA = [Rec NPV (sel)] VAR npvB = [Preset B NPV (sel)] VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR gh = CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[Brand] = "Goodnight Inn" ) VAR ly = MAXX ( gh, YEAR ( LOOKUPVALUE ( Hotels[LastRenovationDate], Hotels[HotelID], Hotels[HotelID] ) ) ) VAR grp = FILTER ( gh, YEAR ( LOOKUPVALUE ( Hotels[LastRenovationDate], Hotels[HotelID], Hotels[HotelID] ) ) = ly ) VAR rest = EXCEPT ( gh, grp ) VAR nh = COUNTROWS ( gh ) VAR rA = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR rB = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = b ) VAR g21 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( grp, Hotels[HotelID] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR g25 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( grp, Hotels[HotelID] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR r21 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( rest, Hotels[HotelID] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR r25 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( rest, Hotels[HotelID] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN SWITCH ( k, "B", "Lifts guest scores in " & IF ( rB = nh, "all ", "" ) & rB & " hotels instead of " & rA & ".", "T2", CONCATENATEX ( th, [@n], " and ", [@m], DESC, [@o], ASC ) & " topped 90% in " & CONCATENATEX ( th, [@m], " and ", [@m], DESC, [@o], ASC ) & " of the last 24 months.", "T3", "Renovation works here: the " & ( VAR __n = COUNTROWS ( grp ) RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " hotels renovated in " & ly & IF ( ROUND ( g25, 0 ) = ROUND ( g21, 0 ), " held their NPS near ", " moved their NPS to " ) & ( VAR __i = ROUND ( g25, 0 ) RETURN IF ( __i < 0, UNICHAR ( 8722 ), IF ( __i > 0, "+", "" ) ) & FORMAT ( ABS ( __i ), "0", "en-US" ) ) & " while the rest of the brand " & IF ( r25 < r21, "fell", "rose" ) & " to " & ( VAR __q = ( r25 ) RETURN IF ( ROUND ( __q, 1 ) = 0, "0.0", IF ( __q < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __q ), "0.0", "en-US" ) ) ) & "." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 5078aef3-bb05-533d-a25c-5ebab8752550

	/// What waits, 'Why not now' (R-W-2; doc 22 section 6, question 2): B against A, the airports' NPV through 2032, and the refresh against our cost of money (at or above 8 %, only High, it says that it still does not pay back by 2032).
	measure 'Wait WhyNot (text)' = VAR k = SELECTEDVALUE ( WaitOption[Key] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR b = [Preset B Package] VAR bIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = b ), "@p", PackageProject[ProjectID] ) VAR capA = [Rec Capex] VAR capB = [Preset B Capex] VAR npvA = [Rec NPV (sel)] VAR npvB = [Preset B NPV (sel)] VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "F4" ), MoveDecision[ProjectID] ) VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR dc = capB - capA VAR dn = ( ROUND ( npvA / 100000, 0 ) - ROUND ( npvB / 100000, 0 ) ) * 100000 VAR nNeg = COUNTROWS ( FILTER ( th, ROUND ( [@v] / 100000, 0 ) < 0 ) ) VAR t3y = [Tranche 3 Year on Cost] VAR rate = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ) RETURN SWITCH ( k, "B", ( VAR __v = ( ABS ( dc ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & IF ( dc >= 0, " more", " less" ) & " than A for " & ( VAR __v = ( ABS ( dn ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & IF ( dn >= 0, " less", " more" ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & IF ( kp IN aIds && NOT ( kp IN bIds ), ", and it leaves the queues at the " & COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kp ) ) & " busiest desks", "" ) & ".", "T2", SWITCH ( nNeg, COUNTROWS ( th ), "Neither pays back by ", 0, "Both pay back by ", "Only one pays back by " ) & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & " (" & CONCATENATEX ( th, ( VAR __v = ( [@v] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), " and ", [@m], DESC, [@o], ASC ) & ").", "T3", "It earns " & ( VAR __p = ( t3y ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost" & IF ( ROUND ( t3y, 3 ) >= rate, " but does not pay back by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & " (" & ( VAR __v = ( [Tranche 3 NPV] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ")", IF ( rate - t3y < 0.005, ", just under our ", ", under our " ) & FORMAT ( rate, "0%", "en-US" ) & " cost of money" ) & ". The data does not price the cost of waiting, so this case is understated." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: cfa2393f-0d34-519e-bc3a-4ab6ed3700fc

	/// NPV through 2032 of tranche 3 (the refresh) alone, scenario in view; said only where 'a year on cost' alone would mislead (What waits, High).
	measure 'Tranche 3 NPV' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 3 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 084b8cf4-7b4f-5b9f-a912-54b170b22c87

	/// What waits, 'When we decide' (R-W-2): B is not planned; the tranches come back at the gate (the short rule), with the extension that is not on the list.
	measure 'Wait When (text)' = VAR k = SELECTEDVALUE ( WaitOption[Key] ) VAR ext = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Category], InvestmentProjects[Brand] ), InvestmentProjects[Category] = "Expansion" && InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID] ) VAR t2 = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ) VAR kx = MAXX ( EXCEPT ( ext, t2 ), [@p] ) VAR kh = MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kx ), InvestmentProjectProperties[HotelID] ) RETURN SWITCH ( k, "B", "Not planned.", "T2", [Gate Rule Short (text)] & IF ( COUNTROWS ( EXCEPT ( ext, t2 ) ) = 1, UNICHAR ( 10 ) & LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], kh ) & " (" & FORMAT ( CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = kh ), "0%", "en-US" ) & " full) is not on the list.", "" ), "T3", "Back at the 2028 gate, with a case that looks beyond " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 702376ce-c68f-5b38-8a2b-e496e5ee3e84

	/// Title of the comparison chart in What waits (R-W-3, R-G2): B against A by 2032, and whether C turns cash positive by 2032, scenario in view.
	measure 'Cmp Alts Title (text)' = VAR a32 = CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR b32 = CALCULATE ( [Preset B Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR pbC = [Preset C Payback Year] RETURN "Cumulative net impact, $M: B " & IF ( ABS ( a32 - b32 ) < 1000000, "ends within $1M of A", IF ( b32 < a32, "trails A by ", "ends ahead of A by " ) & ( VAR __v = ( ABS ( a32 - b32 ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) ) & " by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "; C " & IF ( ISBLANK ( pbC ), "is not cash positive by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ), "is cash positive from " & pbC )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: dcc92f7c-7694-5eb4-aedb-c576027f0de8

	/// Selector footer: how many moves are picked and their capex against the budget.
	measure 'Build Picked (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN "Picked: " & n & IF ( n = 1, " move, ", " moves, " ) & ( VAR __v = ( COALESCE ( [Build Capex], 0 ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " of " & ( VAR __v = ( CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: b41a0b6c-f5f4-59fb-b1fe-26fac7495554

	/// Your plan: profit a year by 2032, scenario in view; blank while nothing is picked.
	measure 'Build Run-rate (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, BLANK (), ( VAR __v = ( [Build Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 44d3762a-77ca-5a81-83dd-36a0a5a61caf

	/// Your plan: a year on cost, scenario in view; blank while nothing is picked.
	measure 'Build A Year on Cost (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, BLANK (), ( VAR __p = ( [Build A Year on Cost (sel)] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 164ce22c-23e1-5ed8-b46f-54a4b8f8f09a

	/// Font colour of the package tooltip's verdict line: Night (the words carry the verdict). Defined in step 4 of doc 23: the report bound this measure while the model had none (doc 21 PB defect).
	measure 'TT Payback Color' = "#12233D"
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 2250426e-2cf1-5bc2-aec2-2e4aa67288e9

	column Placeholder
		dataType: string
		isHidden
		lineageTag: c4315546-1a37-5d10-81ae-2f137aeba1bf
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
