	/// F1 chart read aloud: the after-commissions path 2021, 2023, 2025 (as the title) and the commission gap.
	measure 'Alt F1 Chart (text)' = VAR a1 = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR a3 = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) VAR a5 = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR b1 = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR b5 = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN "After commissions, Goodnight Inn's operating margin " & IF ( a3 > a1, "rose", "fell" ) & " from " & FORMAT ( a1, "0.0%" ) & " in 2021 to " & FORMAT ( a3, "0.0%" ) & " in 2023 and " & IF ( a5 < a3, "fell back", "rose" ) & " to " & FORMAT ( a5, "0.0%" ) & " in 2025. The gap to the margin before commissions grew from " & FORMAT ( ( b1 - a1 ) * 100, "0.0" ) & " to " & FORMAT ( ( b5 - a5 ) * 100, "0.0" ) & " points."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: f762e6ee-6e72-542c-966d-dd9149fdd66b

	/// F2 chart read aloud: Goodnight Inn's OTA share 2021 and 2025, and the sisters' 2025 values.
	measure 'Alt F2 Chart (text)' = VAR o1 = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR o5 = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN "Online agencies booked " & FORMAT ( o5, "0.0%" ) & " of Goodnight Inn's room revenue in 2025, " & IF ( o5 > o1, "up", "down" ) & " from " & FORMAT ( o1, "0.0%" ) & " in 2021. The other brands in 2025: " & CONCATENATEX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN b & " " & FORMAT ( CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ), "0.0%" ), ", ", Brands[Brand], ASC ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: e4b33df5-4660-58df-8bca-6b8d18dbd0af

	/// F2 folio table read aloud, the same rounding as the table (keeps = the difference of the shown amounts).
	measure 'Alt F2 Folio (text)' = VAR orate = ROUND ( CALCULATE ( DIVIDE ( [Channel Room Revenue], [Channel Room Nights] ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ), 2 ) VAR ocomm = ROUND ( CALCULATE ( DIVIDE ( [Distribution Cost], [Channel Room Nights] ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ), 2 ) VAR drate = ROUND ( CALCULATE ( DIVIDE ( [Channel Room Revenue], [Channel Room Nights] ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ), 2 ) VAR dcomm = ROUND ( CALCULATE ( DIVIDE ( [Distribution Cost], [Channel Room Nights] ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ), 2 ) RETURN "One Goodnight Inn room night in 2025. Via an online agency the guest pays " & FORMAT ( orate, "$#,0.00" ) & ", fees take " & FORMAT ( ocomm, "$#,0.00" ) & ", the inn keeps " & FORMAT ( orate - ocomm, "$#,0.00" ) & ". Booked direct: " & FORMAT ( drate, "$#,0.00" ) & ", fees " & FORMAT ( dcomm, "$#,0.00" ) & ", the inn keeps " & FORMAT ( drate - dcomm, "$#,0.00" ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: c3df5313-c696-52b5-b299-ccfd6f9c12e2

	/// F3 chart: the three bands' NPS 2025 (dated hotels only).
	measure 'Alt F3 Chart (text)' = "Goodnight Inn's 2025 net promoter score by years since the last renovation: 5 years or less " & ( VAR __v = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[Renovation Age Sort] = 1 ) RETURN IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __v ), "0.0" ) ) & ", 6 to 9 years " & ( VAR __v = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[Renovation Age Sort] = 2 ) RETURN IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __v ), "0.0" ) ) & ", 10 years or more " & ( VAR __v = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[Renovation Age Sort] = 3 ) RETURN IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __v ), "0.0" ) ) & ". Hovering a bar shows that band's occupancy, revenue per room, its NPS since 2021 and its weakest guest scores."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 1346f4d5-f4f0-55c8-bc46-c99a10b12102

	/// F4 numbers card read aloud.
	measure 'Alt F4 Types (text)' = "Goodnight Inn occupancy in 2025 by location type: airport hotels " & [Occupancy Airport GI (text)] & ", city hotels " & [Occupancy City GI (text)] & ", highway hotels " & [Occupancy Highway GI (text)] & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: a30d3cb0-19f9-5a37-8b65-a49cb76785ba

	/// F4 chart read aloud: the seven fullest hotels with their occupancy (one decimal, as the bars), and how many are airports.
	measure 'Alt F4 Chart (text)' = VAR hs = CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) VAR t7 = ADDCOLUMNS ( TOPN ( 7, hs, CALCULATE ( [Occupancy %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), "@o", CALCULATE ( [Occupancy %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ), "@n", CALCULATE ( SELECTEDVALUE ( Hotels[Hotel Short Name] ) ), "@t", CALCULATE ( SELECTEDVALUE ( Hotels[LocationType] ) ) ) VAR na = COUNTROWS ( FILTER ( t7, [@t] = "Airport" ) ) RETURN "The 7 fullest Goodnight Inn hotels in 2025, " & na & " of them airports: " & CONCATENATEX ( t7, [@n] & " " & FORMAT ( [@o], "0.0%" ), ", ", [@o], DESC ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: e7beb809-c0fe-5ac7-b128-957041637b02

	/// F1 card title read aloud with its kicker (the kicker leaves the tab order; pass-3 review: fewer stops).
	measure 'Alt F1 Title (text)' = "F1, the margin. " & [F1 Title (text)]
