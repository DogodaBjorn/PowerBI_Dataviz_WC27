	/// Capex of package B as text.
	measure 'Preset B Capex (text)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), FORMAT ( ( [Preset B Capex] ) / 1000000, "$#,0.0#" ) & "M" )
		formatString: @
		displayFolder: 09 Package matrix
