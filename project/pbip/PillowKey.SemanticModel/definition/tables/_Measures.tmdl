	/// Hotels touched by an initiative with a dataset guest-score effect (Expected), counted once.
	measure 'Focus Hotels Rated' = VAR f = [Focus Package] RETURN CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: #,0
		displayFolder: 09 Package matrix
		lineageTag: 439e7056-9905-58e5-a8fb-0ffc2f227846

	/// 1 for an initiative inside the package in focus (visual filter for the plan table).
	measure 'Focus Project Flag' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN IF ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ) IN ids, 1, 0 )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: ce2dac7a-6216-5ba0-808a-de7b5519f469

	/// NPV contribution per initiative in focus; at the total it sums to the package NPV (waterfall; reconciles with Package by construction).
	measure 'Focus Project NPV (sel)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN SUMX ( FILTER ( VALUES ( InvestmentProjects[ProjectID] ), InvestmentProjects[ProjectID] IN ids ), [NPV @ 8%] )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: f388ce1d-5179-55e6-b1d6-f145003f7902

	/// Capex per initiative in focus.
	measure 'Focus Project Capex' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN SUMX ( FILTER ( VALUES ( InvestmentProjects[ProjectID] ), InvestmentProjects[ProjectID] IN ids ), CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ) ) )
		formatString: \$#,0,,.0\M
		displayFolder: 09 Package matrix
		lineageTag: 851fdb26-e5f7-56a0-a200-76a586dd618c

	/// Organisers' annual operating-profit impact per initiative in focus (reached by 2032).
	measure 'Focus Project Run-rate (sel)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN SUMX ( FILTER ( VALUES ( InvestmentProjects[ProjectID] ), InvestmentProjects[ProjectID] IN ids ), [2032 Run-rate] )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 476f649f-38e2-5042-8db6-b7a14bbfafe7

	/// Go-live month per initiative in focus.
	measure 'Focus Project Live (text)' = IF ( [Focus Project Flag] = 1, [Live (text)] )
		formatString: @
