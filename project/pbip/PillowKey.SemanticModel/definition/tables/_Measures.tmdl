	/// Marker colour of the A/B/C layer only (it draws nothing else): Deep Coffee for A, Night for B and C, so its white letters read at 6.2:1 and 15.8:1 (plan 11).
	measure 'Named Point Color' = IF ( SELECTEDVALUE ( Package[Preset] ) = "A", "#1763A8", "#12233D" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 4682440d-8100-5463-8c6e-43783fc783e0

	/// Scatter size: the package in focus largest, then A, then B and C, the rest small.
	measure 'Package Point Size' = VAR k = SELECTEDVALUE ( Package[Preset] ) RETURN SWITCH ( TRUE (), [Focus Highlight] = 1, 6, k = "A", 5, k IN { "B", "C" }, 3, 1 )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 0196c53d-5938-5f6a-b575-f4f77acc7bc1

	/// Size of the A/B/C layer's dots in the full-size scatter: about 24 and 22 px, so Power BI centres each letter inside its dot (round 5: at the cloud's sizes B and C were too small for their letters, which fell beside the dots).
	measure 'Named Point Size' = IF ( SELECTEDVALUE ( Package[Preset] ) = "A", 5.8, 5.3 )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 99fdc34c-ca72-5a60-9e08-665b8470b83b

	/// Size of the A/B/C layer's dots in the small scatter (alts and build), about 23 px (the stack's cap at its multiplier). Measured 10 Nov: in this smaller plot Power BI puts the letters UNDER the dots whatever their size, so the small layer draws each letter as a tag in the dot's colour instead.
	measure 'Named Point Size (small)' = IF ( SELECTEDVALUE ( Package[Preset] ) = "A", 7.2, 6.6 )
		formatString: 0
