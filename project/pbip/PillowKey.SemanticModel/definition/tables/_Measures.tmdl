		lineageTag: 00f4c9a4-9565-5b70-9fa0-a79771c8e5f2

	/// The part of the Goodnight Inn budget no tranche asks for; the last segment of the plan bar (the four segments add up to the budget by construction).
	measure 'Not Needed Capex' = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) - [Tranche 1 Capex] - [Tranche 2 Capex] - [Tranche 3 Capex]
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: d1cb8915-932f-5c17-abd9-c1a47fdd8062

	/// Goodnight Inn distribution cost as a share of room revenue, 2025 (the ledger's F2 start).
	measure 'Dist Cost % 2025 GI' = CALCULATE ( [Distribution Cost % of Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: e4beb3e1-22fa-5b88-8ccd-2faaaa4f7fee

	/// Ledger F2: the 2025 distribution cost share of room revenue plus the organisers' change in points for the moves of package A, scenario in view. 2025 brand, A at full effect; not a forecast of 2032.
	measure 'Dist Cost % 2032 with A (sel)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] RETURN [Dist Cost % 2025 GI] + CALCULATE ( SUM ( InvestmentScenarios[DistributionCostChangePts] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( aIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = s )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: e4ac6146-04ee-5e85-b862-f4ec220a65d7

	/// Ledger F1: operating margin after commissions of the 2025 brand with package A's full yearly profit and revenue impact added, scenario in view. In 2025 dollars; not a forecast of 2032.
	measure 'Margin after 2032 with A (sel)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR tot = CALCULATE ( [Total Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR gopa = CALCULATE ( [GOP after Distribution], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN DIVIDE ( gopa + CALCULATE ( SUM ( InvestmentScenarios[AnnualOperatingProfitImpactUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( aIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = s ), tot + CALCULATE ( SUM ( InvestmentScenarios[AnnualRevenueImpactUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( aIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = s ) )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 78a53f86-1a35-56dd-9770-d4bd19a108d3

	/// Ledger F2 status: the share of the 2021 to 2025 rise in distribution cost (points of room revenue) that package A undoes, scenario in view.
	measure 'Dist Cost Rise Undone % (sel)' = VAR d21 = CALCULATE ( [Distribution Cost % of Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR d25 = [Dist Cost % 2025 GI] RETURN DIVIDE ( d25 - [Dist Cost % 2032 with A (sel)], d25 - d21 )
		formatString: 0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: b8ac6276-1c70-58da-acee-a5e473a265f9

	/// Ledger F1 status: the share of the 2023 to 2025 fall in the margin after commissions that package A recovers, scenario in view.
	measure 'Margin Fall Recovered % (sel)' = VAR m23 = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) VAR m25 = [KPI Margin after GI] RETURN DIVIDE ( [Margin after 2032 with A (sel)] - m25, m23 - m25 )
		formatString: 0%
		displayFolder: 15 Storytelling rebuild
