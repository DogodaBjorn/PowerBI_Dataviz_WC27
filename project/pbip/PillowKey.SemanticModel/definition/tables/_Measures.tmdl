	/// Preset A: npv (sel).
	measure 'Preset A NPV (sel)' = VAR f = [Preset A Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
