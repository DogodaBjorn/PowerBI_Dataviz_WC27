	/// KPI band, read aloud: the label, the value and the comparison (NPS).
	measure 'Alt KPI NPS (text)' = "Guest quality: Goodnight Inn net promoter score in 2025: " & [KPI NPS GI (text)] & ", " & SUBSTITUTE ( [KPI NPS Alt Context (text)], " · ", "; " ) & "."
		formatString: @
		displayFolder: 11 Accessibility
