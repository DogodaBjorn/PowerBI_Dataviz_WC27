	/// The footer-row hint that explains the badge once per page: the badge and 'hover for more', right-aligned to the Definitions chip; decorative.
	measure 'Info Hint SVG' = "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='152' height='24' viewBox='0 0 152 24'>" & "<g transform='translate(25 4)'><circle cx='8' cy='8' r='6.75' fill='none' stroke='%23E05A22' stroke-width='1.5'/><circle cx='8' cy='4.9' r='1.15' fill='%23E05A22'/><rect x='7.1' y='7' width='1.8' height='5' rx='0.9' fill='%23E05A22'/></g><text x='152' y='17' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%234B5466'>hover for more</text></svg>"
