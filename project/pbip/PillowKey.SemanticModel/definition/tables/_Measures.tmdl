	/// Tooltip (alt text only since round 6): the moves the hovered package leaves out.
	measure 'TT Not Included (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR t = FILTER ( ALLNOBLANKROW ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" && NOT ( InvestmentProjects[ProjectID] IN ids ) ) RETURN IF ( ISBLANK ( pkg ), BLANK (), IF ( COUNTROWS ( t ) = 0, "Every move is in it.", "Not in it: " & CONCATENATEX ( t, InvestmentProjects[Short Name], ", ", InvestmentProjects[ProjectID], ASC ) & "." ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 33f2f3aa-ec6d-598d-8c1e-1f0632e99baa

	/// Tooltip kicker on the night banner (round 7): the package's letter when it has one and the case in view, in the page's eyebrow style.
	measure 'TT Kicker (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR k = LOOKUPVALUE ( Package[Preset], Package[PackageID], pkg ) RETURN IF ( ISBLANK ( pkg ), BLANK (), "PACKAGE" & IF ( k <> "", "  " & k, "" ) & "  ·  " & UPPER ( [Selected Scenario] ) & " CASE" )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 35eca03e-56b0-5fc6-966c-b9386baae031

	/// Tooltip: the hovered package's Low-High band and Expected dot on one fixed NPV axis shared by every package, the A/B/C ticks (B under the band when it stands within 24 px of A; C only when clear of break-even, A and B), the break-even line and the Low and High numbers on their own row; decorative, TT Range (text) is its text twin (keyboard tooltip, alt text).
	measure 'TT Range SVG' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR dMin = FLOOR ( MINX ( ALL ( Package ), Package[NPV Low] ) / 5000000, 1 ) * 5000000 VAR dMax = CEILING ( MAXX ( ALL ( Package ), Package[NPV High] ) / 5000000, 1 ) * 5000000 VAR k = 400 / ( dMax - dMin ) VAR lo = LOOKUPVALUE ( Package[NPV Low], Package[PackageID], pkg ) VAR ex = LOOKUPVALUE ( Package[NPV Expected], Package[PackageID], pkg ) VAR hi = LOOKUPVALUE ( Package[NPV High], Package[PackageID], pkg ) VAR x0 = 8 + ( 0 - dMin ) * k VAR xL = 8 + ( lo - dMin ) * k VAR xE = 8 + ( ex - dMin ) * k VAR xH = 8 + ( hi - dMin ) * k VAR xA = 8 + ( LOOKUPVALUE ( Package[NPV Expected], Package[Preset], "A" ) - dMin ) * k VAR xB = 8 + ( LOOKUPVALUE ( Package[NPV Expected], Package[Preset], "B" ) - dMin ) * k VAR xC = 8 + ( LOOKUPVALUE ( Package[NPV Expected], Package[Preset], "C" ) - dMin ) * k VAR bDown = ABS ( xA - xB ) < 24 VAR cShown = ABS ( xC - x0 ) >= 24 && ABS ( xC - xA ) >= 24 && ABS ( xC - xB ) >= 24 VAR dotc = IF ( ROUND ( ex / 100000, 0 ) >= 0, "%231763A8", "%23A63F0E" ) VAR lowAnchor = IF ( xL < 80, "start", "end" ) VAR xLo = IF ( xL < 80, 0, xL ) VAR highAnchor = IF ( xH + 88 > 416, "end", "start" ) VAR xHi = IF ( xH + 88 > 416, 416, xH + 4 ) RETURN IF ( ISBLANK ( pkg ), BLANK (), "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='416' height='72' viewBox='0 0 416 72'>" & "<line x1='1' x2='1' y1='2' y2='14' stroke='%2312233D' stroke-width='1.5'/><text x='6' y='13' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%234B5466'>break-even</text>" & "<line x1='" & FORMAT ( xA, "0.0", "en-US" ) & "' x2='" & FORMAT ( xA, "0.0", "en-US" ) & "' y1='15' y2='26' stroke='%231763A8' stroke-width='2'/><text x='" & FORMAT ( xA, "0.0", "en-US" ) & "' y='13' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%231763A8'>A</text>" & IF ( bDown, "<line x1='" & FORMAT ( xB, "0.0", "en-US" ) & "' x2='" & FORMAT ( xB, "0.0", "en-US" ) & "' y1='34' y2='38' stroke='%2312233D' stroke-width='2'/><text x='" & FORMAT ( xB, "0.0", "en-US" ) & "' y='50' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%2312233D'>B</text>", "<line x1='" & FORMAT ( xB, "0.0", "en-US" ) & "' x2='" & FORMAT ( xB, "0.0", "en-US" ) & "' y1='15' y2='26' stroke='%2312233D' stroke-width='2'/><text x='" & FORMAT ( xB, "0.0", "en-US" ) & "' y='13' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%2312233D'>B</text>" ) & IF ( cShown, "<line x1='" & FORMAT ( xC, "0.0", "en-US" ) & "' x2='" & FORMAT ( xC, "0.0", "en-US" ) & "' y1='15' y2='26' stroke='%2312233D' stroke-width='2'/><text x='" & FORMAT ( xC, "0.0", "en-US" ) & "' y='13' text-anchor='middle' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%2312233D'>C</text>", "" ) & "<rect x='" & FORMAT ( xL, "0.0", "en-US" ) & "' y='26' width='" & FORMAT ( xH - xL, "0.0", "en-US" ) & "' height='8' rx='4' fill='%238E897D' fill-opacity='0.45'/>" & "<line x1='" & FORMAT ( x0, "0.0", "en-US" ) & "' x2='" & FORMAT ( x0, "0.0", "en-US" ) & "' y1='15' y2='37' stroke='%2312233D' stroke-width='1.5'/>" & "<circle cx='" & FORMAT ( xE, "0.0", "en-US" ) & "' cy='30' r='5' fill='" & dotc & "' stroke='%23FFFFFF' stroke-width='2'/>" & "<text x='" & FORMAT ( xLo, "0.0", "en-US" ) & "' y='66' text-anchor='" & lowAnchor & "' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%234B5466'>Low " & IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ) / 1000000, "0.0", "en-US" ) & "</text>" & "<text x='" & FORMAT ( xHi, "0.0", "en-US" ) & "' y='66' text-anchor='" & highAnchor & "' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%234B5466'>High " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ) / 1000000, "0.0", "en-US" ) & "</text></svg>" )
		formatString: @
		displayFolder: 10 Package tooltip
		dataCategory: ImageUrl
		lineageTag: 2e74355c-f4db-5197-b21c-9ec9620b064e

	/// Tooltip: the moves of the hovered package as a list with capex and NPV each (positives first, the sinker last) and a totals row; the move NPVs are rounded so they add up to the package. Decorative: TT Moves (text) and Alt TT Moves say the same in words.
	measure 'TT Moves SVG' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR base = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR tr = ROUND ( SUMX ( base, [@v] ) / 10000, 0 ) VAR fl = ADDCOLUMNS ( base, "@f", INT ( [@v] / 10000 ) ) VAR fr = ADDCOLUMNS ( fl, "@r", [@v] / 10000 - [@f] + VALUE ( RIGHT ( [@p], 2 ) ) * 0.000000001 ) VAR k = tr - SUMX ( fr, [@f] ) VAR adj = ADDCOLUMNS ( fr, "@s", ( [@f] + IF ( RANKX ( fr, [@r], , DESC ) <= k, 1, 0 ) ) * 10000 ) VAR tot = SUMX ( adj, [@s] ) VAR cap = LOOKUPVALUE ( Package[CapexUSD], Package[PackageID], pkg ) VAR nrows = COUNTROWS ( adj ) VAR moveRows = CONCATENATEX ( adj, VAR y = 18 * RANKX ( adj, [@s] + VALUE ( RIGHT ( [@p], 2 ) ) * 0.0000001, , DESC ) RETURN "<text x='0' y='" & ( y + 14 ) & "' text-anchor='start' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%2312233D'>" & LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) & "</text>" & "<text x='320' y='" & ( y + 14 ) & "' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%2312233D'>" & ( VAR __v = ( LOOKUPVALUE ( InvestmentProjects[CapexUSD], InvestmentProjects[ProjectID], [@p] ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & "</text>" & "<text x='416' y='" & ( y + 14 ) & "' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='" & IF ( [@s] < 0, "%23A63F0E", "%2312233D" ) & "'>" & ( VAR __v = ( [@s] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "</text>", "" ) VAR yT = 18 * ( nrows + 1 ) VAR total = "<text x='0' y='" & ( yT + 14 ) & "' text-anchor='start' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%2312233D'>" & "Total" & "</text>" & "<text x='320' y='" & ( yT + 14 ) & "' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%2312233D'>" & ( VAR __v = ( cap ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & "</text>" & "<text x='416' y='" & ( yT + 14 ) & "' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='" & IF ( tot < 0, "%23A63F0E", "%2312233D" ) & "'>" & ( VAR __v = ( tot ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "</text>" RETURN IF ( ISBLANK ( pkg ), BLANK (), "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='416' height='184' viewBox='0 0 416 184'>" & "<text x='0' y='14' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%234B5466'>Move</text><text x='320' y='14' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%234B5466'>Capex</text><text x='416' y='14' text-anchor='end' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%234B5466'>NPV</text>" & "<line x1='0' x2='416' y1='17.5' y2='17.5' stroke='%23E3DFD3'/>" & "<line x1='0' x2='416' y1='" & ( 18 * ( nrows + 1 ) + 0.5 ) & "' y2='" & ( 18 * ( nrows + 1 ) + 0.5 ) & "' stroke='%23E3DFD3'/>" & moveRows & total & "</svg>" )
		formatString: @
		displayFolder: 10 Package tooltip
		dataCategory: ImageUrl
		lineageTag: 9ca4b6cc-849d-5c24-9f04-b7258da9503e

	/// Tooltip text twin of the moves list: each move with its NPV inside the package, positives first (the keyboard layer's tooltip and the alt text).
	measure 'TT Moves (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR base = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR tr = ROUND ( SUMX ( base, [@v] ) / 10000, 0 ) VAR fl = ADDCOLUMNS ( base, "@f", INT ( [@v] / 10000 ) ) VAR fr = ADDCOLUMNS ( fl, "@r", [@v] / 10000 - [@f] + VALUE ( RIGHT ( [@p], 2 ) ) * 0.000000001 ) VAR k = tr - SUMX ( fr, [@f] ) VAR adj = ADDCOLUMNS ( fr, "@s", ( [@f] + IF ( RANKX ( fr, [@r], , DESC ) <= k, 1, 0 ) ) * 10000 ) RETURN IF ( ISBLANK ( pkg ), BLANK (), CONCATENATEX ( adj, LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) & " " & ( VAR __v = ( [@s] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), "; ", [@s], DESC ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: b8c66b16-0bef-57c3-a10b-81142196875a

	/// Header of the F3 band tooltip: the band, its hotels and rooms.
	measure 'Band Header (text)' = VAR bnd = SELECTEDVALUE ( Hotels[Renovation Age Label] ) RETURN IF ( ISBLANK ( bnd ), BLANK (), bnd & ": " & COUNTROWS ( Hotels ) & " hotels, " & FORMAT ( SUM ( Hotels[Rooms] ), "#,0" ) & " rooms" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 6e2a0089-24f5-5cb1-89ea-914f74bcdb88

	/// F3 band tooltip: the brand's own 2025 figures under the band's three, the same formatters.
	measure 'Band vs Brand (text)' = "Goodnight Inn, all hotels, 2025: NPS " & IF ( CALCULATE ( [NPS (weighted) 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( CALCULATE ( [NPS (weighted) 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) ), "0.0" ) & ", occupancy " & FORMAT ( CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "0.0%" ) & ", RevPAR " & FORMAT ( CALCULATE ( [RevPAR 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "$#,0.00" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 189a7e04-3179-5f45-916d-32dbfa78b1ca

	/// F3 band tooltip, line: the band's response-weighted NPS by year.
	measure 'NPS Band (line)' = [NPS (weighted)]
		formatString: +0.0;-0.0;0.0
		displayFolder: 14 Findings reference and hover detail
		lineageTag: a4e19789-f2e8-53bc-ae5b-d6befc454d02

	/// F3 band tooltip, line: Goodnight Inn's response-weighted NPS by year, every hotel.
	measure 'NPS Brand (line)' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: +0.0;-0.0;0.0
		displayFolder: 14 Findings reference and hover detail
		lineageTag: c72756bc-a058-5559-98df-82a04c3529ed

	/// F3 band tooltip: the two lowest of the five guest-score dimensions in 2025, response-weighted (what a refresh would have to fix).
	measure 'Weakest Scores (text)' = VAR t = UNION ( ROW ( "@n", "cleanliness", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[CleanlinessScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), ROW ( "@n", "service", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[ServiceScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), ROW ( "@n", "room comfort", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[RoomComfortScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), ROW ( "@n", "amenities", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[AmenitiesScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), ROW ( "@n", "value for money", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[ValueForMoneyScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ) ) RETURN IF ( ISBLANK ( SELECTEDVALUE ( Hotels[Renovation Age Label] ) ), BLANK (), "Weakest guest scores 2025: " & CONCATENATEX ( TOPN ( 2, t, [@v], ASC ), [@n] & " " & FORMAT ( [@v], "0.0" ), ", ", [@v], ASC ) & " (of 10)" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: b6d0a913-af44-5683-aaaf-834c047fad83

	/// The F3 band tooltip's three figures read aloud.
	measure 'Alt Band Nums (text)' = "This band in 2025: NPS " & [NPS 2025 (signed)] & ", occupancy " & FORMAT ( [Occupancy % 2025], "0.0%" ) & ", revenue per available room " & FORMAT ( [RevPAR 2025], "$#,0" ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 0a12882e-b70b-51e1-82d5-2fd9d5d312cf

	/// The F3 band tooltip's line chart read aloud.
	measure 'Alt NPS Band Line (text)' = "Net promoter score by year, 2021 to 2025, this band against the whole brand: the band from " & FORMAT ( [NPS (weighted) 2021], "+0.0;-0.0;0.0" ) & " to " & FORMAT ( [NPS (weighted) 2025], "+0.0;-0.0;0.0" ) & ", the brand from " & FORMAT ( CALCULATE ( [NPS (weighted) 2021], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "+0.0;-0.0;0.0" ) & " to " & FORMAT ( CALCULATE ( [NPS (weighted) 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "+0.0;-0.0;0.0" ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 923cef95-153b-571c-9a22-3f2d2c8fbf02

	/// Header of the F4 hotel tooltip: the hotel, its location type and rooms.
	measure 'Hotel Header (text)' = VAR h = SELECTEDVALUE ( Hotels[Hotel Short Name] ) RETURN IF ( ISBLANK ( h ), BLANK (), h & ", " & LOWER ( SELECTEDVALUE ( Hotels[LocationType] ) ) & ", " & FORMAT ( SUM ( Hotels[Rooms] ), "#,0" ) & " rooms" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 70cdf61d-21d1-5b34-af2a-575e2efdd1e5

	/// F4 hotel tooltip: the brand's own 2025 figures under the hotel's three.
	measure 'Hotel vs Brand (text)' = "Goodnight Inn, all hotels, 2025: occupancy " & FORMAT ( CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "0.0%" ) & ", ADR " & FORMAT ( CALCULATE ( [ADR 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "$#,0.00" ) & ", RevPAR " & FORMAT ( CALCULATE ( [RevPAR 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "$#,0.00" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 9505e74c-5a93-53e8-9d09-8b4fce534510

	/// F4 hotel tooltip, line: the hotel's occupancy by month.
	measure 'Occupancy Hotel (line)' = [Occupancy %]
		formatString: 0.0%
		displayFolder: 14 Findings reference and hover detail
		lineageTag: e266f597-55d9-505c-8687-222f7c409923

	/// F4 hotel tooltip, line: Goodnight Inn's occupancy by month, every hotel.
	measure 'Occupancy Brand (line)' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0%
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 86d49a63-98d9-5729-ab1a-c81d6967be2c

	/// F4 hotel tooltip: who fills the hotel, the three largest guest segments by 2025 room nights and the rest.
	measure 'Segments 2025 (text)' = VAR t = ADDCOLUMNS ( VALUES ( GuestSegments[Segment] ), "@s", CALCULATE ( SUM ( GuestSegments[RoomNights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ) VAR tot = SUMX ( t, [@s] ) VAR top3 = TOPN ( 3, t, [@s], DESC ) RETURN IF ( ISBLANK ( SELECTEDVALUE ( Hotels[Hotel Short Name] ) ) || ISBLANK ( tot ), BLANK (), "Room nights 2025: " & CONCATENATEX ( top3, LOWER ( GuestSegments[Segment] ) & " " & FORMAT ( DIVIDE ( [@s], tot ), "0%" ), ", ", [@s], DESC ) & ", other " & FORMAT ( 1 - DIVIDE ( SUMX ( top3, [@s] ), tot ), "0%" ) )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: bca0f778-ba11-50f6-bc11-15e6ef5a6501

	/// The F4 hotel tooltip's three figures read aloud.
	measure 'Alt Hotel Nums (text)' = "This hotel in 2025: occupancy " & FORMAT ( [Occupancy % 2025], "0.0%" ) & ", average daily rate " & FORMAT ( [ADR 2025], "$#,0" ) & ", revenue per available room " & FORMAT ( [RevPAR 2025], "$#,0" ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 53e33675-924d-55a5-a9b7-23235150c360

	/// The F4 hotel tooltip's line chart read aloud.
	measure 'Alt Occupancy Hotel Line (text)' = "Occupancy by month in 2025, this hotel against the whole brand: the hotel averages " & FORMAT ( [Occupancy % 2025], "0.0%" ) & ", the brand " & FORMAT ( CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "0.0%" ) & "."
