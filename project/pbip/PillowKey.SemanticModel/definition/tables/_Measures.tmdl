	/// First year the cumulative net of package B turns positive, scenario in view; blank when not by 2032.
	measure 'Preset B Payback Year' = VAR f = [Preset B Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( GENERATESERIES ( 2027, 2032, 1 ), "@c", VAR y = [Value] RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = s, TREATAS ( ids, ProjectCashflow[ProjectID] ) ) ) RETURN IF ( ISBLANK ( f ), BLANK (), MINX ( FILTER ( t, [@c] >= 0 ), [Value] ) )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 12e6d5f5-bc29-5b15-a4b6-743edfeafa36

	/// Capex of package B as text.
	measure 'Preset B Capex (text)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), ( VAR __v = ( [Preset B Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 840ef3e1-733e-5cfd-8e8c-47428df2028c

	/// NPV through 2032 of package B, scenario in view, as text.
	measure 'Preset B NPV (text)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), ( VAR __v = ( [Preset B NPV (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
