	/// Tooltip: the line above the moves list.
	measure 'TT Moves Label (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) RETURN IF ( ISBLANK ( pkg ), BLANK (), "In this package: " & COUNTROWS ( ids ) & " moves" )
		formatString: @
