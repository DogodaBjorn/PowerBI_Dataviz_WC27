	/// Preset C: NPV from the Low to the High scenario, $M.
	measure 'Preset C Range (text)' = VAR f = [Preset C Package] VAR lo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 VAR hi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 RETURN IF ( ISBLANK ( f ), BLANK (), IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ), "0.0" ) & " to " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ), "0.0" ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 561f1b9d-636c-5df5-971b-c4553045a300

	/// Preset C: package id and the initiatives in it.
	measure 'Preset C Mix (text)' = VAR f = [Preset C Package] RETURN IF ( ISBLANK ( f ), "No package qualifies in this case.", f & ": " & CONCATENATEX ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], PackageProject[ProjectID] ), " + ", PackageProject[ProjectID], ASC ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 8b77f91e-c87a-566d-b2b8-c8d9534972b6

	/// Scatter capex axis start: the $5M step below the cheapest package (a scatter needs no zero; 08-verbeterplan V4: the band from $0 to $9.4M was empty).
	measure 'Scatter X Start' = INT ( ( MINX ( ALLNOBLANKROW ( Package ), Package[CapexUSD] ) ) / 5000000 ) * 5000000
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 5c80cc67-27e2-5a19-b5bb-623cf3067a2d

	/// Scatter capex axis end: $2M beyond the budget for all packages (no half-clipped dots at $60M, REVIEW M2), or $2M beyond the next $5M above A, B and C in the zoom.
	measure 'Scatter X End' = VAR full = - INT ( - ( MAXX ( ALLNOBLANKROW ( Package ), Package[CapexUSD] ) ) / 10000000 ) * 10000000 + 2000000 VAR abc = - INT ( - ( MAXX ( FILTER ( ALLNOBLANKROW ( Package ), Package[Preset] <> "" ), Package[CapexUSD] ) ) / 5000000 ) * 5000000 + 2000000 RETURN IF ( SELECTEDVALUE ( ScatterView[View], "All packages" ) <> "All packages", abc, full )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 56f0d440-3f76-50da-af87-2963c28cd8c7

	/// Scatter NPV axis start: one range for all three scenarios (DC-034), rounded out to $5M, over all packages or over A, B and C in the zoom.
	measure 'Scatter Y Start' = VAR full = INT ( ( MINX ( ALLNOBLANKROW ( Package ), MINX ( { Package[NPV Low], Package[NPV Expected], Package[NPV High] }, [Value] ) ) - 1500000 ) / 5000000 ) * 5000000 VAR abc = INT ( ( MINX ( FILTER ( ALLNOBLANKROW ( Package ), Package[Preset] <> "" ), MINX ( { Package[NPV Low], Package[NPV Expected], Package[NPV High] }, [Value] ) ) - 1500000 ) / 5000000 ) * 5000000 RETURN IF ( SELECTEDVALUE ( ScatterView[View], "All packages" ) <> "All packages", abc, full )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: eb7518de-818e-5d4f-b085-6f5fc0216f61

	/// Scatter NPV axis end: one range for all three scenarios (DC-034), rounded out to $5M, over all packages or over A, B and C in the zoom.
	measure 'Scatter Y End' = VAR full = - INT ( - ( MAXX ( ALLNOBLANKROW ( Package ), MAXX ( { Package[NPV Low], Package[NPV Expected], Package[NPV High] }, [Value] ) ) + 1500000 ) / 5000000 ) * 5000000 VAR abc = - INT ( - ( MAXX ( FILTER ( ALLNOBLANKROW ( Package ), Package[Preset] <> "" ), MAXX ( { Package[NPV Low], Package[NPV Expected], Package[NPV High] }, [Value] ) ) + 1500000 ) / 5000000 ) * 5000000 RETURN IF ( SELECTEDVALUE ( ScatterView[View], "All packages" ) <> "All packages", abc, full )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: ce856be0-e775-5119-8bf3-7a669da1e10c

	/// Tooltip header: A, B or C by name and role, any other package by its size.
	measure 'TT Title (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR k = LOOKUPVALUE ( Package[Preset], Package[PackageID], pkg ) VAR n = LOOKUPVALUE ( Package[Projects], Package[PackageID], pkg ) RETURN IF ( ISBLANK ( pkg ), BLANK (), SWITCH ( k, "", "A package of " & n & " moves", "C", "C · Why not renovate?", LOOKUPVALUE ( PlanSelector[Label], PlanSelector[Key], k ) ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: d6a2d462-1ad1-5ea5-b8fc-c9095bf65a69

	/// Tooltip: capex of the hovered package, two decimals like the NPV beside it (round 5).
	measure 'TT Capex (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) RETURN IF ( ISBLANK ( pkg ), BLANK (), ( VAR __v = ( LOOKUPVALUE ( Package[CapexUSD], Package[PackageID], pkg ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: b8f1f889-1e83-5d4f-9752-796754413eb7

	/// Tooltip: NPV through 2032 of the hovered package, scenario in view, two decimals (round 5).
	measure 'TT NPV (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR npv = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = pkg ) RETURN IF ( ISBLANK ( pkg ), BLANK (), ( VAR __v = ( npv ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: b093484c-69bb-5165-8219-c821d8300140

	/// Tooltip: label under the NPV.
	measure 'TT NPV Label (text)' = "NPV through 2032, " & [Selected Scenario] & " case"
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 5d5c5592-89ac-5169-9213-9c7daf7d1d56

	/// Tooltip NPV colour: Deep Coffee when it pays back by 2032 (NPV at least zero), Burnt Tangerine below (08-verbeterplan V2); the sign and the payback line carry it too.
	measure 'TT NPV Color' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR npv = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = pkg ) RETURN IF ( ROUND ( npv / 100000, 0 ) >= 0, "#1763A8", "#A63F0E" )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 9b298b18-b872-5fa7-b539-bfafab6ee91d

	/// Tooltip: NPV of the hovered package in all three cases, $M, and the name of the range bar's zero line (round 6).
	measure 'TT Range (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR lo = LOOKUPVALUE ( Package[NPV Low], Package[PackageID], pkg ) / 1000000 VAR ex = LOOKUPVALUE ( Package[NPV Expected], Package[PackageID], pkg ) / 1000000 VAR hi = LOOKUPVALUE ( Package[NPV High], Package[PackageID], pkg ) / 1000000 RETURN IF ( ISBLANK ( pkg ), BLANK (), "Low " & IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ), "0.0" ) & ", Expected " & IF ( ex < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( ex ), "0.0" ) & ", High " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ), "0.0" ) & " ($M; the dark line is break-even)" )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 4357e07f-0d11-526f-8e6b-dbc04ccfd4e6

	/// First year the cumulative net of the hovered package turns positive, scenario in view; blank when not by 2032.
	measure 'TT Payback Year' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( GENERATESERIES ( 2027, 2032, 1 ), "@c", VAR y = [Value] RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = s, TREATAS ( ids, ProjectCashflow[ProjectID] ) ) ) RETURN MINX ( FILTER ( t, [@c] >= 0 ), [Value] )
		formatString: 0
		displayFolder: 10 Package tooltip
		lineageTag: 02751a1a-5f9f-5354-8666-b105b0c339ff

	/// Tooltip verdict: whether the hovered package pays back by 2032 across the three cases (not even in High / only in High / Expected and High / every case), and the first cash-positive year when the case in view pays back.
	measure 'TT Payback (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR npv = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = pkg ) VAR pb = [TT Payback Year] VAR lo = ROUND ( LOOKUPVALUE ( Package[NPV Low], Package[PackageID], pkg ) / 100000, 0 ) VAR ex = ROUND ( LOOKUPVALUE ( Package[NPV Expected], Package[PackageID], pkg ) / 100000, 0 ) VAR hi = ROUND ( LOOKUPVALUE ( Package[NPV High], Package[PackageID], pkg ) / 100000, 0 ) VAR cash = IF ( ROUND ( npv / 100000, 0 ) >= 0 && NOT ISBLANK ( pb ), "; cash positive from " & pb, "" ) RETURN IF ( ISBLANK ( pkg ), BLANK (), SWITCH ( TRUE (), hi < 0, "Does not pay back by 2032, not even in the High case", lo >= 0, "Pays back by 2032 in every case" & cash, ex >= 0, "Pays back by 2032 except in Low" & cash, "Pays back by 2032 only in the High case" & cash ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 78b2dbb1-333d-5bbb-9d56-587498dc7971

	/// Scatter title: how many packages have NPV through 2032 at least zero in the selected scenario, and the capex ceiling they share (the next whole $M above the largest).
	measure 'Scatter Title (text)' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) VAR n = COUNTROWS ( t ) VAR pos = FILTER ( t, [@v] >= 0 ) VAR k = COUNTROWS ( pos ) + 0 VAR cap = INT ( MAXX ( pos, Package[CapexUSD] ) / 1000000 ) + 1 RETURN IF ( k = 0, "None of the " & n & " possible packages pays back by 2032 in the " & s & " case", "Only " & k & " of " & n & " packages " & IF ( k = 1, "pays back by 2032, at under $", "pay back by 2032, all under $" ) & cap & "M" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 3366b508-0764-521c-bee2-1243025a51a2

	/// The scatter title for the small card (alts and build states): the count alone, one line at 672 px.
	measure 'Scatter Title Short (text)' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) VAR n = COUNTROWS ( t ) VAR k = COUNTROWS ( FILTER ( t, [@v] >= 0 ) ) + 0 RETURN IF ( k = 0, "No package pays back by 2032 in the " & s & " case", "Only " & k & " of " & n & " packages " & IF ( k = 1, "pays", "pay" ) & " back by 2032" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 0054f7c1-3eb0-52e5-bcfb-32bdf7a2a145

	/// Shortlist state title.
	measure 'Shortlist Title (text)' = "Three packages, one per criterion (" & [Selected Scenario] & " case)"
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 8bd80225-553a-5ab4-827a-7b7aba1feb92

	/// Plan state title: which package, its role, capex, size and go-live.
	measure 'Plan Title (text)' = VAR f = [Focus Package] RETURN IF ( ISBLANK ( f ), BLANK (), "Package " & [Focus Key] & " (" & SWITCH ( [Focus Key], "B", "considered, not recommended", "C", "why not renovate?", "our recommendation" ) & "): " & ( VAR __v = ( [Focus Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " on " & [Focus Projects] & " initiatives, all live by " & [Focus Live By (text)] )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 5ef22c33-8a86-5aaa-98b0-3dabd5dbe9b9

	/// Plan state: the risks of the package in focus in one sentence; blank when there is no package.
	measure 'Plan Risk (text)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR ren = "GI-07" IN ids VAR pb = [Focus Payback Year] VAR lo = [Focus NPV Low] VAR oos = LOOKUPVALUE ( InvestmentProjects[RoomsOutOfServicePct], InvestmentProjects[ProjectID], "GI-07" ) VAR dur = LOOKUPVALUE ( InvestmentProjects[DurationMonths], InvestmentProjects[ProjectID], "GI-07" ) RETURN IF ( ISBLANK ( f ), BLANK (), "Risks: " & IF ( ren, FORMAT ( oos, "0%" ) & " of " & FORMAT ( [Focus Rooms Refreshed], "#,0" ) & " rooms out of service for " & dur & " months; ", "" ) & IF ( ISBLANK ( lo ) || s = "Low", "", "in the Low case NPV falls to " & ( VAR __v = ( lo ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "; " ) & IF ( ISBLANK ( pb ), "in this case it does not pay back by 2032.", "in this case the cumulative net turns positive in " & pb & "." ) & IF ( "GI-02" IN ids, " Kiosks wait for the app: they start when it goes live.", "" ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 2fbfa611-f119-586b-b0f0-72e54f2a0a63

	/// One line under the dropdown, so changing the focus shows on the landing (REVIEW m2).
	measure 'Focus Line (text)' = VAR f = [Focus Package] VAR s = [Selected Scenario] RETURN IF ( ISBLANK ( f ), BLANK (), "In focus: " & SELECTEDVALUE ( PlanSelector[Label], "A · Our recommendation" ) & "  ·  " & ( VAR __v = ( [Focus Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & "  ·  NPV " & ( VAR __v = ( [Focus NPV (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " (" & s & ")" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 249c0e60-bf6e-5312-b23b-89880137a6a0

	/// Button text that names the package in focus (REVIEW m2).
	measure 'Open Plan Label (text)' = "Open the plan for package " & [Focus Key] & "  " & UNICHAR ( 8594 )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: d82ee645-1458-54b3-bd48-6019ff0fa4c6

	/// What the package changes in the hotels, without zero tiles (REVIEW p9, 07-fixgids S6); under C first why it is shown.
	measure 'Plan Ops (text)' = VAR ra = [Focus Rooms Added] VAR rr = [Focus Rooms Refreshed] VAR hr = [Focus Hotels Rated] VAR parts = FILTER ( { ( 1, IF ( ra > 0, FORMAT ( ra, "#,0" ) & " rooms added" ) ), ( 2, IF ( rr > 0, FORMAT ( rr, "#,0" ) & " rooms refreshed" ) ), ( 3, IF ( hr > 0, "a guest-score effect in " & hr & " hotels" ) ) }, NOT ISBLANK ( [Value2] ) ) VAR f = [Focus Package] VAR lo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) VAR ex = CALCULATE ( SUM ( Package[NPV Expected] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) VAR hi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) VAR why = IF ( [Focus Key] = "C" && ROUND ( lo / 100000, 0 ) < 0 && ROUND ( ex / 100000, 0 ) < 0 && ROUND ( hi / 100000, 0 ) < 0, "Shown to answer 'why not renovate?': it stays below zero through 2032 in every case, High included (" & ( VAR __v = ( hi ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "). ", "" ) RETURN IF ( COUNTROWS ( parts ) = 0 && why = "", BLANK (), why & IF ( COUNTROWS ( parts ) = 0, "", "In the hotels: " & CONCATENATEX ( parts, [Value2], ", ", [Value1], ASC ) & "." ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: dce3caa8-cd07-5ca4-a438-30e370158044

	/// Waterfall title with the scenario in view (REVIEW m6).
	measure 'Waterfall Title (text)' = "Where the NPV comes from, $M through 2032 (" & [Selected Scenario] & ")"
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: e4e86fb3-6de8-5c38-acf9-46a14157eefd

	/// Plan chart: the Low case line, blank when Low is the case in view (the emphasised line draws it).
	measure 'Cumulative Line (Low)' = IF ( [Selected Scenario] = "Low", BLANK (), [Focus Cumulative Net (Low)] )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: cc965468-0fee-5876-982c-34e5ea05a789

	/// Plan chart: the Expected case line, blank when Expected is the case in view (the emphasised line draws it).
	measure 'Cumulative Line (Expected)' = IF ( [Selected Scenario] = "Expected", BLANK (), [Focus Cumulative Net (Expected)] )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 82b8f226-d55c-513f-aad4-7917bf5cb8e8

	/// Plan chart: the High case line, blank when High is the case in view (the emphasised line draws it).
	measure 'Cumulative Line (High)' = IF ( [Selected Scenario] = "High", BLANK (), [Focus Cumulative Net (High)] )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 04d5f1b0-0b12-52e6-8fd0-7bca561ab015

	/// Cumulative net impact of the package in focus in the selected scenario: the emphasised line (REVIEW M9).
	measure 'Focus Cumulative Net (sel)' = SWITCH ( [Selected Scenario], "Low", [Focus Cumulative Net (Low)], "High", [Focus Cumulative Net (High)], [Focus Cumulative Net (Expected)] )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 77c2c17e-dadd-5a4f-a53b-46d4dbc469ad

	/// Standing uncertainty line under the recommendation: the Low case, counted from Package.
	measure 'Uncertainty (text)' = VAR a = [Recommended Package] VAR k = COUNTROWS ( FILTER ( ALLNOBLANKROW ( Package ), Package[NPV Low] >= 0 ) ) + 0 VAR lo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) RETURN "Low case: " & IF ( k = 0, "no package pays back by 2032", k & " packages pay back by 2032" ) & "; A ends at " & ( VAR __v = ( lo ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "."
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: b1c5ebaa-c24c-59b5-bdd8-103c51d2b19d

	/// Goodnight Inn occupancy, 2025 (KPI band).
	measure 'KPI Occupancy GI' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 282fcb4b-110e-5438-b209-b30978b13886

	/// Goodnight Inn operating margin after commissions, 2025 (KPI band).
	measure 'KPI Margin after GI' = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: ab4d3a00-2fe6-531a-b64d-0f9010944ccc

	/// Share of Goodnight Inn room revenue booked through online travel agencies, 2025 (KPI band).
	measure 'KPI OTA GI' = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: d6a4df5c-ae0b-5518-b443-a622717c79b0

	/// Goodnight Inn net promoter score, response-weighted, 2025 (KPI band).
	measure 'KPI NPS GI' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: +0.0;−0.0;0.0
		displayFolder: 08 Brand comparison
		lineageTag: 6c35f2b4-3620-5c0a-87e7-d3e6f561d6db

	/// KPI band value as text: occupancy.
	measure 'KPI Occupancy GI (text)' = FORMAT ( [KPI Occupancy GI], "0.0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: a8870695-ee97-5c62-b735-79efead713d1

	/// KPI band value as text: margin after.
	measure 'KPI Margin after GI (text)' = FORMAT ( [KPI Margin after GI], "0.0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 59980e33-1c4b-5015-8332-6fb0d3fed429

	/// KPI band value as text: ota.
	measure 'KPI OTA GI (text)' = FORMAT ( [KPI OTA GI], "0.0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 4264072e-6de1-5aa1-8c4b-7db65945d794

	/// KPI band value as text: NPS with a true minus or a plus.
	measure 'KPI NPS GI (text)' = VAR v = [KPI NPS GI] RETURN IF ( v < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( v ), "0.0" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 15bb8060-a6ff-5812-962f-a6e5e3dad6b3

	/// Page-1 headline. 'Is losing its guests' overclaimed: occupancy is best of four and F3 says age costs loyalty, not yet rooms (REVIEW M4, 07-fixgids F7).
	measure 'Headline P1 (text)' = "Full rooms, a slipping margin: Goodnight Inn pays the middleman, and its welcome is fading."
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 85ad8d1c-1059-5ccd-ba7a-881a0d55063d

	/// KPI band: rank among the four brands and the range of the other three, 2025.
	measure 'KPI Occupancy Context (text)' = VAR gn = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN 1 * CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > 1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) RETURN words & ", the others " & FORMAT ( MINX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), "0.0%" ) & " to " & FORMAT ( MAXX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), "0.0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 5d689a92-6a4b-5e03-89c5-cf249cb933ef

	/// KPI band: rank among the four brands and the change since 2023 in points.
	measure 'KPI Margin after Context (text)' = VAR gn = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN 1 * CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > 1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) VAR d = ( ROUND ( gn, 3 ) - ROUND ( CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ), 3 ) ) * 100 RETURN words & ", " & IF ( d < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( d ), "0.0" ) & " pt since 2023"
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 9f0d7234-ccd6-5bc6-8381-6760de015019

	/// KPI band: rank among the four brands (lower is better) and the 2021 share.
	measure 'KPI OTA Context (text)' = VAR gn = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN -1 * CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > -1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "lowest of " & n, r = n, "highest of " & n, r = 2, "2nd of " & n, "3rd of " & n ) RETURN words & ", " & FORMAT ( CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ), "0.0%" ) & " in 2021"
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 08606a6e-392f-5863-a576-b2983b9afb8b

	/// KPI band: NPS still positive but falling every year since 2021 (checked year by year), and the rank among the four brands.
	measure 'KPI NPS Context (text)' = VAR gn = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN 1 * CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > 1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) VAR drops = COUNTROWS ( FILTER ( GENERATESERIES ( 2022, 2025, 1 ), VAR y = [Value] RETURN CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y ) < CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y - 1 ) ) ) + 0 VAR n21 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) RETURN IF ( gn > 0, "still positive, but ", "" ) & IF ( drops = 4, "falling every year", IF ( gn < n21, "down since 2021", "up since 2021" ) ) & ", " & words
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 6d7378fc-b65f-5ba0-8878-8e4aa6a0a37b

	/// KPI band, read aloud only: the 2021 value and the range of the other three brands, 2025.
	measure 'KPI NPS Sisters (text)' = VAR lo = MINX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ) VAR hi = MAXX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ) VAR n21 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) RETURN "from " & IF ( n21 < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( n21 ), "0.0" ) & " in 2021; the others " & IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ), "0.0" ) & " to " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ), "0.0" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 6957e647-f2e4-59b0-a1c8-31e7f231449a

	/// The NPS context line with the sisters' range, for the alt text.
	measure 'KPI NPS Alt Context (text)' = [KPI NPS Context (text)] & ", " & [KPI NPS Sisters (text)]
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 9c9b74e9-3990-510b-ae4a-8bab6ef47075

	/// Field-value colour of the occupancy context line.
	measure 'KPI Occupancy Context Color' = VAR gn = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN 1 * CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > 1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) RETURN SWITCH ( TRUE (), r = 1, "#1763A8", r = n, "#A63F0E", "#4B5466" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 7c893480-3d02-5e10-baec-f1464254005d

	/// Field-value colour of the margin context line: Burnt Tangerine when the margin fell since 2023 or is last.
	measure 'KPI Margin after Context Color' = VAR gn = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN 1 * CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > 1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) VAR d = ( ROUND ( gn, 3 ) - ROUND ( CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ), 3 ) ) * 100 RETURN SWITCH ( TRUE (), d < 0 || r = n, "#A63F0E", r = 1, "#1763A8", "#4B5466" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 39cdcf9a-2b53-5db3-8353-638fc6eb8082

	/// Field-value colour of the OTA context line (lower is better).
	measure 'KPI OTA Context Color' = VAR gn = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN -1 * CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > -1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "lowest of " & n, r = n, "highest of " & n, r = 2, "2nd of " & n, "3rd of " & n ) RETURN SWITCH ( TRUE (), r = 1, "#1763A8", r = n, "#A63F0E", "#4B5466" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 36c05381-bb5d-59e9-a3e2-ae6fd7607676

	/// Field-value colour of the NPS context line: Burnt Tangerine when last or falling every year.
	measure 'KPI NPS Context Color' = VAR gn = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN 1 * CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > 1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) VAR drops = COUNTROWS ( FILTER ( GENERATESERIES ( 2022, 2025, 1 ), VAR y = [Value] RETURN CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y ) < CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y - 1 ) ) ) + 0 RETURN SWITCH ( TRUE (), r = n || drops = 4, "#A63F0E", r = 1, "#1763A8", "#4B5466" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: f8fbb360-28b0-5d39-9f53-7abe11c862f7

	/// Goodnight Inn GOP margin before commissions on the trend axis.
	measure 'Trend Margin before GI' = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: fbcffbca-09f6-5624-95ff-94f9476d82c5

	/// F1 title: Goodnight Inn margin after commissions, the change in points since 2023.
	measure 'F1 Title (text)' = VAR a = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) VAR z = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN "After commissions, the margin " & IF ( z < a, "fell", "rose" ) & " " & FORMAT ( ABS ( ROUND ( z, 3 ) - ROUND ( a, 3 ) ) * 100, "0.0" ) & " points since 2023"
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 2bfd36e4-ab5d-5ff6-9867-f719160e348c

	/// F2 title: OTA share of Goodnight Inn room revenue, 2021 to 2025.
	measure 'F2 Title (text)' = VAR a = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR z = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN "Online agencies now book " & FORMAT ( z, "0%" ) & " of room revenue, " & IF ( z > a, "up", "down" ) & " from " & FORMAT ( a, "0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 556bd95e-bb6e-5cb3-ac07-e41e6d19728f

	/// Response-weighted NPS 2025 with a true minus, for chart labels.
	measure 'NPS 2025 (signed)' = [NPS (weighted) 2025]
		formatString: +0.0;−0.0;0.0
		displayFolder: 08 Brand comparison
		lineageTag: 53398b16-6664-51da-9887-f13521070e6a

	/// Tangerine for the oldest band (a risk signal: the only negative NPS), Warm Grey for the others; the axis label and the signed value carry it too.
	measure 'Age Band Color' = IF ( SELECTEDVALUE ( Hotels[Renovation Age Sort] ) = 3, "#E05A22", "#8E897D" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 2efdec81-1469-55f7-b6b8-6b8e9f94fc01

	/// F3 title: NPS 2025 of the Goodnight Inn hotels last renovated 10 or more years ago.
	measure 'F3 Title (text)' = VAR v = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[Renovation Age Sort] = 3 ) RETURN "Hotels last renovated 10 years or more ago score NPS " & ( VAR __q = ( v ) RETURN IF ( ROUND ( __q, 1 ) = 0, "0.0", IF ( __q < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __q ), "0.0", "en-US" ) ) )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 129a8a75-8887-59f6-b8d4-322a3f1fdba5

	/// Goodnight Inn occupancy 2025 in airport hotels.
	measure 'Occupancy Airport GI' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[LocationType] = "Airport" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 1df47ab8-8749-5993-a4ae-b47d5aed4084

	/// Goodnight Inn occupancy 2025 in airport hotels, as text (one formatter with the titles).
	measure 'Occupancy Airport GI (text)' = FORMAT ( [Occupancy Airport GI], "0.0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: c01ebf88-5252-5a28-8d73-45e9dda37ebd

	/// Goodnight Inn occupancy 2025 in city hotels.
	measure 'Occupancy City GI' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[LocationType] = "City" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 6c59ecc6-8caa-577d-bdb4-45c4b38e6811

	/// Goodnight Inn occupancy 2025 in city hotels, as text (one formatter with the titles).
	measure 'Occupancy City GI (text)' = FORMAT ( [Occupancy City GI], "0.0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 26a45686-ee96-5b40-a62b-b102be8101ef

	/// Goodnight Inn occupancy 2025 in highway hotels.
	measure 'Occupancy Highway GI' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[LocationType] = "Highway" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 0e0748b9-8a18-5efe-9ee1-fc3d0e6c52b1

	/// Goodnight Inn occupancy 2025 in highway hotels, as text (one formatter with the titles).
	measure 'Occupancy Highway GI (text)' = FORMAT ( [Occupancy Highway GI], "0.0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 241dee95-6f64-5d73-9e4f-84f68a00284f

	/// Capex of the recommendation.
	measure 'Rec Capex' = VAR a = [Recommended Package] RETURN CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: \$#,0,,.0\M
		displayFolder: 09 Package matrix
		lineageTag: f1d14dc7-758e-518a-9766-49931344c1b3

	/// NPV through 2032 of the recommendation, selected scenario.
	measure 'Rec NPV (sel)' = VAR a = [Recommended Package] RETURN CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 48901272-99f2-59d5-891a-6d9d680f84c1

	/// Operating-profit run-rate in 2032 of the recommendation, selected scenario.
	measure 'Rec Run-rate (sel)' = VAR a = [Recommended Package] RETURN CALCULATE ( [Package Run-rate (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 26dc2cb5-dde3-593b-9f76-8416b1e8242f

	/// NPV of the recommendation from the Low to the High scenario, $M.
	measure 'Rec Range (text)' = VAR a = [Recommended Package] VAR lo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) / 1000000 VAR hi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) / 1000000 RETURN IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ), "0.0" ) & " to " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ), "0.0" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: f71fde11-ee80-597b-b9da-1d3ab7d19808

	/// The initiatives in the recommendation.
	measure 'Rec Mix (text)' = VAR a = [Recommended Package] RETURN CONCATENATEX ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], PackageProject[ProjectID] ), " + ", PackageProject[ProjectID], ASC )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 276c6e3c-39d0-58e9-b974-75af201ad967

	/// Which page-1 finding each move of A answers, where the weakest move goes, and why it stays although it does not pay back on its own.
	measure 'Rec Answers (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR cap = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR npvs = ADDCOLUMNS ( aIds, "@e", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p, Scenario[Scenario] = "Expected" ), "@n", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR wp = MAXX ( TOPN ( 1, npvs, [@e], ASC ), [@p] ) VAR we = MAXX ( FILTER ( npvs, [@p] = wp ), [@e] ) VAR wn = MAXX ( FILTER ( npvs, [@p] = wp ), [@n] ) VAR wf = LOOKUPVALUE ( InvestmentProjects[Answers Finding], InvestmentProjects[ProjectID], wp ) VAR wc = LOOKUPVALUE ( InvestmentProjects[CapexUSD], InvestmentProjects[ProjectID], wp ) VAR cheapest = wc <= MINX ( FILTER ( ALLNOBLANKROW ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" && InvestmentProjects[Answers Finding] = wf ), InvestmentProjects[CapexUSD] ) VAR hs = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = wp ), "@h", InvestmentProjectProperties[HotelID] ) VAR nh = COUNTROWS ( hs ) VAR occ = ADDCOLUMNS ( FILTER ( ALLNOBLANKROW ( Hotels ), Hotels[Brand] = "Goodnight Inn" ), "@o", CALCULATE ( [Occupancy % 2025] ) ) VAR fullest = COUNTROWS ( FILTER ( TOPN ( nh, occ, [@o], DESC ), Hotels[HotelID] IN hs ) ) = nh VAR ht = ADDCOLUMNS ( hs, "@t", LOOKUPVALUE ( Hotels[LocationType], Hotels[HotelID], [@h] ) ) VAR tt = GROUPBY ( ht, [@t], "@n", COUNTX ( CURRENTGROUP (), 1 ) ) VAR dest = IF ( nh > 1, " go to the " & nh & IF ( fullest, " fullest hotels", " hotels" ) & " (" & CONCATENATEX ( tt, [@n] & " " & LOWER ( [@t] ), ", ", [@n], DESC ) & ")", "" ) VAR wname = SUBSTITUTE ( LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], wp ) ), " at " & nh & " desks", "" ) VAR neg = ROUND ( we / 100000, 0 ) < 0 && ROUND ( wn / 100000, 0 ) < 0 RETURN "Each move answers a Brand Review finding: " & CONCATENATEX ( aIds, LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ) & " " & LOOKUPVALUE ( InvestmentProjects[Answers Finding], InvestmentProjects[ProjectID], [@p] ), ", ", [@p], ASC ) & ". " & IF ( dest <> "" || neg, "The " & wname & dest & IF ( neg, IF ( dest <> "", "; on their own they", " on their own" ) & " return " & ( VAR __v = ( wn ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " by 2032" & IF ( cheapest, ", but they are the cheapest answer to " & wf, "" ), "" ) & ".", "" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 3d7a2d59-6b3d-5162-98e1-3cf1853474a7

	/// The budget held back: until when, why nothing else is funded now, and the marginal test: the best package with all of A and more lowers the NPV (plan 09 R3).
	measure 'Rec Held (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR cap = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR k = COUNTROWS ( aIds ) VAR word = SWITCH ( k, 2, "both", 3, "all three", 4, "all four", 5, "all five", "all " & k ) VAR live = FORMAT ( CALCULATE ( MAX ( InvestmentProjects[Completion Date] ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] IN aIds ), "mmm yyyy" ) VAR others = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" && NOT ( InvestmentProjects[ProjectID] IN aIds ) ), "@p", InvestmentProjects[ProjectID] ) VAR hiPos = COUNTROWS ( FILTER ( others, VAR p = [@p] RETURN ROUND ( CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p, Scenario[Scenario] = "High" ) / 100000, 0 ) >= 0 ) ) + 0 VAR s = [Selected Scenario] VAR nA = COUNTROWS ( aIds ) VAR sup = FILTER ( ALLNOBLANKROW ( Package ), Package[Projects] > nA && COUNTROWS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = Package[PackageID] && PackageProject[ProjectID] IN aIds ) ) = nA ) VAR t = ADDCOLUMNS ( sup, "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) VAR best = TOPN ( 1, t, [@v], DESC, Package[CapexUSD], ASC ) VAR bid = MAXX ( best, Package[PackageID] ) VAR bv = MAXX ( best, [@v] ) VAR bc = MAXX ( best, Package[CapexUSD] ) VAR av = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR added = CONCATENATEX ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = bid && NOT ( PackageProject[ProjectID] IN aIds ) ), LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], PackageProject[ProjectID] ) ), " and ", PackageProject[ProjectID], ASC ) VAR margin = IF ( NOT ISBLANK ( bid ) && ROUND ( ( bv - av ) / 100000, 0 ) < 0, " The best way to spend more, A plus the " & added & ", costs " & ( VAR __v = ( bc - cap ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " more and lowers the NPV by " & ( VAR __v = ( av - bv ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ".", "" ) RETURN "The other " & ( VAR __v = ( budget - cap ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " is held back, to be decided again once " & word & " moves are live, by " & live & ": " & IF ( hiPos = 0, "no other initiative pays back by 2032, even in the High case.", hiPos & " other initiatives pay back by 2032 only in the High case." ) & margin
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 8d07c1d9-75b0-52ec-9f08-3f0b2d7bb3cf

	/// The contest rules ticked off for A: initiatives, growth initiatives (dataset flag), budget, horizon (REVIEW M11).
	measure 'Rec Rules (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR cap = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR h = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) VAR g = FILTER ( aIds, LOOKUPVALUE ( InvestmentProjects[GrowthInitiative], InvestmentProjects[ProjectID], [@p] ) = "Yes" ) RETURN "Within the rules: " & COUNTROWS ( aIds ) & " initiatives, " & COUNTROWS ( g ) & " of them growth, " & ( VAR __v = ( cap ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " of " & ( VAR __v = ( budget ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ", impact through " & h & "."
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 5498f0d3-0623-5d2a-926e-843fffbfbd01

	/// Alternative B against the recommendation, selected scenario (B is fixed: 07-fixgids K1).
	measure 'Alt B (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR x = [Preset B Package] VAR xIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = x ), "@p", PackageProject[ProjectID] ) VAR added = CONCATENATEX ( FILTER ( xIds, NOT ( [@p] IN aIds ) ), SUBSTITUTE ( LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), "refresh 10 oldest", "refresh of the 10 oldest hotels" ), " and ", [@p], ASC ) VAR dropped = CONCATENATEX ( FILTER ( aIds, NOT ( [@p] IN xIds ) ), LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), " and ", [@p], ASC ) VAR capA = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR capX = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR npvA = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR npvX = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR rA = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR rX = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) RETURN IF ( ISBLANK ( x ), BLANK (), "B · " & "" & IF ( dropped = "", "A plus the " & added, "The " & added & " instead of the " & dropped ) & ": " & ( VAR __v = ( capX ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ", NPV " & ( VAR __v = ( npvX ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ". " & ( IF ( rX > rA, "A guest-score effect in " & rX & " hotels instead of " & rA & ", for " & ( VAR __v = ( capX - capA ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " more and a " & IF ( npvX < npvA, "lower", "higher" ) & " NPV.", "" ) ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 4c581561-ac98-50c2-b461-486462c885cb

	/// C against the recommendation, selected scenario: the answer to 'why not renovate?'; 'pays back by 2032' means NPV through 2032 at least zero, as on the scatter.
	measure 'Alt C (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR x = [Preset C Package] VAR xIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = x ), "@p", PackageProject[ProjectID] ) VAR added = CONCATENATEX ( FILTER ( xIds, NOT ( [@p] IN aIds ) ), SUBSTITUTE ( LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), "refresh 10 oldest", "refresh of the 10 oldest hotels" ), " and ", [@p], ASC ) VAR dropped = CONCATENATEX ( FILTER ( aIds, NOT ( [@p] IN xIds ) ), LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), " and ", [@p], ASC ) VAR capA = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR capX = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR npvA = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR npvX = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR rA = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR rX = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) RETURN IF ( ISBLANK ( x ), BLANK (), "C · " & "Why not renovate? " & IF ( dropped = "", "A plus the " & added, "The " & added & " instead of the " & dropped ) & ": " & ( VAR __v = ( capX ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ", NPV " & ( VAR __v = ( npvX ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ". " & ( VAR hiX = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR allNeg = ROUND ( CALCULATE ( MAX ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) / 100000, 0 ) < 0 && ROUND ( CALCULATE ( MAX ( Package[NPV Expected] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) / 100000, 0 ) < 0 && ROUND ( hiX / 100000, 0 ) < 0 RETURN "It answers F3 most directly, " & IF ( allNeg, "but it stays below zero through 2032 in every case (High " & ( VAR __v = ( hiX ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ").", IF ( ROUND ( npvX / 100000, 0 ) < 0, "but it does not pay back by 2032 in this case.", "and it pays back by 2032." ) ) ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 4da4c946-bb87-5819-94c5-70a3d16f8e16

	/// The initiatives outside A, B and C, and the reason the selection leaves them out.
	measure 'Not Funded (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR bp = [Preset B Package] VAR cp = [Preset C Package] VAR bc = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] IN { bp, cp } ), "@p", PackageProject[ProjectID] ) VAR t = FILTER ( ALLNOBLANKROW ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" && NOT ( InvestmentProjects[ProjectID] IN aIds ) && NOT ( InvestmentProjects[ProjectID] IN bc ) ) VAR names = CONCATENATEX ( t, InvestmentProjects[Short Name], ", ", InvestmentProjects[ProjectID], ASC ) VAR f4 = COUNTROWS ( FILTER ( t, InvestmentProjects[Answers Finding] = "F4" ) ) RETURN IF ( ISBLANK ( names ), BLANK (), "Not funded: " & names & IF ( f4 > 0, " (" & f4 & " of them answer F4)", "" ) & ": A has the highest NPV (Expected), so adding any lowers it." )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: a3b635f6-a03b-5701-8900-898cfc08f1df

	/// The P2 masthead read aloud in sentence case (the canvas line is in capitals, which a screen reader may spell out).
	measure 'Alt Masthead P2 (text)' = "2027 to 2032, Goodnight Inn budget " & ( VAR __v = ( CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 2189957c-e71b-5273-9492-5a7a01500e3b

	/// Page-2 masthead line on the night zone: the horizon and the brand budget, read from Brands (was typed into the report generator).
	measure 'Masthead P2 (text)' = "2027 TO 2032  ·  GOODNIGHT INN BUDGET " & ( VAR __v = ( CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 49b1e1f7-9070-5d20-bf50-5b8e542eef08

	/// Capex of A as text.
	measure 'Rec Capex (text)' = VAR a = [Recommended Package] RETURN ( VAR __v = ( CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 6bcdd1ca-7963-5bdb-8a7a-c37bfcae080f

	/// NPV through 2032 of A, selected scenario, as text.
	measure 'Rec NPV (text)' = ( VAR __v = ( [Rec NPV (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: b565144e-f5a5-56aa-bbc4-5e7e1de9b2fd

	/// Profit a year by 2032 of A, selected scenario, as text.
	measure 'Rec Run-rate (text)' = ( VAR __v = ( [Rec Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 3500573b-d4b3-5cde-a1d7-c3fc51261e27

	/// KPI band, read aloud: the label, the value and the comparison (Occupancy).
	measure 'Alt KPI Occupancy (text)' = "Goodnight Inn occupancy in 2025: " & [KPI Occupancy GI (text)] & ", " & SUBSTITUTE ( [KPI Occupancy Context (text)], " · ", "; " ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 654b8194-f25e-5758-88bf-d3ebbc69a7ee

	/// KPI band, read aloud: the label, the value and the comparison (Margin after).
	measure 'Alt KPI Margin after (text)' = "Goodnight Inn operating margin after commissions in 2025: " & [KPI Margin after GI (text)] & ", " & SUBSTITUTE ( [KPI Margin after Context (text)], " · ", "; " ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 9074e48a-f1da-54b8-a65a-f72702c59262

	/// KPI band, read aloud: the label, the value and the comparison (OTA).
	measure 'Alt KPI OTA (text)' = "Share of Goodnight Inn room revenue booked through online agencies in 2025: " & [KPI OTA GI (text)] & ", " & SUBSTITUTE ( [KPI OTA Context (text)], " · ", "; " ) & "."
		formatString: @
