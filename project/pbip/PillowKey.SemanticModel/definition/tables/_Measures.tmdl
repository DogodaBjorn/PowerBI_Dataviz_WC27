	measure 'Definitions Pill SVG' = "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='144' height='28' viewBox='0 0 144 28'>" & "<rect width='144' height='28' rx='14' fill='%23FCE6DB'/><circle cx='14' cy='14' r='10' fill='%23E05A22'/><circle cx='14' cy='9.4' r='1.6' fill='%23FFFFFF'/><rect x='12.8' y='12.2' width='2.4' height='7.4' rx='1.2' fill='%23FFFFFF'/></svg>"
