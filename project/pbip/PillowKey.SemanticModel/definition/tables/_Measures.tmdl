	/// NPV through 2032 of package B, scenario in view, as text.
	measure 'Preset B NPV (text)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), ( VAR __t = ROUND ( ( [Preset B NPV (sel)] ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: b8d6debc-1bb0-53f0-8b07-1b16d6409723

	/// Cumulative net impact of package C, undiscounted 2025 dollars, scenario in view (the comparer lines).
	measure 'Preset C Cumulative Net (sel)' = VAR f = [Preset C Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR y = MAX ( 'Date'[Year] ) RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = s, TREATAS ( ids, ProjectCashflow[ProjectID] ) ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 2bcd9c99-4aff-589b-8f70-fe219adff021

	/// First year the cumulative net of package C turns positive, scenario in view; blank when not by 2032.
	measure 'Preset C Payback Year' = VAR f = [Preset C Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( GENERATESERIES ( 2027, 2032, 1 ), "@c", VAR y = [Value] RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = s, TREATAS ( ids, ProjectCashflow[ProjectID] ) ) ) RETURN IF ( ISBLANK ( f ), BLANK (), MINX ( FILTER ( t, [@c] >= 0 ), [Value] ) )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 6e6e7e31-9aec-5d86-962f-affa04a83a43

	/// Capex of package C as text.
	measure 'Preset C Capex (text)' = VAR f = [Preset C Package] RETURN IF ( ISBLANK ( f ), BLANK (), FORMAT ( ( [Preset C Capex] ) / 1000000, "$#,0.0#" ) & "M" )
