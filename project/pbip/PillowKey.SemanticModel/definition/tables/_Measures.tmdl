	/// NPV of the plan being built as text.
	measure 'Build NPV (text)' = ( VAR __t = ROUND ( ( COALESCE ( [Build NPV (sel)], 0 ) ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) )
