/// Measure home for the three sketches. Base measures read columns; everything else reads measures.
table _Measures
	lineageTag: 1458bfa0-b6ec-5a43-b70a-dba08e4c82c9

	/// Room nights on offer in the period.
	measure 'Rooms Available' = SUM ( MonthlyPerformance[RoomsAvailable] )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 15e620f0-72e5-5bb0-af92-a42e8b058465

	/// Room nights sold in the period.
	measure 'Rooms Sold' = SUM ( MonthlyPerformance[RoomsSold] )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: bc28c802-0b83-558e-bfc9-0a5f5e50f676

	/// Rooms sold over rooms available.
	measure 'Occupancy %' = DIVIDE ( [Rooms Sold], [Rooms Available] )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: 81edb257-d639-55c7-a515-2a1dc41d7d00

	/// Room revenue from MonthlyPerformance.
	measure 'Room Revenue' = SUM ( MonthlyPerformance[RoomRevenue] )
		formatString: \$#,0;(\$#,0)
		displayFolder: 01 Core
		lineageTag: 6c9fd4c1-1eab-582d-91bc-ac6adc59f88e

	/// Room, food and beverage and other revenue.
	measure 'Total Revenue' = SUM ( MonthlyPerformance[TotalRevenue] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 01 Core
		lineageTag: 611eda89-e11a-51f9-852c-84ad2869c1ed

	/// Average daily rate: room revenue per room night sold.
	measure ADR = DIVIDE ( [Room Revenue], [Rooms Sold] )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: 4e3b018b-5c85-54e6-b87b-03305e86610e

	/// Room revenue per available room night.
	measure RevPAR = DIVIDE ( [Room Revenue], [Rooms Available] )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: f991f809-aa2a-5bee-abc0-e2694d36590a

	/// Total operating expenses; excludes distribution cost (workbook convention).
	measure 'Operating Expenses' = SUM ( MonthlyPerformance[TotalOperatingExpenses] )
		formatString: \$#,0;(\$#,0)
		displayFolder: 01 Core
		lineageTag: c8e49cde-76f5-5dc3-a8e8-2d7ddd917544

	/// Gross operating profit before distribution cost.
	measure GOP = [Total Revenue] - [Operating Expenses]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 01 Core
		lineageTag: 9522763a-3950-59b3-b72b-5044bac9cc91

	/// GOP as a share of total revenue.
	measure 'GOP Margin %' = DIVIDE ( [GOP], [Total Revenue] )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: 79725232-88a8-572a-871e-1251de9a9e45

	/// Total revenue per room night sold.
	measure 'Revenue per Occupied Room' = DIVIDE ( [Total Revenue], [Rooms Sold] )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: 368af188-2f3f-5577-a485-f03517dac7ad

	/// Operating expenses per room night sold.
	measure 'Cost per Occupied Room' = DIVIDE ( [Operating Expenses], [Rooms Sold] )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: 812e1ca5-09e2-5891-b039-2555a42919c3

	/// Revenue per occupied room indexed to 2023 (2021 is a depressed base year).
	measure 'RevPOR Index (2023 = 100)' = DIVIDE ( [Revenue per Occupied Room], CALCULATE ( [Revenue per Occupied Room], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) ) * 100
		formatString: 0.0
		displayFolder: 01 Core
		lineageTag: 7672193a-1a50-53ff-80b2-9a52b3567ef5

	/// Cost per occupied room indexed to 2023.
	measure 'CPOR Index (2023 = 100)' = DIVIDE ( [Cost per Occupied Room], CALCULATE ( [Cost per Occupied Room], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) ) * 100
		formatString: 0.0
		displayFolder: 01 Core
		lineageTag: 8a13ed34-1476-584a-91b0-581dc3f3a7f5

	/// Rooms in the hotels in context.
	measure 'Hotel Rooms' = SUM ( Hotels[Rooms] )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 14b5b665-4757-54c6-82e8-4555218fe8fc

	/// Number of hotels in context.
	measure 'Hotels in Context' = DISTINCTCOUNT ( Hotels[HotelID] )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 015b332f-be85-57fa-bc9c-2abf93898329

	/// Years since the last refresh for the hotel in context (scatter axis).
	measure 'Refresh Age' = MAX ( Hotels[Years Since Refresh] )
		formatString: 0
		displayFolder: 01 Core
		lineageTag: 87c5d21c-6213-5e62-8957-238e5336be48

	/// Renovation capex since 2018 divided by the hotels in context.
	measure 'Renovation Spend per Hotel since 2018' = DIVIDE ( CALCULATE ( SUM ( Renovations[CostUSD] ), Renovations[StartDate] >= DATE ( 2018, 1, 1 ) ), [Hotels in Context] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 01 Core
		lineageTag: f8841b09-39ea-58eb-9629-f5a70a7189b2

	/// Room revenue by booking channel (reconciles to MonthlyPerformance).
	measure 'Channel Room Revenue' = SUM ( BookingChannels[RoomRevenue] )
		formatString: \$#,0;(\$#,0)
		displayFolder: 02 Channels
		lineageTag: 63c08a11-af6c-5f11-9d97-a3508d14034b

	/// Room nights by booking channel.
	measure 'Channel Room Nights' = SUM ( BookingChannels[RoomNights] )
		formatString: #,0
		displayFolder: 02 Channels
		lineageTag: 0c30643e-51b4-5929-a5d4-a0c86f8a8c92

	/// Commissions and fees paid to booking channels; outside operating expenses.
	measure 'Distribution Cost' = SUM ( BookingChannels[DistributionCost] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 02 Channels
		lineageTag: 92403efb-edbf-551f-a49e-beb303313859

	/// Distribution cost as a share of room revenue.
	measure 'Distribution Cost % of Room Revenue' = DIVIDE ( [Distribution Cost], [Channel Room Revenue] )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: 2c9291bd-7430-52de-8a8f-c389672e9ee7

	/// A channel's share of room revenue in context.
	measure 'Channel Share %' = DIVIDE ( [Channel Room Revenue], CALCULATE ( [Channel Room Revenue], ALL ( BookingChannels[Channel] ) ) )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: bd865932-a5f0-5c0b-b548-c0f812916144

	/// Share of room revenue booked through online travel agencies.
	measure 'OTA Share %' = CALCULATE ( [Channel Share %], BookingChannels[Channel] = "Online Travel Agencies" )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: f4591194-41ca-5fe2-b414-8179f3432176

	/// Share of room revenue booked directly (web, app, phone, walk-in).
	measure 'Direct Share %' = CALCULATE ( [Channel Share %], BookingChannels[Channel] IN { "Direct Website & App", "Direct Phone & Walk-in" } )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: 887d3a1e-03cf-542f-bd41-93a3d7eda110

	/// GOP after commissions and channel fees.
	measure 'GOP after Distribution' = [GOP] - [Distribution Cost]
		formatString: \$#,0;(\$#,0)
		displayFolder: 02 Channels
		lineageTag: ef3a40f4-8904-58c6-90dc-8fc578b7da82

	/// Margin after distribution cost; the like-for-like benchmark across brands.
	measure 'GOP Margin after Distribution %' = DIVIDE ( [GOP after Distribution], [Total Revenue] )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: e2e5cd3f-bb4a-5ef3-b6f4-a199afea1738

	/// Counterfactual, labeled as such: this period's room revenue at the 2021 channel mix, at each channel's current cost rate.
	measure 'Distribution Cost at 2021 Mix' = SUMX ( VALUES ( BookingChannels[Channel] ), VAR share21 = CALCULATE ( [Channel Share %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR rate = [Distribution Cost % of Room Revenue] VAR total = CALCULATE ( [Channel Room Revenue], ALL ( BookingChannels[Channel] ) ) RETURN share21 * total * rate )
		formatString: \$#,0;(\$#,0)
		displayFolder: 02 Channels
		lineageTag: 592d2231-41ee-5fc4-af2e-977ec1a92673

	/// What the channel drift since 2021 costs per period (counterfactual).
	measure 'Distribution Cost above 2021 Mix' = [Distribution Cost] - [Distribution Cost at 2021 Mix]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 02 Channels
		lineageTag: 21b93e32-ba99-5974-bf0c-fbad68f61752

	/// Guest survey responses.
	measure 'Survey Responses' = SUM ( GuestExperience[SurveyResponses] )
		formatString: #,0
		displayFolder: 03 Guest
		lineageTag: 08fe88a8-c4c9-5d98-9874-85883fb6f133

	/// Net promoter score weighted by survey responses (an unweighted average is a contract violation).
	measure 'NPS (weighted)' = DIVIDE ( SUMX ( GuestExperience, GuestExperience[NetPromoterScore] * GuestExperience[SurveyResponses] ), [Survey Responses] )
		formatString: +0.0;-0.0;0.0
		displayFolder: 03 Guest
		lineageTag: a0f109f1-4572-5b54-8803-9ae71c64aff9

	/// Overall guest score weighted by responses.
	measure 'Overall Score (weighted)' = DIVIDE ( SUMX ( GuestExperience, GuestExperience[OverallScore] * GuestExperience[SurveyResponses] ), [Survey Responses] )
		formatString: 0.00
		displayFolder: 03 Guest
		lineageTag: 69817232-b610-5a17-8e62-b2578b86095e

	/// Room comfort score weighted by responses.
	measure 'Room Comfort (weighted)' = DIVIDE ( SUMX ( GuestExperience, GuestExperience[RoomComfortScore] * GuestExperience[SurveyResponses] ), [Survey Responses] )
		formatString: 0.00
		displayFolder: 03 Guest
		lineageTag: 9bc42302-2d1f-5b67-b2fe-14bfd3ad1dae

	/// Complaints logged.
	measure Complaints = SUM ( GuestComplaints[Complaints] )
		formatString: #,0
		displayFolder: 03 Guest
		lineageTag: ea9b0731-8f5a-5aec-a139-2aff8a3e5a5f

	/// Complaints normalised per thousand room nights sold.
	measure 'Complaints per 1k Room Nights' = DIVIDE ( [Complaints], [Rooms Sold] ) * 1000
		formatString: 0.00
		displayFolder: 03 Guest
		lineageTag: 3f04b828-56b8-54e8-befc-2f34af4e0866

	/// Occupancy % fixed to calendar 2024, ignoring the page's date context.
	measure 'Occupancy % 2024' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: 53f56e3a-0f6d-5998-8207-4103d479c716

	/// Occupancy % fixed to calendar 2025, ignoring the page's date context.
	measure 'Occupancy % 2025' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: 7640b601-d6d0-5ab5-b9b6-4edfd10e57e3

	/// RevPAR fixed to calendar 2024, ignoring the page's date context.
	measure 'RevPAR 2024' = CALCULATE ( [RevPAR], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: 5d812a2a-f983-53e1-8332-87e82201855c

	/// RevPAR fixed to calendar 2025, ignoring the page's date context.
	measure 'RevPAR 2025' = CALCULATE ( [RevPAR], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: f5ed19d9-8242-5736-8f5f-863ccdf8335a

	/// ADR fixed to calendar 2025, ignoring the page's date context.
	measure 'ADR 2025' = CALCULATE ( [ADR], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: fab2a2eb-3ca6-52ac-9ef6-85b42a2e820c

	/// GOP Margin % fixed to calendar 2023, ignoring the page's date context.
	measure 'GOP Margin % 2023' = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: 5a60b903-9b0e-5bc5-a505-2d8855ca2f68

	/// GOP Margin % fixed to calendar 2024, ignoring the page's date context.
	measure 'GOP Margin % 2024' = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: c948e2d8-d9dc-51be-adcc-0dc9809128a1

	/// GOP Margin % fixed to calendar 2025, ignoring the page's date context.
	measure 'GOP Margin % 2025' = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: d2b301a4-d17c-51e5-81a2-f054b5f3fcbe

	/// GOP Margin after Distribution % fixed to calendar 2025, ignoring the page's date context.
	measure 'GOP Margin after Distribution % 2025' = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: 37f892d8-44b9-5078-8fb4-c2cf96b0d4c2

	/// NPS (weighted) fixed to calendar 2021, ignoring the page's date context.
	measure 'NPS (weighted) 2021' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 03 Guest
		lineageTag: edb5f5d0-0958-565f-99fb-d48a86707322

	/// NPS (weighted) fixed to calendar 2025, ignoring the page's date context.
	measure 'NPS (weighted) 2025' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 03 Guest
		lineageTag: 5a57e5a8-c937-52d2-ace4-4ce0ab4e4220

	/// Room Comfort (weighted) fixed to calendar 2025, ignoring the page's date context.
	measure 'Room Comfort (weighted) 2025' = CALCULATE ( [Room Comfort (weighted)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.00
		displayFolder: 03 Guest
		lineageTag: e9a38773-6685-5d2a-845b-0be48ff21b77

	/// Complaints per 1k Room Nights fixed to calendar 2025, ignoring the page's date context.
	measure 'Complaints per 1k Room Nights 2025' = CALCULATE ( [Complaints per 1k Room Nights], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.00
		displayFolder: 03 Guest
		lineageTag: e300978d-a1e0-5d54-bdc0-0b423082a1e1

	/// OTA Share % fixed to calendar 2025, ignoring the page's date context.
	measure 'OTA Share % 2025' = CALCULATE ( [OTA Share %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: c3b9be8a-03ef-5e57-b136-f48d2c8ab30b

	/// Direct Share % fixed to calendar 2025, ignoring the page's date context.
	measure 'Direct Share % 2025' = CALCULATE ( [Direct Share %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: 7301053e-5c43-5b3d-bd2c-0f8cdbd053bf

	/// Distribution Cost fixed to calendar 2025, ignoring the page's date context.
	measure 'Distribution Cost 2025' = CALCULATE ( [Distribution Cost], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 02 Channels
		lineageTag: 354fc9e4-d222-57c0-9558-6c293693ebe6

	/// Distribution Cost % of Room Revenue fixed to calendar 2021, ignoring the page's date context.
	measure 'Distribution Cost % of Room Revenue 2021' = CALCULATE ( [Distribution Cost % of Room Revenue], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: 1f3fdc50-267b-521b-862e-6a9dc9b4237c

	/// Distribution Cost % of Room Revenue fixed to calendar 2025, ignoring the page's date context.
	measure 'Distribution Cost % of Room Revenue 2025' = CALCULATE ( [Distribution Cost % of Room Revenue], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: ebb802dc-0def-56f1-973f-49c55ba617bf

	/// Distribution Cost at 2021 Mix fixed to calendar 2025, ignoring the page's date context.
	measure 'Distribution Cost at 2021 Mix 2025' = CALCULATE ( [Distribution Cost at 2021 Mix], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0;(\$#,0)
		displayFolder: 02 Channels
		lineageTag: c243d64e-c492-5020-bd12-9d4d051d0297

	/// Distribution Cost above 2021 Mix fixed to calendar 2025, ignoring the page's date context.
	measure 'Distribution Cost above 2021 Mix 2025' = CALCULATE ( [Distribution Cost above 2021 Mix], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 02 Channels
		lineageTag: f397a61b-9620-5567-ae1e-838987425999

	/// Rooms Sold fixed to calendar 2025, ignoring the page's date context.
	measure 'Rooms Sold 2025' = CALCULATE ( [Rooms Sold], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 0e79d2cc-cb09-52b3-b84a-9c3c5d046bd3

	/// Total Revenue fixed to calendar 2025, ignoring the page's date context.
	measure 'Total Revenue 2025' = CALCULATE ( [Total Revenue], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 01 Core
		lineageTag: 62fe9cd9-4a87-54b9-9390-b96496d5020a

	/// GOP fixed to calendar 2025, ignoring the page's date context.
	measure 'GOP 2025' = CALCULATE ( [GOP], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 01 Core
		lineageTag: 2f6a136c-7372-537b-bf2b-bfc6bbba4aa3

	/// Revenue per Occupied Room fixed to calendar 2025, ignoring the page's date context.
	measure 'Revenue per Occupied Room 2025' = CALCULATE ( [Revenue per Occupied Room], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: efb7519c-603c-5f98-abe9-dd7b03bae391

	/// Full (85 percent or more), Tired (negative NPS), Weak (under 65 percent), else Fine; 2025.
	measure 'Hotel Status 2025' = VAR occ = [Occupancy % 2025] VAR nps = [NPS (weighted) 2025] RETURN SWITCH ( TRUE (), occ >= 0.85, "Full", nps < 0, "Tired", occ < 0.65, "Weak", "Fine" )
		formatString: @
		displayFolder: 03 Guest
		lineageTag: ae5fd3c4-3894-5ae1-b5ae-5127f340ef7c

	/// Investment budget of the brand in context.
	measure Budget = SUM ( Brands[InvestmentBudgetUSD] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 04 Plan builder
		lineageTag: 4ff60ba8-b286-538a-af8a-7a6ba42ec304

	/// Capex of the projects currently selected in the plan builder.
	measure 'Capex Selected' = SUM ( InvestmentProjects[CapexUSD] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 04 Plan builder
		lineageTag: 2bd6d633-c903-5d48-90df-2d506f2fe30a

	/// Selected capex over the brand budget.
	measure 'Budget Used %' = DIVIDE ( [Capex Selected], [Budget] )
		formatString: 0.0%
		displayFolder: 04 Plan builder
		lineageTag: 2a9f54f9-477c-546e-b86d-0a6ccd0dacb4

	/// Budget left after the selection.
	measure 'Budget Remaining' = [Budget] - [Capex Selected]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 04 Plan builder
		lineageTag: 72a2ee5e-1411-51eb-8c5e-a3b08e11852a

	/// Projects in the selection.
	measure 'Projects Selected' = COUNTROWS ( InvestmentProjects )
		formatString: 0
		displayFolder: 04 Plan builder
		lineageTag: 3b4e0ff8-7234-5676-b69b-c2fd301a7beb

	/// Selected projects flagged as growth initiatives by the organisers.
	measure 'Growth Initiatives Selected' = CALCULATE ( COUNTROWS ( InvestmentProjects ), InvestmentProjects[GrowthInitiative] = "Yes" )
		formatString: 0
		displayFolder: 04 Plan builder
		lineageTag: accb5c31-ac19-5c56-a1c4-2a6b8c699da5

	/// Contest constraints as a lamp: at least 3 projects, at least 1 growth initiative, within budget, GI-02 needs GI-01.
	measure 'Plan Valid (text)' = VAR n = [Projects Selected] VAR g = [Growth Initiatives Selected] VAR over = [Capex Selected] > [Budget] VAR kiosk = CALCULATE ( COUNTROWS ( InvestmentProjects ), InvestmentProjects[ProjectID] = "GI-02" ) > 0 VAR app = CALCULATE ( COUNTROWS ( InvestmentProjects ), InvestmentProjects[ProjectID] = "GI-01" ) > 0 VAR issues = IF ( n < 3, "fewer than 3 projects; ", "" ) & IF ( g < 1, "no growth initiative; ", "" ) & IF ( over, "over budget; ", "" ) & IF ( kiosk && NOT app, "kiosks need the booking app; ", "" ) RETURN IF ( issues = "", "Plan valid: " & n & " projects, " & g & " growth, within budget, dependencies met", "Not yet valid: " & issues )
		formatString: @
		displayFolder: 04 Plan builder
		lineageTag: f384d754-5497-5c09-89d2-48c2cc0618b2

	/// Rooms added by the selected projects.
	measure 'Rooms Added' = SUM ( InvestmentProjects[AddedRooms] )
		formatString: #,0
		displayFolder: 04 Plan builder
		lineageTag: 93f013e1-4ae4-50d2-b8e6-376298b4e73e

	/// Rooms in the hotels touched by selected renovation projects.
	measure 'Rooms Refreshed' = CALCULATE ( SUM ( Hotels[Rooms] ), CROSSFILTER ( InvestmentProjectProperties[HotelID], Hotels[HotelID], BOTH ), InvestmentProjects[Category] = "Renovation" )
		formatString: #,0
		displayFolder: 04 Plan builder
		lineageTag: 20a23206-dd88-5cbc-937d-24802b1949f6

	/// Hotels receiving self check-in kiosks when GI-02 is selected.
	measure 'Kiosk Desks' = CALCULATE ( COUNTROWS ( InvestmentProjectProperties ), InvestmentProjects[ProjectID] = "GI-02" )
		formatString: #,0
		displayFolder: 04 Plan builder
		lineageTag: 476616dd-f7d6-5e9c-87ff-1d3e6186ab32

	/// Longest works period with rooms out of service in the selection.
	measure 'Disruption Months' = MAXX ( FILTER ( InvestmentProjects, InvestmentProjects[RoomsOutOfServicePct] > 0 ), InvestmentProjects[DurationMonths] )
		formatString: 0
		displayFolder: 04 Plan builder
		lineageTag: fc6b05cb-e116-503c-a5b7-a86c4fbbca25

	/// Earliest start of the project in context.
	measure 'Start (text)' = FORMAT ( MIN ( InvestmentProjects[EarliestStart] ), "mmm yyyy" )
		formatString: @
		displayFolder: 04 Plan builder
		lineageTag: 9dbfb661-a208-5fe5-94d4-6abcdbe870e8

	/// Go-live month of the project in context.
	measure 'Live (text)' = FORMAT ( MIN ( InvestmentProjects[Completion Date] ), "mmm yyyy" )
		formatString: @
		displayFolder: 04 Plan builder
		lineageTag: 907975e2-b3ed-5f78-9167-c765071b3929

	/// Hotels mapped to the project in context.
	measure 'Hotels Touched' = DISTINCTCOUNT ( InvestmentProjectProperties[HotelID] )
		formatString: #,0
		displayFolder: 04 Plan builder
		lineageTag: e245eb25-e3d2-54c6-ab7e-277528527057

	/// Scenario chosen in the toggle; Expected when nothing is selected.
	measure 'Selected Scenario' = SELECTEDVALUE ( Scenario[Scenario], "Expected" )
		formatString: @
		displayFolder: 04 Plan builder
		lineageTag: a667d7ba-5113-5697-b333-732f2553aa79

	/// Capex spread evenly over each project's duration (FinanceParameters rule).
	measure 'Capex Phased' = VAR s = [Selected Scenario] RETURN CALCULATE ( SUM ( ProjectCashflow[Capex] ), ProjectCashflow[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 440cd6f5-1702-5253-b7fb-c15628431eaf

	/// Revenue lost from rooms out of service during works, no cost relief (conservative).
	measure Disruption = VAR s = [Selected Scenario] RETURN CALCULATE ( SUM ( ProjectCashflow[Disruption] ), ProjectCashflow[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 85e3fc0f-1b5c-5304-a872-7cdef0868843

	/// Annual operating-profit impact per month after go-live, ramped 50 / 85 / 100 percent per FinanceParameters.
	measure 'Benefit (ramped)' = VAR s = [Selected Scenario] RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ), ProjectCashflow[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: d59933f7-7abb-5a4c-a741-4a67e1c0eae7

	/// Benefit at the Low scenario regardless of the toggle.
	measure 'Benefit (ramped, Low)' = VAR s = "Low" RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ), ProjectCashflow[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 2d428f3b-a3ab-5ee2-a6e4-3d430285ceed

	/// Benefit at the High scenario regardless of the toggle.
	measure 'Benefit (ramped, High)' = VAR s = "High" RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ), ProjectCashflow[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: f72018de-ce8d-5c87-b300-3b05c2407724

	/// Benefit minus capex minus disruption, in 2025 dollars.
	measure 'Net Impact' = [Benefit (ramped)] - [Capex Phased] - [Disruption]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 634c3de2-8a15-54dc-89c7-9f5b523f376a

	/// Operating-profit effect only (capex is cash, not profit).
	measure 'OP Impact' = [Benefit (ramped)] - [Disruption]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 8d708e5c-957e-5974-864f-ca9af69a65c6

	/// Operating-profit effect at the Low scenario.
	measure 'OP Impact (Low)' = [Benefit (ramped, Low)] - [Disruption]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: e29083ea-439d-5a68-9401-c077c7c91a9a

	/// Net impact at the Low scenario.
	measure 'Net Impact (Low)' = VAR s = "Low" RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), ProjectCashflow[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 7b73f8a8-1b11-5a3d-9a68-3cf69ae852d1

	/// Operating-profit effect at the High scenario.
	measure 'OP Impact (High)' = [Benefit (ramped, High)] - [Disruption]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 1fc0f844-1608-538e-88f0-40c2794a40cf

	/// Net impact at the High scenario.
	measure 'Net Impact (High)' = VAR s = "High" RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), ProjectCashflow[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 32b37e29-95d8-55fa-96f7-57777f67df87

	/// Net impact accumulated from January 2027 to the end of the period in context.
	measure 'Cumulative Net Impact' = VAR d = MAX ( 'Date'[Date] ) RETURN CALCULATE ( [Net Impact], REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= d )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 3e3aa1ee-1b24-572a-9a5b-bc542ece51fd

	/// Cumulative net impact at the Low scenario.
	measure 'Cumulative Net Impact (Low)' = VAR d = MAX ( 'Date'[Date] ) RETURN CALCULATE ( [Net Impact (Low)], REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= d )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 9c9bcde6-f81e-5b41-a520-0bdeb5049d17

	/// Cumulative net impact at the High scenario.
	measure 'Cumulative Net Impact (High)' = VAR d = MAX ( 'Date'[Date] ) RETURN CALCULATE ( [Net Impact (High)], REMOVEFILTERS ( 'Date' ), 'Date'[Date] <= d )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: bde6ce3d-9c8f-50c7-90d0-597390e98fd6

	/// Full annual operating-profit impact of the selection once ramped (every project is at 100 percent by 2032).
	measure '2032 Run-rate' = VAR s = [Selected Scenario] RETURN CALCULATE ( SUM ( InvestmentScenarios[AnnualOperatingProfitImpactUSD] ), InvestmentScenarios[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 6ff79109-49fe-5ba6-892f-e12f3569b0b2

	/// Run-rate at the Low scenario.
	measure '2032 Run-rate (Low)' = CALCULATE ( SUM ( InvestmentScenarios[AnnualOperatingProfitImpactUSD] ), InvestmentScenarios[Scenario] = "Low" )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 220e71d6-a59e-5fdc-8435-a28478390a63

	/// Run-rate at the High scenario.
	measure '2032 Run-rate (High)' = CALCULATE ( SUM ( InvestmentScenarios[AnnualOperatingProfitImpactUSD] ), InvestmentScenarios[Scenario] = "High" )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 37430e6e-c73f-5b56-9b34-2079d5b657c3

	/// Run-rate relative to 2025 gross operating profit.
	measure 'Run-rate % of 2025 GOP' = DIVIDE ( [2032 Run-rate], [GOP 2025] )
		formatString: 0.0%
		displayFolder: 05 Impact
		lineageTag: c67cacb6-7202-52d4-9be0-8bc88fc6dba0

	/// Net impact through 2032 discounted monthly at the FinanceParameters rate to January 2027 (the close of the 2026 planning year), no terminal value (convention of 04-p2-build-method.md).
	measure 'NPV @ 8%' = VAR s = [Selected Scenario] RETURN CALCULATE ( SUMX ( FILTER ( ProjectCashflow, ProjectCashflow[Scenario] = s ), ( ProjectCashflow[Benefit] - ProjectCashflow[Capex] - ProjectCashflow[Disruption] ) * ProjectCashflow[DiscountFactor] ), REMOVEFILTERS ( 'Date' ) )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: fc5fb743-e30c-5399-ad34-115471b592a1

	/// First year the cumulative net impact turns positive; blank when after 2032.
	measure 'Payback Year' = VAR t = ADDCOLUMNS ( FILTER ( ALL ( 'Date'[Year] ), 'Date'[Year] >= 2027 ), "@cum", VAR y = 'Date'[Year] RETURN CALCULATE ( [Net Impact], REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y ) ) RETURN MINX ( FILTER ( t, [@cum] >= 0 ), 'Date'[Year] )
		formatString: 0
		displayFolder: 05 Impact
		lineageTag: 8b5280b9-86d2-58dd-b7d1-31d46bab6388

	/// Payback year as text, with the horizon trap spelled out.
	measure 'Payback (text)' = IF ( ISBLANK ( [Payback Year] ), "after 2032", FORMAT ( [Payback Year], "0" ) )
		formatString: @
		displayFolder: 05 Impact
		lineageTag: b8c585db-c8e9-5928-86cd-90ac0e164910

	/// Rooms available in the do-nothing projection (2025 capacity held).
	measure 'Baseline Rooms Available' = SUM ( HotelOutlook[RoomsAvailable] )
		formatString: #,0
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 53f968a1-4a98-564f-bf59-1058ed1972cd

	/// Room nights the market would fill, 2025 sold nights grown by regional demand (scenario logic).
	measure 'Baseline Demand Room Nights' = SUM ( HotelOutlook[DemandRoomNights] )
		formatString: #,0
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 2eb155e8-64f7-5b49-a18c-e0e52b0e5778

	/// Demand capped at 97 percent occupancy (scenario logic).
	measure 'Baseline Rooms Sold' = SUM ( HotelOutlook[RoomsSold] )
		formatString: #,0
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 696a4d13-45a8-5f35-8b06-319b45b5be5a

	/// Do-nothing occupancy (scenario logic).
	measure 'Baseline Occupancy %' = DIVIDE ( [Baseline Rooms Sold], [Baseline Rooms Available] )
		formatString: 0.0%
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 561f617d-a3a2-5672-b371-f9ec19e04683

	/// Uncapped demand over available rooms; above 97 percent means rooms are turned away.
	measure 'Baseline Demand Occupancy %' = DIVIDE ( [Baseline Demand Room Nights], [Baseline Rooms Available] )
		formatString: 0.0%
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: aadd6791-1870-5258-a06e-7e8be617581d

	/// The occupancy ceiling used by the baseline (highest observed).
	measure 'Capacity Cap %' = 0.97
		formatString: 0.0%
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: ceef3cf7-ea32-5126-9893-0f211a38ba67

	/// Demand turned away by the capacity cap.
	measure 'Unmet Room Nights' = [Baseline Demand Room Nights] - [Baseline Rooms Sold]
		formatString: #,0
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 051c194f-aea7-5f2c-bd90-abb791c25d03

	/// Do-nothing revenue: 2025 revenue per occupied room grown by ADR inflation (scenario logic).
	measure 'Baseline Revenue' = SUM ( HotelOutlook[Revenue] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 69a921d6-e4fb-53df-9340-245ad8a72114

	/// Do-nothing opex: 2025 cost per occupied room grown by cost inflation (scenario logic).
	measure 'Baseline Opex' = SUM ( HotelOutlook[Opex] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 77b190d9-b6c4-5cf7-9bab-6fb4ecf526cb

	/// Do-nothing gross operating profit (scenario logic).
	measure 'Baseline GOP' = [Baseline Revenue] - [Baseline Opex]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 029591af-a941-5363-b605-e2e4477f30e1

	/// Do-nothing margin (scenario logic).
	measure 'Baseline GOP Margin %' = DIVIDE ( [Baseline GOP], [Baseline Revenue] )
		formatString: 0.0%
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 93fc55a1-58d4-526c-961b-5ab2eaffc05a

	/// First year the hotel in context runs out of rooms (scenario logic).
	measure 'First Capped Year' = MIN ( HotelOutlook[FirstCappedYear] )
		formatString: 0
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 1151104a-b2b2-51f9-93bd-091a38665ba3

	/// Actual GOP margin on the 2021-2032 timeline axis (blank after 2025).
	measure 'Margin Actual (timeline)' = CALCULATE ( [GOP Margin %], TREATAS ( VALUES ( Timeline[Year] ), 'Date'[Year] ) )
		formatString: 0.0%
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: a5b4942b-3d8a-50b8-b34f-2c662c7be205

	/// Do-nothing margin on the timeline axis, 2025 onward (scenario logic).
	measure 'Margin Baseline (timeline)' = CALCULATE ( [Baseline GOP Margin %], TREATAS ( VALUES ( Timeline[Year] ), HotelOutlook[Year] ) )
		formatString: 0.0%
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 039decd2-aada-5aca-ab75-5ab9152ac52d

	/// Do-nothing GOP on the timeline axis (scenario logic).
	measure 'GOP Baseline (timeline)' = CALCULATE ( [Baseline GOP], TREATAS ( VALUES ( Timeline[Year] ), HotelOutlook[Year] ) )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 4d1a22c0-5fea-585e-8eb5-c75e6c5d3a86

	/// Baseline GOP plus the selected plan's operating-profit effect (scenario logic).
	measure 'GOP Plan (timeline)' = [GOP Baseline (timeline)] + CALCULATE ( [OP Impact], TREATAS ( VALUES ( Timeline[Year] ), 'Date'[Year] ) )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 4dba8651-ae03-55b6-a294-1237bc601a89

	/// Plan GOP at the Low scenario.
	measure 'GOP Plan (timeline, Low)' = [GOP Baseline (timeline)] + CALCULATE ( [OP Impact (Low)], TREATAS ( VALUES ( Timeline[Year] ), 'Date'[Year] ) )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 6660cc4a-3387-57c1-a788-610b8a0459a1

	/// Plan GOP at the High scenario.
	measure 'GOP Plan (timeline, High)' = [GOP Baseline (timeline)] + CALCULATE ( [OP Impact (High)], TREATAS ( VALUES ( Timeline[Year] ), 'Date'[Year] ) )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 06 Outlook (scenario logic)
		lineageTag: 7c65dfc7-56fe-514c-b9db-45bf995dcffa

	/// One value per bridge step: the 2024 to 2025 GOP bridge (actuals) and the 2025 to 2032 baseline bridge (scenario logic).
	measure 'Bridge Value' = VAR s = SELECTEDVALUE ( BridgeStep[Step] ) VAR sold24 = CALCULATE ( [Rooms Sold], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ) VAR sold25 = CALCULATE ( [Rooms Sold], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR rev24 = CALCULATE ( [Total Revenue], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ) VAR rev25 = CALCULATE ( [Total Revenue], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR volume = ( sold25 - sold24 ) * DIVIDE ( rev24, sold24 ) VAR rate = rev25 - rev24 - volume VAR bsold25 = CALCULATE ( [Baseline Rooms Sold], HotelOutlook[Year] = 2025 ) VAR bsold32 = CALCULATE ( [Baseline Rooms Sold], HotelOutlook[Year] = 2032 ) VAR brev25 = CALCULATE ( [Baseline Revenue], HotelOutlook[Year] = 2025 ) VAR brev32 = CALCULATE ( [Baseline Revenue], HotelOutlook[Year] = 2032 ) VAR bopex25 = CALCULATE ( [Baseline Opex], HotelOutlook[Year] = 2025 ) VAR bopex32 = CALCULATE ( [Baseline Opex], HotelOutlook[Year] = 2032 ) VAR revpor = DIVIDE ( brev25, bsold25 ) VAR cpor = DIVIDE ( bopex25, bsold25 ) RETURN SWITCH ( s, "GOP 2024", CALCULATE ( [GOP], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ), "Volume", volume, "Rate", rate, "Staff", - ( CALCULATE ( SUM ( MonthlyPerformance[StaffCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) - CALCULATE ( SUM ( MonthlyPerformance[StaffCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ) ), "Energy", - ( CALCULATE ( SUM ( MonthlyPerformance[EnergyCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) - CALCULATE ( SUM ( MonthlyPerformance[EnergyCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ) ), "Maintenance", - ( CALCULATE ( SUM ( MonthlyPerformance[MaintenanceCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) - CALCULATE ( SUM ( MonthlyPerformance[MaintenanceCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ) ), "Food and beverage cost", - ( CALCULATE ( SUM ( MonthlyPerformance[FoodBeverageCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) - CALCULATE ( SUM ( MonthlyPerformance[FoodBeverageCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ) ), "Other cost", - ( CALCULATE ( SUM ( MonthlyPerformance[OtherOperatingCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) - CALCULATE ( SUM ( MonthlyPerformance[OtherOperatingCost] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2024 ) ), "GOP 2025 (baseline)", brev25 - bopex25, "Volume the market gives", ( bsold32 - bsold25 ) * ( revpor - cpor ), "Price inflation", brev32 - bsold32 * revpor, "Cost inflation", - ( bopex32 - bsold32 * cpor ) )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 07 Display
		lineageTag: 7df0bd39-fe6e-566c-be81-d903e4431d9a

	/// The folio: a 2025 OTA room night, what the channel takes and what the hotel keeps.
	measure 'Folio OTA Guest' = VAR line = SELECTEDVALUE ( FolioLine[Line] ) VAR rate = CALCULATE ( DIVIDE ( [Channel Room Revenue], [Channel Room Nights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ) VAR comm = CALCULATE ( DIVIDE ( [Distribution Cost], [Channel Room Nights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ) RETURN SWITCH ( line, "Room night, average rate", rate, "Paid to the channel", - comm, "What we keep", rate - comm )
		formatString: \$#,0.00;(\$#,0.00)
		displayFolder: 07 Display
		lineageTag: 5941f4d7-1478-5c1b-809f-4f91b4a440a4

	/// The folio: the same room night booked on the brand's own site or app.
	measure 'Folio Direct Guest' = VAR line = SELECTEDVALUE ( FolioLine[Line] ) VAR rate = CALCULATE ( DIVIDE ( [Channel Room Revenue], [Channel Room Nights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ) VAR comm = CALCULATE ( DIVIDE ( [Distribution Cost], [Channel Room Nights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ) RETURN SWITCH ( line, "Room night, average rate", rate, "Paid to the channel", - comm, "What we keep", rate - comm )
		formatString: \$#,0.00;(\$#,0.00)
		displayFolder: 07 Display
		lineageTag: 35259f79-1541-5b72-bfdb-0c160fee599a

	/// Sister-brand margins after distribution in 2025, for the benchmark note.
	measure 'Benchmark after Distribution (text)' = CONCATENATEX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), Brands[Brand] & " " & FORMAT ( CALCULATE ( [GOP Margin after Distribution % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), TREATAS ( { Brands[Brand] }, Hotels[Brand] ) ), "0.0%" ), ", ", Brands[Brand] )
		formatString: @
		displayFolder: 07 Display
		lineageTag: e7447d36-b936-5d69-ad5a-e48a0508f28a

	/// Sister-brand GOP margins before distribution in 2025.
	measure 'Benchmark before Distribution (text)' = CONCATENATEX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), Brands[Brand] & " " & FORMAT ( CALCULATE ( [GOP Margin % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), TREATAS ( { Brands[Brand] }, Hotels[Brand] ) ), "0.0%" ), ", ", Brands[Brand] )
		formatString: @
		displayFolder: 07 Display
		lineageTag: 92aea387-b62d-5690-9067-4822ab52627e

	/// KPI delta line.
	measure 'Occupancy vs 2024 (text)' = FORMAT ( ( [Occupancy % 2025] - [Occupancy % 2024] ) * 100, "+0.0;-0.0;0.0" ) & " pt vs 2024"
		formatString: @
		displayFolder: 07 Display
		lineageTag: 938a740d-6615-54b7-8c05-84cb61dc2f42

	/// KPI delta line.
	measure 'RevPAR vs 2024 (text)' = FORMAT ( DIVIDE ( [RevPAR 2025], [RevPAR 2024] ) - 1, "+0.0%;-0.0%;0.0%" ) & " vs 2024"
		formatString: @
		displayFolder: 07 Display
		lineageTag: 4b188063-f95e-50b5-8463-49cec2b03bc2

	/// KPI delta line.
	measure 'GOP Margin vs 2023 (text)' = FORMAT ( ( [GOP Margin % 2025] - [GOP Margin % 2023] ) * 100, "+0.0;-0.0;0.0" ) & " pt vs 2023, " & FORMAT ( [GOP Margin after Distribution % 2025], "0.0%" ) & " after commissions"
		formatString: @
		displayFolder: 07 Display
		lineageTag: e2ac5ff0-f885-5467-b3dd-1b009fe00b6e

	/// KPI delta line.
	measure 'NPS vs 2021 (text)' = FORMAT ( [NPS (weighted) 2025] - [NPS (weighted) 2021], "+0.0;-0.0;0.0" ) & " vs 2021"
		formatString: @
		displayFolder: 07 Display
		lineageTag: 8623bd07-f45b-5d78-8bea-de8308f73530

	/// The $ at the 2021 mix callout.
	measure 'Counterfactual (text)' = FORMAT ( [Distribution Cost above 2021 Mix 2025] / 1000000, "$0.0" ) & " M a year above the 2021 channel mix, at today's rates per channel (counterfactual)"
		formatString: @
		displayFolder: 07 Display
		lineageTag: 313cffdd-4f74-5ce0-83a9-034086489f07

	/// Dynamic page-2 headline from the selection.
	measure 'Headline Plan (text)' = FORMAT ( [Capex Selected] / 1000000, "$0.0" ) & " M of " & FORMAT ( [Budget] / 1000000, "$0" ) & " M on " & [Projects Selected] & " projects: " & FORMAT ( [2032 Run-rate] / 1000000, "+$0.0;-$0.0" ) & " M a year of operating profit by 2032 (" & [Selected Scenario] & ")"
		formatString: @
		displayFolder: 07 Display
		lineageTag: ec071969-e324-5ea9-86e5-8a081f75ba04

	/// Dynamic headline for the wall: counts of Full and Tired hotels.
	measure 'Headline Wall (text)' = VAR full = COUNTROWS ( FILTER ( VALUES ( Hotels[HotelID] ), [Hotel Status 2025] = "Full" ) ) VAR tired = COUNTROWS ( FILTER ( VALUES ( Hotels[HotelID] ), [Hotel Status 2025] = "Tired" ) ) RETURN full & " are full. " & tired & " are tired."
		formatString: @
		displayFolder: 07 Display
		lineageTag: 9bd6dd6f-ed95-54ce-a063-37932f40221c

	/// The wall: lit once the project is live in the chosen year, planned before that, blank when the hotel is not touched.
	measure 'Wall Light' = VAR y = SELECTEDVALUE ( PlanYear[Year], 2032 ) VAR n = COUNTROWS ( InvestmentProjectProperties ) VAR done = MAXX ( InvestmentProjects, YEAR ( InvestmentProjects[Completion Date] ) ) RETURN IF ( n > 0, IF ( done <= y, "lit", "planned" ) )
		formatString: @
		displayFolder: 07 Display
		lineageTag: fbad4479-2470-59c3-8a1e-d02272b21dff

	/// Capacity wall label per hotel.
	measure 'Capacity (text)' = VAR y = [First Capped Year] RETURN IF ( ISBLANK ( [Baseline Rooms Available] ), BLANK (), IF ( ISBLANK ( y ), "room to grow", "full in " & y ) )
		formatString: @
		displayFolder: 07 Display
		lineageTag: a3848b7f-4745-5d28-9446-132077b1237b

	/// Value-for-money score weighted by responses.
	measure 'Value for Money (weighted)' = DIVIDE ( SUMX ( GuestExperience, GuestExperience[ValueForMoneyScore] * GuestExperience[SurveyResponses] ), [Survey Responses] )
		formatString: 0.00
		displayFolder: 03 Guest
		lineageTag: 6c127664-6d10-58dd-89f4-d2973887e1b0

	/// Room-condition complaints per thousand room nights sold.
	measure 'Room Condition Complaints per 1k' = DIVIDE ( CALCULATE ( [Complaints], GuestComplaints[Category] = "Room condition" ), [Rooms Sold] ) * 1000
		formatString: 0.00
		displayFolder: 03 Guest
		lineageTag: a7439762-a5a7-5102-8740-03d9f6102ebf

	/// The comparison line in context (KpiLine[Key]) as a number; formatting comes from KpiLine[Format] in the text measures.
	measure 'KPI Value' = VAR k = SELECTEDVALUE ( KpiLine[Key] ) RETURN SWITCH ( k, "occ", [Occupancy %], "adr", [ADR], "revpar", [RevPAR], "gop", [GOP Margin %], "gopa", [GOP Margin after Distribution %], "ota", [OTA Share %], "direct", [Direct Share %], "dist", [Distribution Cost % of Room Revenue], "nps", [NPS (weighted)], "comfort", [Room Comfort (weighted)], "value", [Value for Money (weighted)], "compl", [Complaints per 1k Room Nights], "roomcond", [Room Condition Complaints per 1k] )
		formatString: 0.0000
		displayFolder: 08 Brand comparison
		lineageTag: 57bd2a1f-b495-5030-a534-af8b75768522

	/// The comparison line in calendar 2023.
	measure 'KPI 2023' = CALCULATE ( [KPI Value], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 )
		formatString: 0.0000
		displayFolder: 08 Brand comparison
		lineageTag: 341d0d30-e501-5edd-8b80-f05777c73b54

	/// The comparison line in calendar 2025.
	measure 'KPI 2025' = CALCULATE ( [KPI Value], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0000
		displayFolder: 08 Brand comparison
		lineageTag: ba79be31-e6ce-533a-9829-7ffbbae14311

	/// Goodnight Inn, comparison line, 2025.
	measure 'KPI GI 2025' = CALCULATE ( [KPI 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0000
		displayFolder: 08 Brand comparison
		lineageTag: a73012b2-918b-5495-8164-3eb321ce0615

	/// Goodnight Inn: the 2025 value as formatted text for the comparison table.
	measure 'KPI Text GI' = VAR v = [KPI GI 2025] RETURN IF ( ISBLANK ( v ), BLANK (), FORMAT ( v, SELECTEDVALUE ( KpiLine[Format] ) ) )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 457e2591-d0cf-5d4d-8ec4-e7d47bcafff4

	/// P&K Select, comparison line, 2025.
	measure 'KPI PS 2025' = CALCULATE ( [KPI 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "P&K Select" )
		formatString: 0.0000
		displayFolder: 08 Brand comparison
		lineageTag: c6fe6115-cb8e-54d7-980d-509d6944b5e9

	/// P&K Select: the 2025 value as formatted text for the comparison table.
	measure 'KPI Text PS' = VAR v = [KPI PS 2025] RETURN IF ( ISBLANK ( v ), BLANK (), FORMAT ( v, SELECTEDVALUE ( KpiLine[Format] ) ) )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: dd902c26-1c61-5f6f-86c3-cc379c93f15b

	/// Maison d'Or, comparison line, 2025.
	measure 'KPI MO 2025' = CALCULATE ( [KPI 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Maison d'Or" )
		formatString: 0.0000
		displayFolder: 08 Brand comparison
		lineageTag: c28590e8-e24d-5b0d-9175-8e82db81d30b

	/// Maison d'Or: the 2025 value as formatted text for the comparison table.
	measure 'KPI Text MO' = VAR v = [KPI MO 2025] RETURN IF ( ISBLANK ( v ), BLANK (), FORMAT ( v, SELECTEDVALUE ( KpiLine[Format] ) ) )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: b24c71e6-60e5-51e3-96d8-6bdb53b243e8

	/// Pebble & Pine, comparison line, 2025.
	measure 'KPI PP 2025' = CALCULATE ( [KPI 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Pebble & Pine" )
		formatString: 0.0000
		displayFolder: 08 Brand comparison
		lineageTag: 24a7ffe2-96ad-54d0-a5b1-56ae727ba356

	/// Pebble & Pine: the 2025 value as formatted text for the comparison table.
	measure 'KPI Text PP' = VAR v = [KPI PP 2025] RETURN IF ( ISBLANK ( v ), BLANK (), FORMAT ( v, SELECTEDVALUE ( KpiLine[Format] ) ) )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 96d4db1b-1c59-5b72-b90e-0153246ac24e

	/// Goodnight Inn, comparison line, 2023 (2021 is a depressed base year).
	measure 'KPI GI 2023' = CALCULATE ( [KPI 2023], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0000
		displayFolder: 08 Brand comparison
		lineageTag: 6599d94b-5554-5afd-8b6e-e232b0380498

	/// Goodnight Inn's rank among the four brands in the line's good direction (1 = best); blank for segment measures that are not ranked.
	measure 'KPI Rank' = VAR dir = SELECTEDVALUE ( KpiLine[Direction] ) VAR gn = [KPI GI 2025] VAR better = COUNTROWS ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), VAR b = Brands[Brand] RETURN dir * CALCULATE ( [KPI 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b ) > dir * gn ) ) RETURN IF ( ISBLANK ( gn ) || dir = 0, BLANK (), better + 1 )
		formatString: 0
		displayFolder: 08 Brand comparison
		lineageTag: 1ecde652-543e-54f2-960a-e1511d5b45da

	/// Rank as words; the word carries the verdict, the color repeats it.
	measure 'KPI Rank (text)' = VAR r = [KPI Rank] VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR dir = SELECTEDVALUE ( KpiLine[Direction] ) RETURN IF ( ISBLANK ( SELECTEDVALUE ( KpiLine[Key] ) ), BLANK (), IF ( dir = 0, "not ranked", SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) ) )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 030b9b7c-61b0-57f4-ada8-d349aa4bc4eb

	/// Harbour blue for best, Ember for last, plum-grey otherwise (field-value font color).
	measure 'KPI Rank Color' = VAR r = [KPI Rank] VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) RETURN SWITCH ( TRUE (), ISBLANK ( r ), "#5B5163", r = 1, "#1D5FA8", r = n, "#B45309", "#5B5163" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: f587cfea-8c0c-5165-82f1-9f28207b2274

	/// Goodnight Inn's change 2023 to 2025 in the line's unit (points for percentages).
	measure 'KPI Change since 2023 (text)' = VAR d = [KPI GI 2025] - [KPI GI 2023] VAR s = SELECTEDVALUE ( KpiLine[DeltaScale] ) VAR u = SELECTEDVALUE ( KpiLine[DeltaUnit] ) RETURN IF ( ISBLANK ( d ), BLANK (), IF ( d < 0, UNICHAR ( 8722 ), "+" ) & IF ( u = "$", "$", "" ) & FORMAT ( ABS ( d ) * s, SELECTEDVALUE ( KpiLine[DeltaFormat] ) ) & IF ( u = "pt", " pt", "" ) )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 41d89a91-5304-586b-bf0f-e0df0b334688

	/// Direction-aware color of the change: good when it moved the right way.
	measure 'KPI Change Color' = VAR d = ( [KPI GI 2025] - [KPI GI 2023] ) * SELECTEDVALUE ( KpiLine[Direction] ) RETURN SWITCH ( TRUE (), ISBLANK ( d ) || d = 0, "#5B5163", d > 0, "#1D5FA8", "#B45309" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 60b0517c-5d30-5f08-bb40-143d396a6089

	/// Geography matrix cell: 2025 occupancy and the number of hotels.
	measure 'Occupancy and Hotels (text)' = VAR o = [Occupancy % 2025] RETURN IF ( ISBLANK ( o ), BLANK (), FORMAT ( o, "0.0%" ) & " · " & [Hotels in Context] )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 1c05ee6e-d7da-52e2-b32c-7698e7560677

	/// Three-step tint for the geography matrix: 85 percent and over, 80 percent and over, below.
	measure 'Occupancy Heat Color' = VAR o = [Occupancy % 2025] RETURN SWITCH ( TRUE (), ISBLANK ( o ), "#FFFFFF", o >= 0.85, "#EE9DBA", o >= 0.80, "#F8D7E3", "#FFFFFF" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: ff20b2e3-1975-5d3d-84b7-7543b2ce66fb

	/// Raspberry tint behind the Goodnight Inn column of the comparison table (field value, so no literal hex in the visual).
	measure 'GN Column Tint' = "#F8D7E3"
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: ce3dc59c-4203-5fe9-b8a9-c66fdb21e6c5

	/// Raspberry for airport hotels, plum-slate for the rest.
	measure 'Hotel Bar Color' = IF ( SELECTEDVALUE ( Hotels[LocationType] ) = "Airport", "#B5175F", "#82798A" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 785218b4-13c5-556c-b7d6-dd9806039f09

	/// Goodnight Inn: GOP Margin after Distribution % on the trend axis.
	measure 'Trend Margin after GI' = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 09da73de-a1a6-549d-93c5-9b2340915f6c

	/// P&K Select: GOP Margin after Distribution % on the trend axis.
	measure 'Trend Margin after PS' = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "P&K Select" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 8b0e83b4-1c09-5f59-b969-16370cdceb63

	/// Maison d'Or: GOP Margin after Distribution % on the trend axis.
	measure 'Trend Margin after MO' = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Maison d'Or" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 86db0016-675e-5fcc-aa86-a416427b9f11

	/// Pebble & Pine: GOP Margin after Distribution % on the trend axis.
	measure 'Trend Margin after PP' = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Pebble & Pine" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 3a703394-77a5-54d8-8aef-15c53f8c528b

	/// Goodnight Inn: OTA Share % on the trend axis.
	measure 'Trend OTA GI' = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: b10685df-2ae9-5dff-a165-38e74765b1a8

	/// P&K Select: OTA Share % on the trend axis.
	measure 'Trend OTA PS' = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "P&K Select" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 3304f9a8-9883-547a-a330-37c5354a30b6

	/// Maison d'Or: OTA Share % on the trend axis.
	measure 'Trend OTA MO' = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Maison d'Or" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 1081600e-fd15-561b-94f0-4cba123bf647

	/// Pebble & Pine: OTA Share % on the trend axis.
	measure 'Trend OTA PP' = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Pebble & Pine" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: a2d6b3f8-ee2e-52fa-b9fe-81fa0bde56af

	/// Goodnight Inn: NPS (weighted) on the trend axis.
	measure 'Trend NPS GI' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: +0.0;-0.0;0.0
		displayFolder: 08 Brand comparison
		lineageTag: 5ae39c7b-1ad7-5dbe-a8da-def25c46f4b0

	/// P&K Select: NPS (weighted) on the trend axis.
	measure 'Trend NPS PS' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "P&K Select" )
		formatString: +0.0;-0.0;0.0
		displayFolder: 08 Brand comparison
		lineageTag: 8397d689-5d66-5d73-b318-eb44d603af9c

	/// Maison d'Or: NPS (weighted) on the trend axis.
	measure 'Trend NPS MO' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Maison d'Or" )
		formatString: +0.0;-0.0;0.0
		displayFolder: 08 Brand comparison
		lineageTag: 9a95c9f1-50c0-57c4-871f-08004cb4bf04

	/// Pebble & Pine: NPS (weighted) on the trend axis.
	measure 'Trend NPS PP' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Pebble & Pine" )
		formatString: +0.0;-0.0;0.0
		displayFolder: 08 Brand comparison
		lineageTag: fc8d51de-5e61-5cd5-a079-ca67c660dcbc

	/// Page-1 subtitle; the ranks it names are the KPI Rank values of the comparison table (verify on refresh).
	measure 'Subtitle P1 (text)' = VAR occ = CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) VAR gm = CALCULATE ( [GOP Margin % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) VAR ga = CALCULATE ( [GOP Margin after Distribution % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) VAR last = CALCULATE ( MAX ( Renovations[StartDate] ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) RETURN "Goodnight Inn fills the most rooms (" & FORMAT ( occ, "0.0%" ) & ") and keeps the widest margin before commissions (" & FORMAT ( gm, "0.0%" ) & "); after commissions it is second (" & FORMAT ( ga, "0.0%" ) & "), and on guests, channels and complaints it is last of four. The last renovation started in " & FORMAT ( last, "mmm yyyy" ) & "."
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: e069cb34-9f84-5053-b320-d476449f4410

	/// Geography card title.
	measure 'Geo Title (text)' = VAR a = CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", Hotels[LocationType] = "Airport" ) VAR h = CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", Hotels[LocationType] = "Highway" ) RETURN "F4 · The airports are the fullest: " & FORMAT ( a, "0.0%" ) & " occupancy, against " & FORMAT ( h, "0.0%" ) & " on the highway"
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: f9c86351-0f87-5a28-bca4-560d18c1d3cd

	/// Trend title, margin after commissions.
	measure 'Trend Title Margin (text)' = "F1 · After commissions the margin fell from " & FORMAT ( CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ), "0.0%" ) & " (2023) to " & FORMAT ( CALCULATE ( [GOP Margin after Distribution % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "0.0%" )
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 56696f02-e0c6-52eb-aa2b-07cb0d8059d1

	/// Trend title, OTA share.
	measure 'Trend Title OTA (text)' = "F2 · OTAs book " & FORMAT ( CALCULATE ( [OTA Share % 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "0.0%" ) & " of room revenue, up from " & FORMAT ( CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ), "0.0%" ) & " in 2021"
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 33595229-b477-57d9-81af-792f953115b6

	/// Trend title, NPS (the yearly fall is checked in 41_opzet_facts.py; re-check on refresh).
	measure 'Trend Title NPS (text)' = VAR n = CALCULATE ( [NPS (weighted) 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) RETURN "F3 · NPS fell every year, to " & IF ( n < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( n ), "0.0" ) & "; sister brands higher"
		formatString: @
		displayFolder: 08 Brand comparison
		lineageTag: 93d3ded8-1aa2-555d-9aaf-ef1d1d627057

	/// Capex of the package(s) in context.
	measure 'Package Capex' = SUM ( Package[CapexUSD] )
		formatString: \$#,0.0,,\M
		displayFolder: 09 Package matrix
		lineageTag: 305768c2-ca80-5ebd-8cc9-cffc083628f2

	/// Package NPV through 2032 in the selected scenario (scatter Y).
	measure 'Package NPV (sel)' = VAR s = [Selected Scenario] RETURN SWITCH ( s, "Low", SUM ( Package[NPV Low] ), "High", SUM ( Package[NPV High] ), SUM ( Package[NPV Expected] ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 8d5996a9-7e10-58b7-bc3c-2dd1ce3b9283

	/// Package operating-profit run-rate in 2032, selected scenario.
	measure 'Package Run-rate (sel)' = VAR s = [Selected Scenario] RETURN SWITCH ( s, "Low", SUM ( Package[RunRate Low] ), "High", SUM ( Package[RunRate High] ), SUM ( Package[RunRate Expected] ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: bcb320b0-8072-5bf2-a2fc-2ae56c42a979

	/// Shortlist rule A: the valid package with the highest NPV in the selected scenario.
	measure 'Preset A Package' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) RETURN MAXX ( TOPN ( 1, t, [@v], DESC ), Package[PackageID] )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: dd99764d-7e56-59b3-a7a2-ed937b518ae3

	/// Shortlist rule B: most hotels with a dataset guest-score effect among packages with NPV at least zero; ties by NPV. Blank when none qualifies (Low).
	measure 'Preset B Package' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) RETURN MAXX ( TOPN ( 1, FILTER ( t, [@v] >= 0 ), Package[HotelsRated], DESC, [@v], DESC ), Package[PackageID] )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 1c02b9ab-d86b-56fb-98c3-be0146a58a84

	/// Shortlist rule C: the highest-NPV package that includes the refresh of the ten oldest hotels.
	measure 'Preset C Package' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) RETURN MAXX ( TOPN ( 1, FILTER ( t, Package[ContainsRefresh] = "Yes" ), [@v], DESC ), Package[PackageID] )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: e83c21c8-4e0c-5bed-a7ee-f14f4e832df8

	/// The package in focus: a preset letter resolves through its rule in the selected scenario, a package id stands for itself. Default A, so the panel is never empty.
	measure 'Focus Package' = VAR k = SELECTEDVALUE ( PlanSelector[Key], "A" ) RETURN SWITCH ( k, "A", [Preset A Package], "B", [Preset B Package], "C", [Preset C Package], k )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: b5794ca9-42c3-54cc-aeb8-6a2b69c748e4

	/// 1 for the scatter point in focus.
	measure 'Focus Highlight' = IF ( SELECTEDVALUE ( Package[PackageID] ) = [Focus Package], 1, 0 )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 77b08ff6-956c-5929-a889-e5d448002e13

	/// Scatter color: raspberry in focus, plum without the refresh, lilac-grey with it (field value).
	measure 'Package Point Color' = SWITCH ( TRUE (), [Focus Highlight] = 1, "#B5175F", SELECTEDVALUE ( Package[ContainsRefresh] ) = "Yes", "#B8B0BE", "#3E2C55" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 88ed7370-015c-50b1-a96b-e3f6ab6a6b56

	/// Scatter size: the point in focus drawn larger.
	measure 'Package Point Size' = IF ( [Focus Highlight] = 1, 6, 1 )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 0196c53d-5938-5f6a-b575-f4f77acc7bc1

	/// Capex of the package in focus.
	measure 'Focus Capex' = VAR f = [Focus Package] RETURN CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: \$#,0.0,,\M
		displayFolder: 09 Package matrix
		lineageTag: bb50bec5-33fc-5185-a99a-d7532fbcccc6

	/// NPV through 2032 of the package in focus, selected scenario.
	measure 'Focus NPV (sel)' = VAR f = [Focus Package] RETURN CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: f5a3d202-f1ef-54ea-9762-1009f11e85d0

	/// NPV of the package in focus, Low scenario.
	measure 'Focus NPV Low' = VAR f = [Focus Package] RETURN CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 1f09d876-0a95-5669-b3dc-e01d0cd3a426

	/// NPV of the package in focus, High scenario.
	measure 'Focus NPV High' = VAR f = [Focus Package] RETURN CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: dfee4b57-6dd3-5e79-b3cb-727d7bcfb6bb

	/// 2032 run-rate of the package in focus.
	measure 'Focus Run-rate (sel)' = VAR f = [Focus Package] RETURN CALCULATE ( [Package Run-rate (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 48aa2409-8112-5837-a61f-b85e202222a2

	/// Initiatives in the package in focus.
	measure 'Focus Projects' = VAR f = [Focus Package] RETURN CALCULATE ( SUM ( Package[Projects] ), REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: c42630de-c2ca-5970-ad55-f5ccc73a08dc

	/// Growth initiatives in the package in focus.
	measure 'Focus Growth' = VAR f = [Focus Package] RETURN CALCULATE ( SUM ( Package[Growth] ), REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: 69ded2bd-addc-5d3b-a778-bc22582649df

	/// Rooms added by the package in focus.
	measure 'Focus Rooms Added' = VAR f = [Focus Package] RETURN CALCULATE ( SUM ( Package[RoomsAdded] ), REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: #,0
		displayFolder: 09 Package matrix
		lineageTag: 06d32e50-c2c0-5f28-8f06-e6933363a2c9

	/// Hotels touched by an initiative with a dataset guest-score effect (Expected), counted once.
	measure 'Focus Hotels Rated' = VAR f = [Focus Package] RETURN CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = f )
		formatString: #,0
		displayFolder: 09 Package matrix
		lineageTag: 439e7056-9905-58e5-a8fb-0ffc2f227846

	/// 1 for an initiative inside the package in focus (visual filter for the plan table).
	measure 'Focus Project Flag' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN IF ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ) IN ids, 1, 0 )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: ce2dac7a-6216-5ba0-808a-de7b5519f469

	/// NPV contribution per initiative in focus; at the total it sums to the package NPV (waterfall; reconciles with Package by construction).
	measure 'Focus Project NPV (sel)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN SUMX ( FILTER ( VALUES ( InvestmentProjects[ProjectID] ), InvestmentProjects[ProjectID] IN ids ), [NPV @ 8%] )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: f388ce1d-5179-55e6-b1d6-f145003f7902

	/// Capex per initiative in focus.
	measure 'Focus Project Capex' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN SUMX ( FILTER ( VALUES ( InvestmentProjects[ProjectID] ), InvestmentProjects[ProjectID] IN ids ), CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ) ) )
		formatString: \$#,0.0,,\M
		displayFolder: 09 Package matrix
		lineageTag: 851fdb26-e5f7-56a0-a200-76a586dd618c

	/// Organisers' annual operating-profit impact per initiative in focus (reached by 2032).
	measure 'Focus Project Run-rate (sel)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN SUMX ( FILTER ( VALUES ( InvestmentProjects[ProjectID] ), InvestmentProjects[ProjectID] IN ids ), [2032 Run-rate] )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 476f649f-38e2-5042-8db6-b7a14bbfafe7

	/// Go-live month per initiative in focus.
	measure 'Focus Project Live (text)' = IF ( [Focus Project Flag] = 1, [Live (text)] )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: c67e9d28-942b-597b-8724-531ef46cc71e

	/// Dataset guest-score effect in points on the touched hotels; per initiative, never summed, never shown as NPS.
	measure 'Focus Project Guest Effect (text)' = VAR p = SELECTEDVALUE ( InvestmentProjects[ProjectID] ) VAR s = [Selected Scenario] VAR pts = CALCULATE ( MAX ( InvestmentScenarios[SatisfactionChangePts] ), InvestmentScenarios[Scenario] = s ) RETURN IF ( [Focus Project Flag] = 1, IF ( pts > 0, "+" & FORMAT ( pts, "0.00" ) & " on " & [Hotels Touched], "·" ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 18d74fd7-7cf8-59d3-885a-c9f260a78b2d

	/// Cumulative net impact of the package in focus, undiscounted 2025 dollars, Low scenario.
	measure 'Focus Cumulative Net (Low)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR y = MAX ( 'Date'[Year] ) RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = "Low", TREATAS ( ids, ProjectCashflow[ProjectID] ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 4b5d2e90-2f5d-599b-9f8b-81396ff65151

	/// Cumulative net impact of the package in focus, undiscounted 2025 dollars, Expected scenario.
	measure 'Focus Cumulative Net (Expected)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR y = MAX ( 'Date'[Year] ) RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = "Expected", TREATAS ( ids, ProjectCashflow[ProjectID] ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 682865fc-9cdd-5054-a696-0f591fbff0de

	/// Cumulative net impact of the package in focus, undiscounted 2025 dollars, High scenario.
	measure 'Focus Cumulative Net (High)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR y = MAX ( 'Date'[Year] ) RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = "High", TREATAS ( ids, ProjectCashflow[ProjectID] ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 13c12ff8-63d6-5f55-a0d5-c2482210c819

	/// First year the cumulative net of the package in focus turns positive; blank when after 2032.
	measure 'Focus Payback Year' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( GENERATESERIES ( 2027, 2032, 1 ), "@c", VAR y = [Value] RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = s, TREATAS ( ids, ProjectCashflow[ProjectID] ) ) ) RETURN MINX ( FILTER ( t, [@c] >= 0 ), [Value] )
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: af2f5103-5401-57f4-be93-3f468b7bd54c

	/// Rooms in the hotels a renovation initiative in focus touches.
	measure 'Focus Rooms Refreshed' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR ren = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects ), InvestmentProjects[Category] = "Renovation" && InvestmentProjects[ProjectID] IN ids ), "@r", InvestmentProjects[ProjectID] ) VAR hs = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] IN ren ), "@h", InvestmentProjectProperties[HotelID] ) RETURN CALCULATE ( SUM ( Hotels[Rooms] ), REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( hs, Hotels[HotelID] ) ) + 0
		formatString: #,0
		displayFolder: 09 Package matrix
		lineageTag: 9ccfa151-102a-57ea-949a-b7b6ae1b06d2

	/// Month the last initiative in focus goes live.
	measure 'Focus Live By (text)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN FORMAT ( CALCULATE ( MAX ( InvestmentProjects[Completion Date] ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] IN ids ), "mmm yyyy" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: a2d724b3-a517-57e4-aadb-ffb810d976d6

	/// Preset A: capex.
	measure 'Preset A Capex' = VAR f = [Preset A Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: \$#,0.0,,\M
		displayFolder: 09 Package matrix
		lineageTag: 46a2e199-e497-5930-a283-413063b64ef2

	/// Preset A: npv (sel).
	measure 'Preset A NPV (sel)' = VAR f = [Preset A Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: cc2f33e5-27cb-513a-b477-eec63909c6b6

	/// Preset A: run-rate (sel).
	measure 'Preset A Run-rate (sel)' = VAR f = [Preset A Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package Run-rate (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: e0a39405-3720-5430-8a92-bd7fd70306da

	/// Preset A: NPV from the Low to the High scenario, $M.
	measure 'Preset A Range (text)' = VAR f = [Preset A Package] VAR lo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 VAR hi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 RETURN IF ( ISBLANK ( f ), BLANK (), IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ), "0.0" ) & " to " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ), "0.0" ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 80efeaa9-f4ab-5865-b54e-2a5c5a713c5c

	/// Preset A: package id and the initiatives in it.
	measure 'Preset A Mix (text)' = VAR f = [Preset A Package] RETURN IF ( ISBLANK ( f ), "No package qualifies in this case.", f & ": " & CONCATENATEX ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], PackageProject[ProjectID] ), " + ", PackageProject[ProjectID], ASC ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: ba09ed69-d467-530d-902e-d6a837e94de1

	/// Preset B: capex.
	measure 'Preset B Capex' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: \$#,0.0,,\M
		displayFolder: 09 Package matrix
		lineageTag: c8d9a4d9-adc7-5c61-a8ea-9436ec43fcce

	/// Preset B: npv (sel).
	measure 'Preset B NPV (sel)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 41d4b473-fa25-565e-b6e7-efed6d4ebeeb

	/// Preset B: run-rate (sel).
	measure 'Preset B Run-rate (sel)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package Run-rate (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 26da20e6-4560-5ee0-b680-5aa553d95ae4

	/// Preset B: NPV from the Low to the High scenario, $M.
	measure 'Preset B Range (text)' = VAR f = [Preset B Package] VAR lo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 VAR hi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 RETURN IF ( ISBLANK ( f ), BLANK (), IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ), "0.0" ) & " to " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ), "0.0" ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 193a67a3-4d23-5491-8068-bd35b896092b

	/// Preset B: package id and the initiatives in it.
	measure 'Preset B Mix (text)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), "No package qualifies in this case.", f & ": " & CONCATENATEX ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], PackageProject[ProjectID] ), " + ", PackageProject[ProjectID], ASC ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 6031ff2c-b863-5de9-a036-2a1efed24897

	/// Preset C: capex.
	measure 'Preset C Capex' = VAR f = [Preset C Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: \$#,0.0,,\M
		displayFolder: 09 Package matrix
		lineageTag: bd006f42-85de-5326-b9a3-76bcd6366dad

	/// Preset C: npv (sel).
	measure 'Preset C NPV (sel)' = VAR f = [Preset C Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: ebb5e682-9b2f-5595-b42b-4b01c95c231a

	/// Preset C: run-rate (sel).
	measure 'Preset C Run-rate (sel)' = VAR f = [Preset C Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package Run-rate (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: ec08316d-2515-5810-a471-47f61aca7091

	/// Preset C: NPV from the Low to the High scenario, $M.
	measure 'Preset C Range (text)' = VAR f = [Preset C Package] VAR lo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 VAR hi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 RETURN IF ( ISBLANK ( f ), BLANK (), IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ), "0.0" ) & " to " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ), "0.0" ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 561f1b9d-636c-5df5-971b-c4553045a300

	/// Preset C: package id and the initiatives in it.
	measure 'Preset C Mix (text)' = VAR f = [Preset C Package] RETURN IF ( ISBLANK ( f ), "No package qualifies in this case.", f & ": " & CONCATENATEX ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], PackageProject[ProjectID] ), " + ", PackageProject[ProjectID], ASC ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 8b77f91e-c87a-566d-b2b8-c8d9534972b6

	/// Page-2 subtitle bound to the package in focus and the scenario.
	measure 'Subtitle P2 (text)' = VAR f = [Focus Package] VAR s = [Selected Scenario] RETURN IF ( ISBLANK ( f ), "No package qualifies for this rule in the " & s & " case.", "In focus, package " & f & ": " & FORMAT ( [Focus Capex], "\$#,0.0,,\M" ) & " of the " & FORMAT ( [Budget], "\$#,0.0,,\M" ) & " budget on " & [Focus Projects] & " initiatives (" & [Focus Growth] & " growth). NPV through 2032 " & FORMAT ( [Focus NPV (sel)], "+\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M" ) & " (" & s & "; Low " & FORMAT ( [Focus NPV Low], "+\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M" ) & ", High " & FORMAT ( [Focus NPV High], "+\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M" ) & "); " & FORMAT ( [Focus Run-rate (sel)], "+\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M" ) & " a year of operating profit by 2032." )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 2db176a3-ef97-52f9-a12f-36e38557f148

	/// Scatter title: how many packages have NPV at least zero in the selected scenario.
	measure 'Scatter Title (text)' = VAR s = [Selected Scenario] VAR n = COUNTROWS ( ALLNOBLANKROW ( Package ) ) VAR pos = COUNTROWS ( FILTER ( ALLNOBLANKROW ( Package ), SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) >= 0 ) ) + 0 RETURN IF ( pos = 0, "None", FORMAT ( pos, "0" ) ) & " of " & n & " valid packages " & IF ( pos = 1, "is worth more than it costs", "are worth more than they cost" ) & " by December 2032 (" & s & " case)"
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 3366b508-0764-521c-bee2-1243025a51a2

	/// Shortlist state title.
	measure 'Shortlist Title (text)' = "Three packages, one per criterion (" & [Selected Scenario] & " case)"
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 8bd80225-553a-5ab4-827a-7b7aba1feb92

	/// Plan state title.
	measure 'Plan Title (text)' = VAR f = [Focus Package] RETURN IF ( ISBLANK ( f ), "No package in focus", f & " in focus: " & FORMAT ( [Focus Capex], "\$#,0.0,,\M" ) & " on " & [Focus Projects] & " initiatives, all live by " & [Focus Live By (text)] )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 5ef22c33-8a86-5aaa-98b0-3dabd5dbe9b9

	/// Plan state: the risks of the package in focus in one sentence.
	measure 'Plan Risk (text)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR ren = "GI-07" IN ids VAR pb = [Focus Payback Year] VAR oos = LOOKUPVALUE ( InvestmentProjects[RoomsOutOfServicePct], InvestmentProjects[ProjectID], "GI-07" ) VAR dur = LOOKUPVALUE ( InvestmentProjects[DurationMonths], InvestmentProjects[ProjectID], "GI-07" ) RETURN "Risks: " & IF ( ren, FORMAT ( oos, "0%" ) & " of " & FORMAT ( [Focus Rooms Refreshed], "#,0" ) & " rooms out of service for " & dur & " months; ", "" ) & "NPV in the Low case " & FORMAT ( [Focus NPV Low], "+\$#,0.0,,\M;−\$#,0.0,,\M;\$0.0\M" ) & "; the cumulative net turns positive " & IF ( ISBLANK ( pb ), "after 2032", "in " & pb ) & " (" & s & ")." & IF ( "GI-02" IN ids, " Kiosks wait for the app: they start when it goes live.", "" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 2fbfa611-f119-586b-b0f0-72e54f2a0a63

	/// Standing uncertainty line on the shortlist (the Low-case claim is checked in 40_package_matrix.py; re-check on refresh).
	measure 'Uncertainty (text)' = VAR rc = LOOKUPVALUE ( InvestmentProjects[AnnualRunningCostUSD], InvestmentProjects[ProjectID], "GI-01" ) RETURN "Read with care: no package is worth its cost by 2032 in the Low case, and nothing after 2032 is counted. Profit impacts are taken as net of running costs; read gross, the booking app earns " & FORMAT ( rc, "\$#,0.0,,\M" ) & " a year less."
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: b1c5ebaa-c24c-59b5-bdd8-103c51d2b19d

	column Placeholder
		dataType: string
		isHidden
		lineageTag: c4315546-1a37-5d10-81ae-2f137aeba1bf
		summarizeBy: none
		sourceColumn: Placeholder

	partition _Measures = m
		mode: import
		source =
				let
				    Source = #table({"Placeholder"}, {{"x"}})
				in
				    Source

	annotation PBI_ResultType = Table
