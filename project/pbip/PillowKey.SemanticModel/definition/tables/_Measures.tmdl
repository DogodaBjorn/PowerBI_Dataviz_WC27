	/// The hover signifier: a Tangerine ring with an i, 16 px, on every visual that opens a report-page tooltip; decorative, the footer hint names it.
	measure 'Info Badge SVG' = "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'>" & "<circle cx='8' cy='8' r='6.75' fill='none' stroke='%23E05A22' stroke-width='1.5'/><circle cx='8' cy='4.9' r='1.15' fill='%23E05A22'/><rect x='7.1' y='7' width='1.8' height='5' rx='0.9' fill='%23E05A22'/></svg>"
