	/// Value axis start of the build bar chart (the axis is hidden): the lowest picked NPV or zero, less the room the labels need.
	measure 'Build Bars X Start' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR t = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ), "@w", VAR p = [@p] RETURN LOOKUPVALUE ( BuildBar[Name Px], BuildBar[ProjectID], p ) ) VAR lo = MIN ( MINX ( t, [@v] ), 0 ) VAR hi = MAX ( MAXX ( t, [@v] ), 0 ) VAR lw = MIN ( 464 * 0.45, MAXX ( t, [@w] ) + 14 ) VAR d = IF ( hi - lo = 0, 1000000, hi - lo ) VAR room = d * 72 / ( 464 - lw - 2 * 72 ) RETURN IF ( n > 0, lo - room )
		formatString: 0
		displayFolder: 15 Storytelling rebuild
		lineageTag: c3c81574-3155-500f-968b-adc63c92602b

	/// Value axis end of the build bar chart (the axis is hidden): the highest picked NPV or zero, plus the room the labels need.
	measure 'Build Bars X End' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR t = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ), "@w", VAR p = [@p] RETURN LOOKUPVALUE ( BuildBar[Name Px], BuildBar[ProjectID], p ) ) VAR lo = MIN ( MINX ( t, [@v] ), 0 ) VAR hi = MAX ( MAXX ( t, [@v] ), 0 ) VAR lw = MIN ( 464 * 0.45, MAXX ( t, [@w] ) + 14 ) VAR d = IF ( hi - lo = 0, 1000000, hi - lo ) VAR room = d * 72 / ( 464 - lw - 2 * 72 ) RETURN IF ( n > 0, hi + room )
		formatString: 0
		displayFolder: 15 Storytelling rebuild
		lineageTag: 45a432bd-e455-59e1-b3b5-7e6cdca29a30

	/// F1 stacked area, the band on top of the margin after commissions: what the booking channels take, in points of revenue (margin before minus margin after commissions).
	measure 'Trend Commission Take GI' = [Trend Margin before GI] - [Trend Margin after GI]
