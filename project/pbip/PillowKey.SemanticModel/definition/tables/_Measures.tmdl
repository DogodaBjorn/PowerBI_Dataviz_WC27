	/// Year tooltip: the plan being built, cumulative net impact to the end of the hovered year, case in view; 'none yet' before a move is picked.
	measure 'TT Year Plan (text)' = IF ( [Build Count] = 0, "none yet", ( VAR __t = ROUND ( ( [Build Cumulative Net (sel)] ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) )
