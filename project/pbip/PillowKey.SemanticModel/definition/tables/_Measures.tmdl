	/// Preset B: run-rate (sel).
	measure 'Preset B Run-rate (sel)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package Run-rate (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
