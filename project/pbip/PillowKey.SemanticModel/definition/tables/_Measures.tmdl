	/// Cumulative net impact of the package in focus, undiscounted 2025 dollars, High scenario.
	measure 'Focus Cumulative Net (High)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR y = MAX ( 'Date'[Year] ) RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = "High", TREATAS ( ids, ProjectCashflow[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
