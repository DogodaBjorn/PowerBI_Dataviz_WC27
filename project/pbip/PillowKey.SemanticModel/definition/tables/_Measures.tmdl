		lineageTag: 13b95952-84ae-5020-9ac3-e2658b097f9d

	/// The A/B/C layer of the scatter read aloud: how many packages pay back, then A, B and C with capex and net present value in the case in view.
	measure 'Alt Scatter (text)' = [Scatter Title (text)] & " (" & [Selected Scenario] & " case). A, our recommendation: capex " & FORMAT ( ( [Preset A Capex] ) / 1000000, "$#,0.0#" ) & "M" & ", net present value " & ( VAR __t = ROUND ( ( [Preset A NPV (sel)] ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & ". B, the alternative: " & FORMAT ( ( [Preset B Capex] ) / 1000000, "$#,0.0#" ) & "M" & ", " & ( VAR __t = ROUND ( ( [Preset B NPV (sel)] ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & ". C, the answer to why not renovate: " & FORMAT ( ( [Preset C Capex] ) / 1000000, "$#,0.0#" ) & "M" & ", " & ( VAR __t = ROUND ( ( [Preset C NPV (sel)] ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 1c782b3e-b1ad-510b-9d6d-433e8ad14a8e

	/// The 456-dot layer read aloud: what its table holds (keyboard users reach the package details there, not in the hover card).
	measure 'Alt Scatter Cloud (text)' = "All " & COUNTROWS ( ALLNOBLANKROW ( Package ) ) & " possible packages, each with its capex, net present value through 2032 (" & [Selected Scenario] & " case), range, payback and initiatives. Show as table lists them."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: e4b38ddc-cd53-5a10-a03a-00b266122cdd

	/// The recommendation's numbers card read aloud.
	measure 'Alt Rec Nums (text)' = "Package A, " & [Selected Scenario] & " case: capex " & [Rec Capex (text)] & ", net present value through 2032 " & [Rec NPV (text)] & ", from " & [Rec Range (text)] & " $M between the Low and High cases, profit a year by 2032 " & [Rec Run-rate (text)] & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 977bdced-42ac-58aa-b9a6-55b5c6db9576

	/// The plan waterfall read aloud, in the chart's order (by name): each initiative's shown NPV and the package total.
	measure 'Alt Waterfall (text)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR base = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR tr = ROUND ( SUMX ( base, [@v] ) / 100000, 0 ) VAR fl = ADDCOLUMNS ( base, "@f", INT ( [@v] / 100000 ) ) VAR fr = ADDCOLUMNS ( fl, "@r", [@v] / 100000 - [@f] + VALUE ( RIGHT ( [@p], 2 ) ) * 0.000000001 ) VAR k = tr - SUMX ( fr, [@f] ) VAR adj = ADDCOLUMNS ( fr, "@s", ( [@f] + IF ( RANKX ( fr, [@r], , DESC ) <= k, 1, 0 ) ) * 100000 ) RETURN IF ( ISBLANK ( f ), BLANK (), "Where the net present value of package " & [Focus Key] & " comes from, " & [Selected Scenario] & " case: " & CONCATENATEX ( adj, LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) & " " & ( VAR __t = ROUND ( ( [@s] ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ), ", ", LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ), ASC ) & "; together " & ( VAR __t = ROUND ( ( SUMX ( adj, [@s] ) ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: f9e32720-9549-5bab-8b5a-94d236b200e1

	/// The plan table read aloud: what it lists and which initiatives are in the package in focus.
	measure 'Alt Plan Table (text)' = VAR f = [Focus Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) RETURN IF ( ISBLANK ( f ), BLANK (), "The ten Goodnight Inn initiatives, package " & [Focus Key] & "'s first: status, finding answered, capex, profit a year by 2032, net present value, guest-score effect. In package " & [Focus Key] & ": " & CONCATENATEX ( ids, LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ), ", ", [@p], ASC ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: df87fef2-6ede-5087-b775-018bf68e57fe

	/// The cumulative chart read aloud: payback year in the case in view and the 2032 end points of the three cases.
	measure 'Alt Cumulative (text)' = VAR pb = [Focus Payback Year] VAR s = [Selected Scenario] VAR lo = CALCULATE ( [Focus Cumulative Net (Low)], 'Date'[Year] = 2032 ) VAR ex = CALCULATE ( [Focus Cumulative Net (Expected)], 'Date'[Year] = 2032 ) VAR hi = CALCULATE ( [Focus Cumulative Net (High)], 'Date'[Year] = 2032 ) RETURN IF ( ISBLANK ( [Focus Package] ), BLANK (), "Package " & [Focus Key] & ", cumulative net impact 2027 to 2032: " & IF ( ISBLANK ( pb ), "not positive by 2032 in the " & s & " case", "positive from " & pb & " in the " & s & " case" ) & ". By 2032: Low " & ( VAR __t = ROUND ( ( lo ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & ", Expected " & ( VAR __t = ROUND ( ( ex ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & ", High " & ( VAR __t = ROUND ( ( hi ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 747baf92-06ce-55ab-8eca-191e2c5e532b

	/// The held-back card read aloud in under 250 characters (with R3 the canvas sentence runs to 261): same facts, shorter lead-in to the marginal test.
	measure 'Alt Rec Held (text)' = SUBSTITUTE ( SUBSTITUTE ( [Rec Held (text)], "The best way to spend more, A plus the ", "Adding the " ), ", costs ", " costs " )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: b6e13c6b-e8d3-5fb8-ab7c-d243992fafbc

	/// The plan button's accessible name, which contains its visible label (WCAG 2.5.3 Label in Name; the arrow is left out).
	measure 'Alt Open Plan (text)' = "Open the plan for package " & [Focus Key]
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 6711087f-4093-5747-b97e-9818825a23b9

	/// Plan state chart title with the payback year: the year axis does not fit the 88 px chart (pass-3 review: the crossing was unreadable).
	measure 'Cumulative Title (text)' = VAR pb = [Focus Payback Year] VAR s = [Selected Scenario] RETURN "Cumulative net impact of A, $M: " & IF ( ISBLANK ( pb ), "not positive by 2032 in the " & s & " case", "positive from " & pb & " in the " & s & " case" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: e7902a0e-f6b2-5eaf-93f1-c47db8b0250c

	/// The recommendation's one supporting sentence: which findings the moves answer, the budget held back and until when, and why nothing else is funded now.
	measure 'Rec Note (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR cap = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR fs = CONCATENATEX ( aIds, LOOKUPVALUE ( InvestmentProjects[Answers Finding], InvestmentProjects[ProjectID], [@p] ), ", ", [@p], ASC ) VAR k = COUNTROWS ( aIds ) VAR word = SWITCH ( k, 2, "both", 3, "all three", 4, "all four", "all " & k ) VAR live = FORMAT ( CALCULATE ( MAX ( InvestmentProjects[Completion Date] ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] IN aIds ), "mmm yyyy" ) VAR others = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" && NOT ( InvestmentProjects[ProjectID] IN aIds ) ), "@p", InvestmentProjects[ProjectID] ) VAR hiPos = COUNTROWS ( FILTER ( others, VAR p = [@p] RETURN ROUND ( CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p, Scenario[Scenario] = "High" ) / 100000, 0 ) >= 0 ) ) + 0 RETURN "Each move answers a finding on The Brand Review page (" & fs & "). The other " & FORMAT ( ( budget - cap ) / 1000000, "$#,0.0#" ) & "M" & " waits until " & word & " are live in " & live & IF ( hiPos = 0, ", because no further move pays back by 2032.", "." )
		formatString: @
		displayFolder: 13 Round 4 copy
		lineageTag: 3373962e-cc0c-5194-a70b-2849e5321d0f

	/// The reading guide above the scatter (feedback round 4: 'what am I looking at' before the dots; round 5: say what the 456 are, combinations within the budget).
	measure 'Guide (text)' = VAR n = COUNTROWS ( ALLNOBLANKROW ( Package ) ) VAR k = CALCULATE ( COUNTROWS ( InvestmentProjects ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) RETURN "Each dot is one of " & n & " possible packages: a mix of the " & k & " moves on offer within the " & FORMAT ( ( budget ) / 1000000, "$#,0.0#" ) & "M" & " budget (at least 3 moves, 1 of them growth). Capex across, NPV through 2032 up; above the line it pays back by 2032. Hover a dot for its moves."
		formatString: @
		displayFolder: 13 Round 4 copy
		lineageTag: 121c22f3-30b5-5edc-8f7c-fd6dc3e07435

	/// B, why it was considered: the swap against A and the wider guest-score reach.
	measure 'Alt B Why (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR x = [Preset B Package] VAR xIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = x ), "@p", PackageProject[ProjectID] ) VAR added = CONCATENATEX ( FILTER ( xIds, NOT ( [@p] IN aIds ) ), SUBSTITUTE ( LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), "refresh 10 oldest", "refresh of the 10 oldest hotels" ), " and ", [@p], ASC ) VAR dropped = CONCATENATEX ( FILTER ( aIds, NOT ( [@p] IN xIds ) ), LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), " and ", [@p], ASC ) VAR capA = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR capX = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR npvA = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR npvX = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR rA = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR rX = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) RETURN IF ( ISBLANK ( x ), BLANK (), "Considered because it swaps the " & dropped & " for the " & added & IF ( rX > rA, ": a guest-score effect in " & rX & " hotels instead of " & rA, "" ) & "." )
		formatString: @
		displayFolder: 13 Round 4 copy
		lineageTag: 714ebe83-8c4a-5484-9353-f66f1fcf521a

	/// B, why it was not picked (round 5, Björn): purely the capex-to-NPV mix, A is simply better; the NPV gap from the shown (rounded) figures, so it matches the cards; scenario in view.
	measure 'Alt B WhyNot (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR x = [Preset B Package] VAR xIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = x ), "@p", PackageProject[ProjectID] ) VAR added = CONCATENATEX ( FILTER ( xIds, NOT ( [@p] IN aIds ) ), SUBSTITUTE ( LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), "refresh 10 oldest", "refresh of the 10 oldest hotels" ), " and ", [@p], ASC ) VAR dropped = CONCATENATEX ( FILTER ( aIds, NOT ( [@p] IN xIds ) ), LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), " and ", [@p], ASC ) VAR capA = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR capX = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR npvA = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR npvX = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR rA = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR rX = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR pbA = [Preset A Payback Year] VAR pbX = [Preset B Payback Year] VAR d = ROUND ( npvA / 100000, 0 ) - ROUND ( npvX / 100000, 0 ) RETURN IF ( ISBLANK ( x ), BLANK (), "Not picked purely on the capex-to-NPV mix: " & FORMAT ( ( capX - capA ) / 1000000, "$#,0.0#" ) & "M" & " more capex for an NPV " & FORMAT ( ABS ( d ) / 10, "$0.0" ) & "M" & IF ( d > 0, " lower, so A is simply the better deal", IF ( d = 0, " no higher, so A is simply the better deal", " higher, but a later payback" ) ) & IF ( ISBLANK ( pbX ) && NOT ISBLANK ( pbA ), " (B is not cash positive by 2032)", IF ( pbX > pbA, " (cash positive in " & pbX & ", A in " & pbA & ")", "" ) ) & "." )
		formatString: @
		displayFolder: 13 Round 4 copy
		lineageTag: 292d1f82-6b48-544d-b9fe-9eaba82342d1

	/// C, why it is shown (round 5, Björn): a strategic investment aimed at NPS, the answer to 'why not renovate?' (08-verbeterplan V1).
	measure 'Alt C Why (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR x = [Preset C Package] VAR xIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = x ), "@p", PackageProject[ProjectID] ) VAR added = CONCATENATEX ( FILTER ( xIds, NOT ( [@p] IN aIds ) ), SUBSTITUTE ( LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), "refresh 10 oldest", "refresh of the 10 oldest hotels" ), " and ", [@p], ASC ) VAR dropped = CONCATENATEX ( FILTER ( aIds, NOT ( [@p] IN xIds ) ), LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), " and ", [@p], ASC ) VAR capA = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR capX = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR npvA = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR npvX = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR rA = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR rX = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) RETURN IF ( ISBLANK ( x ), BLANK (), "Considered as a strategic investment: the " & added & " is the move that targets NPS head-on (F3)." )
		formatString: @
		displayFolder: 13 Round 4 copy
		lineageTag: 1b01d0d8-1256-5fd4-a85f-cd212ce38eb4

	/// C, why it was not picked (round 5, Björn): not the financial risk to take now, below zero in every case (guarded); revisit at break-even or if NPS turns negative.
	measure 'Alt C WhyNot (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR x = [Preset C Package] VAR xIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = x ), "@p", PackageProject[ProjectID] ) VAR added = CONCATENATEX ( FILTER ( xIds, NOT ( [@p] IN aIds ) ), SUBSTITUTE ( LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), "refresh 10 oldest", "refresh of the 10 oldest hotels" ), " and ", [@p], ASC ) VAR dropped = CONCATENATEX ( FILTER ( aIds, NOT ( [@p] IN xIds ) ), LOWER ( LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) ), " and ", [@p], ASC ) VAR capA = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR capX = CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR npvA = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR npvX = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR rA = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR rX = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR hiX = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) VAR allNeg = ROUND ( CALCULATE ( MAX ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) / 100000, 0 ) < 0 && ROUND ( CALCULATE ( MAX ( Package[NPV Expected] ), REMOVEFILTERS ( Package ), Package[PackageID] = x ) / 100000, 0 ) < 0 && ROUND ( hiX / 100000, 0 ) < 0 RETURN IF ( ISBLANK ( x ), BLANK (), "Not the financial risk to take now: NPV " & ( VAR __t = ROUND ( ( npvX ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & IF ( allNeg, ", below zero in every case, even High (" & ( VAR __t = ROUND ( ( hiX ) / 100000, 0 ) / 10 RETURN IF ( __t = 0, "$0.0M", IF ( __t < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & FORMAT ( ABS ( __t ), "$#,0.0" ) & "M" ) ) & ").", IF ( ROUND ( npvX / 100000, 0 ) < 0, ", not paying back by 2032 in this case.", ", though it pays back by 2032 in this case." ) ) & " One to revisit once A has broken even, or if NPS drops below 0 and growth is at risk." )
		formatString: @
		displayFolder: 13 Round 4 copy
		lineageTag: 118b1172-a804-588f-8f04-1c6903e41478

	/// Card title of package B: its name and role, from PlanSelector.
	measure 'Pkg Label B (text)' = LOOKUPVALUE ( PlanSelector[Label], PlanSelector[Key], "B" )
