	/// Preset A: NPV from the Low to the High scenario, $M.
	measure 'Preset A Range (text)' = VAR f = [Preset A Package] VAR lo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 VAR hi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) / 1000000 RETURN IF ( ISBLANK ( f ), BLANK (), IF ( lo < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( lo ), "0.0" ) & " to " & IF ( hi < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( hi ), "0.0" ) )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 80efeaa9-f4ab-5865-b54e-2a5c5a713c5c

	/// Preset A: package id and the initiatives in it.
	measure 'Preset A Mix (text)' = VAR f = [Preset A Package] RETURN IF ( ISBLANK ( f ), "No package qualifies in this case.", f & ": " & CONCATENATEX ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], PackageProject[ProjectID] ), " + ", PackageProject[ProjectID], ASC ) )
		formatString: @
