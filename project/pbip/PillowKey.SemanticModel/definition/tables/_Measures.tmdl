	/// The Definitions chip read aloud: the glossary in one breath, so a keyboard or screen-reader user gets the terms the hover shows.
	measure 'Alt Definitions (text)' = "The short words on these pages. NPV: net present value to 2032. Capex: the investment. Run-rate: profit a year by 2032. NPS: promoters minus detractors. ADR: revenue per room sold. RevPAR: revenue per room available. OTA: an online booking site."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 68655a71-0b3f-52d3-838d-22d4ef8672d3

	/// The reading guide read aloud.
	measure 'Alt Guide (text)' = "How to read the chart. " & [Guide (text)] & " A is our recommendation; B and C were considered and not recommended."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: cffc7ff4-1339-5942-8ae8-d49f6b9156be

	/// The tooltip's moves table read aloud.
	measure 'Alt TT Moves (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) RETURN IF ( ISBLANK ( pkg ), BLANK (), "The moves in the hovered package with their net present value: " & [TT Moves (text)] & ". " & [TT Not Included (text)] )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 874feda9-d185-5063-81ed-1386f891513e

	/// Package B's numbers card read aloud.
	measure 'Alt B Nums (text)' = "Package B, " & [Selected Scenario] & " case: capex " & [Preset B Capex (text)] & ", net present value through 2032 " & [Preset B NPV (text)] & ", from " & [Preset B Range (text)] & " $M between the Low and High cases."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 0b5a79ae-5404-5b50-82be-33b9690416a0

	/// Package B's waterfall read aloud.
	measure 'Alt B Waterfall (text)' = VAR f = [Preset B Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR base = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR tr = ROUND ( SUMX ( base, [@v] ) / 100000, 0 ) VAR fl = ADDCOLUMNS ( base, "@f", INT ( [@v] / 100000 ) ) VAR fr = ADDCOLUMNS ( fl, "@r", [@v] / 100000 - [@f] + VALUE ( RIGHT ( [@p], 2 ) ) * 0.000000001 ) VAR k = tr - SUMX ( fr, [@f] ) VAR adj = ADDCOLUMNS ( fr, "@s", ( [@f] + IF ( RANKX ( fr, [@r], , DESC ) <= k, 1, 0 ) ) * 100000 ) RETURN IF ( ISBLANK ( f ), BLANK (), "Where the net present value of package B comes from, " & [Selected Scenario] & " case: " & CONCATENATEX ( adj, LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) & " " & ( VAR __v = ( [@s] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), ", ", LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ), ASC ) & "; together " & ( VAR __v = ( SUMX ( adj, [@s] ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 798edd93-0335-5323-bdde-4c2461497de5

	/// Package C's numbers card read aloud.
	measure 'Alt C Nums (text)' = "Package C, " & [Selected Scenario] & " case: capex " & [Preset C Capex (text)] & ", net present value through 2032 " & [Preset C NPV (text)] & ", from " & [Preset C Range (text)] & " $M between the Low and High cases."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 765357c3-fb2d-50a9-be3e-09408405947d

	/// Package C's waterfall read aloud.
	measure 'Alt C Waterfall (text)' = VAR f = [Preset C Package] VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = f ), "@p", PackageProject[ProjectID] ) VAR base = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR tr = ROUND ( SUMX ( base, [@v] ) / 100000, 0 ) VAR fl = ADDCOLUMNS ( base, "@f", INT ( [@v] / 100000 ) ) VAR fr = ADDCOLUMNS ( fl, "@r", [@v] / 100000 - [@f] + VALUE ( RIGHT ( [@p], 2 ) ) * 0.000000001 ) VAR k = tr - SUMX ( fr, [@f] ) VAR adj = ADDCOLUMNS ( fr, "@s", ( [@f] + IF ( RANKX ( fr, [@r], , DESC ) <= k, 1, 0 ) ) * 100000 ) RETURN IF ( ISBLANK ( f ), BLANK (), "Where the net present value of package C comes from, " & [Selected Scenario] & " case: " & CONCATENATEX ( adj, LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) & " " & ( VAR __v = ( [@s] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), ", ", LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ), ASC ) & "; together " & ( VAR __v = ( SUMX ( adj, [@s] ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 980b9240-2976-5e97-90f1-82cde0ca56c9

	/// The alts comparer read aloud: the three 2032 end points.
	measure 'Alt Cmp Alts (text)' = VAR s = [Selected Scenario] VAR a32 = CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR b32 = CALCULATE ( [Preset B Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR c32 = CALCULATE ( [Preset C Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) RETURN "Cumulative net impact 2027 to 2032 against A, " & s & " case, by 2032: A " & ( VAR __v = ( a32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ", B " & ( VAR __v = ( b32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ", C " & ( VAR __v = ( c32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 56305f76-52d9-520c-adb2-7f2221673409

	/// The your-plan numbers card read aloud, with the rules check.
	measure 'Alt You Nums (text)' = "Your plan, " & [Selected Scenario] & " case: capex " & [Build Capex (text)] & ", net present value through 2032 " & [Build NPV (text)] & ", from " & [Build Range (text)] & " $M between the Low and High cases. " & [Build Valid (text)]
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 2a6a0768-3a95-58cf-9c31-ea296ccf4cda

	/// The build waterfall read aloud.
	measure 'Alt Build Waterfall (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR base = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR tr = ROUND ( SUMX ( base, [@v] ) / 100000, 0 ) VAR fl = ADDCOLUMNS ( base, "@f", INT ( [@v] / 100000 ) ) VAR fr = ADDCOLUMNS ( fl, "@r", [@v] / 100000 - [@f] + VALUE ( RIGHT ( [@p], 2 ) ) * 0.000000001 ) VAR k = tr - SUMX ( fr, [@f] ) VAR adj = ADDCOLUMNS ( fr, "@s", ( [@f] + IF ( RANKX ( fr, [@r], , DESC ) <= k, 1, 0 ) ) * 100000 ) RETURN IF ( n = 0, "No moves picked yet.", "Where the net present value of your plan comes from, " & [Selected Scenario] & " case: " & CONCATENATEX ( adj, LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) & " " & ( VAR __v = ( [@s] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), ", ", LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ), ASC ) & "; together " & ( VAR __v = ( SUMX ( adj, [@s] ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: fd7305ce-b3f1-5ad7-9719-92535813fa4b

	/// The build comparer read aloud.
	measure 'Alt Cmp Build (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR s = [Selected Scenario] VAR a32 = CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR y32 = CALCULATE ( [Build Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) RETURN IF ( n = 0, "Cumulative net impact of A 2027 to 2032, " & s & " case, ends at " & ( VAR __v = ( a32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "; pick moves to add your plan.", "Cumulative net impact 2027 to 2032, " & s & " case, by 2032: your plan " & ( VAR __v = ( y32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ", A " & ( VAR __v = ( a32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 059d365b-3752-553d-8900-9a2d063f4e0e

	/// A year on cost: the annual operating-profit impact by 2032 of the moves in context over their capex, scenario in view. A derived ratio, not a valuation (no discounting, no ramp-up, no disruption).
	measure 'A Year on Cost' = DIVIDE ( [2032 Run-rate], SUM ( InvestmentProjects[CapexUSD] ) )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: f8b85be7-81db-5f2f-bfa6-022c3480525f

	/// A year on cost of the package(s) in context: 2032 run-rate over capex, scenario in view.
	measure 'Package A Year on Cost (sel)' = DIVIDE ( [Package Run-rate (sel)], [Package Capex] )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 7da727ac-7189-5cf9-a25a-4f3c216e0a96

	/// A year on cost of the recommendation (package A), scenario in view.
	measure 'Rec A Year on Cost (sel)' = VAR a = [Recommended Package] RETURN CALCULATE ( [Package A Year on Cost (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 4367b6fa-822a-5401-ae46-7c660db1e660

	/// NPV through 2032 of the recommendation in the Low case, whatever the toggle says (the worst-case line).
	measure 'Rec NPV Low' = VAR a = [Recommended Package] RETURN CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: d3a6946b-42ed-5201-b6ef-747eecbc9523

	/// Profit a year by 2032 of the recommendation in the Low case, whatever the toggle says (the worst-case line).
	measure 'Rec Run-rate Low' = VAR a = [Recommended Package] RETURN CALCULATE ( SUM ( Package[RunRate Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: f732fc14-eb89-5490-9e18-2481fa853a10

	/// Profit a year by 2032 of the plan being built, scenario in view; blank while nothing is picked.
	measure 'Build Run-rate (sel)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, BLANK (), CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: bb637438-f737-5875-b7de-65fe788b654f

	/// A year on cost of the plan being built, scenario in view; blank while nothing is picked.
	measure 'Build A Year on Cost (sel)' = DIVIDE ( [Build Run-rate (sel)], [Build Capex] )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 481db454-6907-5420-8836-882564496c32

	/// Selector row (BuildMove): profit a year by 2032 of the move alone, scenario in view.
	measure 'Move Run-rate (num)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) RETURN IF ( ISBLANK ( p ), BLANK (), CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: e42f9d6e-9b04-5238-8f15-9515076ba125

	/// Mark colour of a move by its decision status (MoveDecision): Coffee Blue for package A, Night for the 2028 gate, Warm Grey for not now. A mark colour (3.5:1 at the lightest): the status word carries the state.
	measure 'Move Status Color' = VAR st = LOOKUPVALUE ( MoveDecision[Status], MoveDecision[ProjectID], SELECTEDVALUE ( InvestmentProjects[ProjectID] ) ) RETURN IF ( ISBLANK ( st ), BLANK (), SWITCH ( st, "A", "#2589D8", "2028 gate", "#12233D", "#8E897D" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 89662495-368d-5a7a-a5db-d8073d45c822

	/// Hero table, bar cell of 'a year on cost' for the move in the row (scenario in view): a bar from 0 in the move's status colour and the 8 % line (our cost of money). Fixed domain -10 % to 90 %. Decorative: the value stands in the column beside it.
	measure 'Hero Yield Bar SVG' = VAR v = [A Year on Cost] VAR c = MIN ( MAX ( v, -0.1 ), 0.9 ) VAR xv = -3.0 + ( c - ( -0.1 ) ) / 1.0 * 188 VAR x0 = 15.8 VAR fill = SUBSTITUTE ( [Move Status Color], "#", "%23" ) RETURN IF ( ISBLANK ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ) ) || ISBLANK ( v ), BLANK (), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='173' height='34' viewBox='0 0 173 34'><rect x='" & FORMAT ( MIN ( x0, xv ), "0.0", "en-US" ) & "' y='8' width='" & FORMAT ( ABS ( xv - x0 ), "0.0", "en-US" ) & "' height='18' fill='" & fill & "'/><rect x='30.34' y='0' width='1' height='34' fill='%2312233D' shape-rendering='crispEdges'/></svg>" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		dataCategory: ImageUrl
		lineageTag: f249eec3-edc6-5b60-94d4-e7ff202368b1

	/// Hero table, bar cell of the NPV through 2032 for the move in the row (scenario in view): a bar from 0 in the move's status colour and the zero line (pays back by 2032 to its right). Fixed domain -$32M to +$12M. Decorative: the value stands in the column beside it.
	measure 'Hero NPV Bar SVG' = VAR v = [NPV @ 8%] VAR c = MIN ( MAX ( v, -32000000.0 ), 12000000.0 ) VAR xv = -3.0 + ( c - ( -32000000.0 ) ) / 44000000.0 * 172 VAR x0 = 122.0909090909091 VAR fill = SUBSTITUTE ( [Move Status Color], "#", "%23" ) RETURN IF ( ISBLANK ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ) ) || ISBLANK ( v ), BLANK (), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='173' height='34' viewBox='0 0 173 34'><rect x='" & FORMAT ( MIN ( x0, xv ), "0.0", "en-US" ) & "' y='8' width='" & FORMAT ( ABS ( xv - x0 ), "0.0", "en-US" ) & "' height='18' fill='" & fill & "'/><rect x='121.59' y='0' width='1' height='34' fill='%2312233D' shape-rendering='crispEdges'/></svg>" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		dataCategory: ImageUrl
		lineageTag: 7461fb07-bd4e-5113-8920-80090fafab9b

	/// Hero table: the lowest 'a year on cost' of the ten moves over the three scenarios, rounded down to 10 points (never above 0). Guards the fixed domain of the bar cells.
	measure 'Hero Yield Domain Min' = VAR t = CROSSJOIN ( CALCULATETABLE ( VALUES ( InvestmentProjects[ProjectID] ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" ), ALLNOBLANKROW ( Scenario[Scenario] ) ) VAR v = ADDCOLUMNS ( t, "@v", VAR p = InvestmentProjects[ProjectID] VAR s = Scenario[Scenario] RETURN CALCULATE ( [A Year on Cost], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p, REMOVEFILTERS ( Scenario ), Scenario[Scenario] = s ) ) RETURN INT ( MIN ( MINX ( v, [@v] ), 0 ) * 10 ) / 10
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 3fca2b73-c3fe-5e8e-a2ce-e9e5bb5b988d

	/// Hero table: the highest 'a year on cost' of the ten moves over the three scenarios, rounded up to 10 points. Guards the fixed domain of the bar cells.
	measure 'Hero Yield Domain Max' = VAR t = CROSSJOIN ( CALCULATETABLE ( VALUES ( InvestmentProjects[ProjectID] ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" ), ALLNOBLANKROW ( Scenario[Scenario] ) ) VAR v = ADDCOLUMNS ( t, "@v", VAR p = InvestmentProjects[ProjectID] VAR s = Scenario[Scenario] RETURN CALCULATE ( [A Year on Cost], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p, REMOVEFILTERS ( Scenario ), Scenario[Scenario] = s ) ) RETURN - INT ( - MAXX ( v, [@v] ) * 10 ) / 10
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: b8c45ffb-1ac4-51c9-84f2-32a166d27d56

	/// Hero table: the lowest NPV of the ten moves over the three scenarios, rounded down to $4M. Guards the fixed domain of the bar cells.
	measure 'Hero NPV Domain Min' = VAR t = CROSSJOIN ( CALCULATETABLE ( VALUES ( InvestmentProjects[ProjectID] ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" ), ALLNOBLANKROW ( Scenario[Scenario] ) ) VAR v = ADDCOLUMNS ( t, "@v", VAR p = InvestmentProjects[ProjectID] VAR s = Scenario[Scenario] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p, REMOVEFILTERS ( Scenario ), Scenario[Scenario] = s ) ) RETURN INT ( MINX ( v, [@v] ) / 4000000 ) * 4000000
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: ab97b6a3-233d-5ab0-9154-2366a9d67ca2

	/// Hero table: the highest NPV of the ten moves over the three scenarios, rounded up to $4M. Guards the fixed domain of the bar cells.
	measure 'Hero NPV Domain Max' = VAR t = CROSSJOIN ( CALCULATETABLE ( VALUES ( InvestmentProjects[ProjectID] ), REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" ), ALLNOBLANKROW ( Scenario[Scenario] ) ) VAR v = ADDCOLUMNS ( t, "@v", VAR p = InvestmentProjects[ProjectID] VAR s = Scenario[Scenario] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p, REMOVEFILTERS ( Scenario ), Scenario[Scenario] = s ) ) RETURN - INT ( - MAXX ( v, [@v] ) / 4000000 ) * 4000000
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: da1ac2cf-a9b9-5afb-923a-7e3c4ff65ead

	/// Capex of tranche 1 (package A, funded now); a segment of the plan bar.
	measure 'Tranche 1 Capex' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 1 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8341e038-37b6-5c53-b9c1-1501cd321515

	/// Profit a year once live of tranche 1 (package A, funded now), scenario in view.
	measure 'Tranche 1 Run-rate' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 1 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 46228b3e-1665-5544-82fa-df62468c8d32

	/// A year on cost of tranche 1 (package A, funded now), scenario in view.
	measure 'Tranche 1 Year on Cost' = DIVIDE ( [Tranche 1 Run-rate], [Tranche 1 Capex] )
