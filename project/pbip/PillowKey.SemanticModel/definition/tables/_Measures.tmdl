		lineageTag: 4f37b58c-e0e4-5a0f-a84b-88aff692a26b

	/// F2 card title read aloud with its kicker (the kicker leaves the tab order; pass-3 review: fewer stops).
	measure 'Alt F2 Title (text)' = "F2, the middleman. " & [F2 Title (text)]
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 4cbfed86-4c2b-5498-9400-27c4226eb754

	/// F3 card title read aloud with its kicker (the kicker leaves the tab order; pass-3 review: fewer stops).
	measure 'Alt F3 Title (text)' = "F3, the fading welcome. " & [F3 Title (text)]
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 7538b32b-42a0-590c-9a90-e31b6afde0cb

	/// F4 card title read aloud with its kicker (the kicker leaves the tab order; pass-3 review: fewer stops).
	measure 'Alt F4 Title (text)' = "F4, where we are full. " & [F4 Title (text)]
		formatString: @
