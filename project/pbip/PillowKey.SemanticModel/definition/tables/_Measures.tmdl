				```

	/// Build bar chart (BuildBar): the NPV through 2032 of a picked move alone, scenario in view; blank for a move that is not picked, so the chart lists the plan only. Zero on an empty row while fewer than 5 moves are picked (the row keeps the bars at the comp's pitch and shows nothing).
	measure 'Build Bar NPV' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR me = SELECTEDVALUE ( BuildBar[ProjectID] ) VAR pad = SELECTEDVALUE ( BuildBar[Pad] ) RETURN IF ( n > 0, IF ( me IN ids, CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = me ), IF ( pad > 0 && pad <= 5 - n, 0 ) ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8a83f685-d73a-5b44-b51c-5ab7d4d448f3

	/// Build bar chart: the picked move's NPV with its label as finished text ('+$3.4M', '−$0.6M'); an empty row prints a space.
	measure 'Build Bar NPV (label-safe)' = [Build Bar NPV]
		displayFolder: 15 Storytelling rebuild
		lineageTag: 106e2b5d-f778-5109-b4e7-7ac45b9b6116

		formatStringDefinition = ```
				VAR __t = IF ( SELECTEDVALUE ( BuildBar[Pad] ) > 0, " ", ( VAR __v = ( [Build Bar NPV] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) ) RETURN """" & __t & """;""" & __t & """;""" & __t & """"
				```

	/// Build bar chart: Night for a move that adds NPV (Night is 'your plan'), Tangerine for one that costs NPV; the signed label carries it too (R-G3).
