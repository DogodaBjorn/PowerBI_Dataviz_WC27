	measure 'Preset A Cumulative End (label-safe)' = VAR __y = MAX ( 'Date'[Year] ) VAR __h = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) RETURN IF ( __y = __h, [Preset A Cumulative Net (sel)] )
