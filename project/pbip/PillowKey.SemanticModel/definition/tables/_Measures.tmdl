	measure 'Facts Bar SVG' = "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='856' height='28' viewBox='0 0 856 28'>" & "<rect width='856' height='28' rx='14' fill='%23FCE6DB'/><circle cx='14' cy='14' r='10' fill='%23E05A22'/><circle cx='14' cy='9.4' r='1.6' fill='%23FFFFFF'/><rect x='12.8' y='12.2' width='2.4' height='7.4' rx='1.2' fill='%23FFFFFF'/><text x='32' y='19.5' font-family='Segoe UI, Arial, sans-serif' font-size='16' fill='%234B5466'>Revisit the facts</text><text x='160' y='19.5' text-anchor='start' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%23A63F0E'>F1</text><circle cx='292' cy='14' r='1.75' fill='%238E897D'/><text x='300' y='19.5' text-anchor='start' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%23A63F0E'>F2</text><circle cx='464' cy='14' r='1.75' fill='%238E897D'/><text x='472' y='19.5' text-anchor='start' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%23A63F0E'>F3</text><circle cx='672' cy='14' r='1.75' fill='%238E897D'/><text x='680' y='19.5' text-anchor='start' font-family='Segoe UI, Arial, sans-serif' font-size='16' font-weight='600' fill='%23A63F0E'>F4</text></svg>"
