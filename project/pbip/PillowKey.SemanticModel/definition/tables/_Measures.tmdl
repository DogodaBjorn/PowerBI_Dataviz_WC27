	/// Capex of tranche 2 (the airport extensions, decided at the 2028 gate); a segment of the plan bar.
	measure 'Tranche 2 Capex' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: fd012a28-1416-5d64-93c5-bffcb55fdc24

	/// Profit a year once live of tranche 2 (the airport extensions, decided at the 2028 gate), scenario in view.
	measure 'Tranche 2 Run-rate' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: e7053bfd-3004-5612-9a56-a0f1d8653d97

	/// A year on cost of tranche 2 (the airport extensions, decided at the 2028 gate), scenario in view.
	measure 'Tranche 2 Year on Cost' = DIVIDE ( [Tranche 2 Run-rate], [Tranche 2 Capex] )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 1c35e2b2-a3ae-54d1-b79a-492b330eb1ff

	/// Capex of tranche 3 (the refresh, decided at the 2028 gate); a segment of the plan bar.
	measure 'Tranche 3 Capex' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 3 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: e4d07ab2-bd69-554f-a41e-151b99a26b96

	/// Profit a year once live of tranche 3 (the refresh, decided at the 2028 gate), scenario in view.
	measure 'Tranche 3 Run-rate' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 3 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: b7121f10-9072-5062-9443-51407f1bb50f

	/// A year on cost of tranche 3 (the refresh, decided at the 2028 gate), scenario in view.
	measure 'Tranche 3 Year on Cost' = DIVIDE ( [Tranche 3 Run-rate], [Tranche 3 Capex] )
		formatString: 0.0%
