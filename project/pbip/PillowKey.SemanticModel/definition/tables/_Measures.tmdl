	/// Package B's payback line on its card (undiscounted cumulative), scenario in view.
	measure 'Preset B Payback (text)' = VAR f = [Preset B Package] VAR pb = [Preset B Payback Year] RETURN IF ( ISBLANK ( f ), BLANK (), IF ( ISBLANK ( pb ), "Not cash positive by 2032 in the ", "Cash positive from " & pb & " in the " ) & [Selected Scenario] & " case" )
