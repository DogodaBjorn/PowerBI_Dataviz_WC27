	/// Page-1 subtitle (R-P1-1): the year and the comparison. Final round (16 Nov): the second sentence (for the Board, what page 2 does) left; the page button says it.
	measure 'Subtitle P1 Briefing (text)' = VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) - 1 RETURN "Goodnight Inn in " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Base year" ) & ", against the other " & ( VAR __n = n RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " Pillow & Key Group brands."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 2ad9557c-7c91-562a-80f7-7bab191f019c

	/// F1 note (R-P1-3, N-2): the 2023-2025 fall of the margin after commissions split into commissions and running costs, the staff share as the main running cost, and room-rate growth since 2023 against the sister brands (plan 09 R1).
	measure 'F1 Note (text)' = VAR gn = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR better = COUNTROWS ( FILTER ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN 1 * CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) > 1 * gn ) ) VAR r = better + 1 VAR n = COUNTROWS ( ALLNOBLANKROW ( Brands[Brand] ) ) VAR words = SWITCH ( TRUE (), r = 1, "best of " & n, r = n, "last of " & n, r = 2, "2nd of " & n, "3rd of " & n ) VAR c23 = CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) - CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) VAR c25 = gn - CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR comm = ROUND ( ( c25 - c23 ) * 100, 1 ) VAR ops = ROUND ( ( CALCULATE ( [GOP Margin %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) - gn ) * 100, 1 ) VAR s23 = CALCULATE ( [Staff Cost % of Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) VAR s25 = CALCULATE ( [Staff Cost % of Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR pa = ROUND ( DIVIDE ( CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ), CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) ) - 1, 3 ) VAR plo = ROUND ( MINX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN DIVIDE ( CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ), CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) ) - 1 ), 3 ) VAR phi = ROUND ( MAXX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN DIVIDE ( CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ), CALCULATE ( [ADR], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) ) - 1 ), 3 ) RETURN IF ( comm > 0 && ops > 0, "Commissions took " & FORMAT ( comm, "0.0", "en-US" ) & IF ( comm = 1, " point", " points" ) & ", running costs " & FORMAT ( ops, "0.0", "en-US" ) & " (staff: " & ( VAR __p = ( s23 ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " to " & ( VAR __p = ( s25 ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " of revenue). ", "" ) & "Room rates " & IF ( pa < 0, "fell ", "rose " ) & ( VAR __p = ( ABS ( pa ) ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & ", " & IF ( pa > phi, "faster than the other brands.", IF ( pa < plo, "slower than the other brands.", "no faster than the other brands." ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: f88fcce5-b25b-5b98-9232-84c61d5be430

	/// F2 note (R-P1-4): what booking direct changes for one room night (from the folio's shown amounts), the bridge to member rates, and the 2021-mix counterfactual.
	measure 'F2 Note (text)' = VAR o = ROUND ( DIVIDE ( CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ), CALCULATE ( [Channel Room Nights], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ) ), 2 ) VAR oc = ROUND ( DIVIDE ( CALCULATE ( [Distribution Cost], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ), CALCULATE ( [Channel Room Nights], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ) ), 2 ) VAR d = ROUND ( DIVIDE ( CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ), CALCULATE ( [Channel Room Nights], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ) ), 2 ) VAR dc = ROUND ( DIVIDE ( CALCULATE ( [Distribution Cost], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ), CALCULATE ( [Channel Room Nights], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ) ), 2 ) VAR dp = d - o VAR dk = ( d - dc ) - ( o - oc ) VAR x = CALCULATE ( [Distribution Cost above 2021 Mix 2025], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) RETURN "Booked direct, the guest pays " & FORMAT ( ABS ( dp ), "$#,0.00", "en-US" ) & IF ( dp >= 0, " more", " less" ) & " and we keep " & FORMAT ( ABS ( dk ), "$#,0.00", "en-US" ) & IF ( dk >= 0, " more", " less" ) & IF ( dp >= 0, "; nothing rewards it. ", ". " ) & "At the 2021 channel mix, 2025 commissions would be " & ( VAR __v = ( ABS ( x ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & IF ( x >= 0, " lower.", " higher." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 4a63674e-4605-5afd-b76e-8aa3d1771daf

	/// F3 count line (R-P1-5): how many hotels the three age bands hold, counted from the model (hotels with and without a renovation date).
	measure 'F3 Count (text)' = VAR nAll = CALCULATE ( COUNTROWS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) VAR dated = CALCULATE ( COUNTROWS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", NOT ISBLANK ( Hotels[Renovation Age Sort] ) ) VAR u = nAll - dated RETURN dated & " of " & nAll & " hotels" & IF ( u = 0, ".", "; " & u & IF ( u = 1, " has", " have" ) & " no renovation date." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: c5f7dd9b-42a4-5e94-88dc-ea6b5c0acfe3

	/// F3 note (R-P1-5): renovation spend per hotel since 2018 against the sister brands, the last start, and the causality caveat (05 caveat A2).
	measure 'F3 Note (text)' = VAR sp = CALCULATE ( [Renovation Spend per Hotel since 2018], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ) ) VAR lo = MINX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN CALCULATE ( [Renovation Spend per Hotel since 2018], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ) ) ) VAR hi = MAXX ( FILTER ( ALLNOBLANKROW ( Brands[Brand] ), Brands[Brand] <> "Goodnight Inn" ), VAR b = Brands[Brand] RETURN CALCULATE ( [Renovation Spend per Hotel since 2018], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = b, REMOVEFILTERS ( 'Date' ) ) ) VAR last = YEAR ( CALCULATE ( MAX ( Renovations[StartDate] ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ) ) ) RETURN "Since 2018 we spent " & ( VAR __v = ( sp ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " per hotel on renovation, the other brands " & ( VAR __v = ( lo ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " to " & ( VAR __v = ( hi ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & "; none started since " & last & ". An association, not proof of cause."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 62309ed8-b20e-5b90-a712-b484b5504f9e

	/// F4 title (R-P1-6, review round 2): how many of the seven fullest hotels of 2025 are airports, which the dot plot shows; 'our airports run fullest' while the airports are the fullest location type.
	measure 'F4 Title (text)' = VAR hs = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[Brand] = "Goodnight Inn" ), "@m", VAR h = Hotels[HotelID] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@o", VAR h = Hotels[HotelID] RETURN CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ) ) VAR t7 = TOPN ( 7, hs, [@o], DESC ) VAR na = COUNTROWS ( FILTER ( t7, LOOKUPVALUE ( Hotels[LocationType], Hotels[HotelID], Hotels[HotelID] ) = "Airport" ) ) + 0 VAR air = [Occupancy Airport GI] VAR best = MAX ( [Occupancy City GI], [Occupancy Highway GI] ) VAR w = ( VAR __n = na RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " of the " & ( VAR __n = COUNTROWS ( t7 ) RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " fullest hotels are airports" RETURN IF ( air >= best, "Our airports run fullest: " & w, UPPER ( LEFT ( w, 1 ) ) & MID ( w, 2, LEN ( w ) ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 79e91d5d-ce2c-5b0a-9f13-a6f95fcf6a5e

	/// F4 note: the three hotels with the most months at or above 90 % occupancy in the last 24, and the one extension on offer outside them (Kingston) with its count.
	measure 'F4 Note (text)' = VAR hs = ADDCOLUMNS ( CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[Brand] = "Goodnight Inn" ), "@m", VAR h = Hotels[HotelID] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@o", VAR h = Hotels[HotelID] RETURN CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ) ) VAR t3 = TOPN ( 3, hs, [@m], DESC, [@o], DESC ) VAR h1 = MAXX ( TOPN ( 1, t3, [@m], DESC, [@o], DESC ), Hotels[HotelID] ) VAR r2 = FILTER ( t3, Hotels[HotelID] <> h1 ) VAR h2 = MAXX ( TOPN ( 1, r2, [@m], DESC, [@o], DESC ), Hotels[HotelID] ) VAR h3 = MAXX ( FILTER ( r2, Hotels[HotelID] <> h2 ), Hotels[HotelID] ) VAR ext = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Category], InvestmentProjects[Brand] ), InvestmentProjects[Category] = "Expansion" && InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID] ) VAR eh =ADDCOLUMNS ( ext, "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR other = FILTER ( eh, NOT ( [@h] IN { h1, h2, h3 } ) ) VAR kh = MAXX ( other, [@h] ) VAR km = MAXX ( FILTER ( hs, Hotels[HotelID] = kh ), [@m] ) RETURN LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], h1 ) & " topped 90% in " & MAXX ( FILTER ( hs, Hotels[HotelID] = h1 ), [@m] ) & " of the last 24 months, " & LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], h2 ) & " in " & MAXX ( FILTER ( hs, Hotels[HotelID] = h2 ), [@m] ) & ", " & LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], h3 ) & " in " & MAXX ( FILTER ( hs, Hotels[HotelID] = h3 ), [@m] ) & IF ( COUNTROWS ( other ) = 1, "; " & LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], kh ) & ", the " & ( VAR __n = COUNTROWS ( ext ) RETURN SWITCH ( __n, 1, "first", 2, "second", 3, "third", 4, "fourth", 5, "fifth", FORMAT ( __n, "0", "en-US" ) & "th" ) ) & " extension on offer, in " & IF ( km = 0, "none", FORMAT ( km, "0", "en-US" ) ), "" ) & "."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: ba103e85-65ac-5f63-a5f2-c2b65ae81a6b

	/// F4 forward link (R-P1-7): the move on page 2 that answers F4, with the number of hotels the kiosk move covers read from the organisers' project properties.
	measure 'Link F4 (text)' = VAR n = COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = "GI-02" ) ) RETURN "Page 2: kiosks at the " & FORMAT ( n, "0", "en-US" ) & " busiest hotels; extensions wait for the 2028 gate."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 5bd58532-1b8e-5d64-9ae8-acc8f35c4f10

	/// Page-2 headline (D6, doc 22 section 4): what A costs now and what it earns a year by 2032, scenario in view.
	measure 'Headline P2 (text)' = "Fix the middleman first: " & ( VAR __v = ( [Rec Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " now earns " & ( VAR __v = ( [Rec Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: fdde1c1c-b230-5954-8801-4288f3ba71ae

	/// Page-2 subtitle (R-P2-1): the budget that waits for the gate, the case in view, and the valuation rule with why the yearly figure is shown too.
	measure 'Subtitle P2 (text)' = VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR h = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) RETURN "The rest waits for the Board in mid-2028. " & [Selected Scenario] & " case. NPV counts nothing after " & h & ", so we also show what each move earns a year."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 2db176a3-ef97-52f9-a12f-36e38557f148

	/// Page-2 source line (R-P2-12): the source and the three valuation parameters, read from FinanceParameters.
	measure 'Footer P2 (text)' = "Source: Pillow & Key Group dataset and finance parameters (" & FORMAT ( LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ), "0%", "en-US" ) & " discount rate, " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Base year" ) & " dollars, horizon " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "). Parts are rounded to add up."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8ac5c564-37f8-574e-8b35-36e5c61646be

	/// Hero and selector row: the move's 'a year on cost', scenario in view.
	measure 'Move Yield (text)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) RETURN IF ( ISBLANK ( p ), BLANK (), VAR y = CALCULATE ( [A Year on Cost], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) RETURN ( VAR __p = ( y ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 28846e23-8a61-58f0-afc0-c75b9eff12f7

	/// Hero row: the move's decision status as a word (A, 2028 gate, not now): status is a word first, a colour second (P-6). A move marked not now shows its reason where the data gives one: 'package B' (in the alternative, not in A), 'not full' (an extension whose hotel never topped 90 % in the last 24 months).
	measure 'Move Status (text)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR b = [Preset B Package] VAR bIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = b ), "@p", PackageProject[ProjectID] ) VAR ext = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Category], InvestmentProjects[Brand] ), InvestmentProjects[Category] = "Expansion" && InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID] ) VAR st = LOOKUPVALUE ( MoveDecision[Status], MoveDecision[ProjectID], p ) VAR h = MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) VAR m90 = CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ) + 0 RETURN IF ( ISBLANK ( p ), BLANK (), SWITCH ( TRUE (), st <> "not now", st, p IN bIds && NOT ( p IN aIds ), "package B", p IN ext && m90 = 0, "not full", st ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 483746bc-13c4-5f13-bed5-620e60e52ee6

	/// Selector row: the move's profit a year by 2032 as text.
	measure 'Move Run-rate (text)' = VAR v = [Move Run-rate (num)] RETURN IF ( ISBLANK ( v ), BLANK (), ( VAR __v = ( v ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: d5693e44-fef2-50ac-8dc3-a0e4695bb7d8

	/// Hero title (R-P2-3): how many moves pass both tests (a year on cost at or above our cost of money, NPV through 2032 at least zero), then the first move in hero order that passes the first test only. Scenario in view; the order never moves.
	measure 'Hero Title (text)' = VAR t = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Brand], InvestmentProjects[Hero Sort] ), InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID], "@o", InvestmentProjects[Hero Sort] ), "@y", VAR p = [@p] RETURN CALCULATE ( [A Year on Cost], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR k = COUNTROWS ( FILTER ( t, ROUND ( [@y], 3 ) >= LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ) && ROUND ( [@v] / 1000000, 2 ) >= 0 ) ) + 0 VAR f = TOPN ( 1, FILTER ( t, ROUND ( [@y], 3 ) >= LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ) && NOT ( ROUND ( [@v] / 1000000, 2 ) >= 0 ) ), [@o], ASC ) VAR fp = MAXX ( f, [@p] ) VAR fy = MAXX ( f, [@y] ) VAR pl = ( fp IN { "GI-02" } ) VAR nPay = COUNTROWS ( FILTER ( t, ROUND ( [@v] / 1000000, 2 ) >= 0 ) ) + 0 VAR pk = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@pv", SWITCH ( [Selected Scenario], "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) VAR av = [Rec NPV (sel)] VAR beat = COUNTROWS ( FILTER ( pk, [@pv] > av ) ) + 0 RETURN IF ( nPay = 0 && beat = 0, "In the " & [Selected Scenario] & " case no move pays back by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "; package A still loses least of all " & COUNTROWS ( pk ) & " packages", ( VAR __w = ( VAR __n = k RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) RETURN UPPER ( LEFT ( __w, 1 ) ) & MID ( __w, 2, 500 ) ) & IF ( k = 1, " move passes", " moves pass" ) & " both tests" & IF ( ISBLANK ( fp ), "", "; the " & SWITCH ( fp, "GI-01", "booking app", "GI-02", "kiosks", "GI-03", "energy programme", "GI-04", "Toronto extension", "GI-05", "Gatwick extension", "GI-06", "Kingston extension", "GI-07", "refresh", "GI-08", "Boston hotel", "GI-09", "breakfast upgrade", "GI-10", "revenue management system", "" ) & IF ( pl, " earn ", " earns " ) & ( VAR __p = ( fy ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost but " & IF ( pl, "pay", "pays" ) & " back after " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: f6a8d74e-cd60-5ac2-98c3-3986ae2047ac

	/// Hero caption (review round 2, J-AQ-7): what a year on cost means, and which moves marked not now cost more than the budget left after the tranches.
	measure 'Hero Caption (text)' = VAR rem = [Not Needed Capex] VAR big = FILTER ( ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "not now" ), "@p", MoveDecision[ProjectID] ), "@c", LOOKUPVALUE ( InvestmentProjects[CapexUSD], InvestmentProjects[ProjectID], [@p] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ) ), [@c] > rem ) RETURN "A year on cost = operating profit added in " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & " ÷ capex." & IF ( COUNTROWS ( big ) > 0, " Not now: " & CONCATENATEX ( big, SWITCH ( [@p], "GI-01", "App", "GI-02", "Kiosks", "GI-03", "Energy", "GI-04", "Toronto +40", "GI-05", "Gatwick +40", "GI-06", "Kingston +40", "GI-07", "refresh", "GI-08", "Boston", "GI-09", "Breakfast", "GI-10", "Revenue management", "" ), " and ", [@o], ASC ) & IF ( COUNTROWS ( big ) = 1, " exceeds the ", " exceed the " ) & ( VAR __v = ( rem ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " left.", "" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 20357d27-f28a-584b-ab07-778df7e78d08

	/// Decision card: A's 'a year on cost', scenario in view.
	measure 'Rec A Year on Cost (text)' = ( VAR __p = ( [Rec A Year on Cost (sel)] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 338c6458-504b-5f40-bf68-28eeda6807d8

	/// Decision card, line 1 (R-P2-6; review round 2, DS2-09): the downside in the Low case; in the Low view, where the four numbers already show it, the Expected case instead.
	measure 'Rec Line 1 (text)' = VAR rr = [Rec Run-rate Low] RETURN IF ( [Selected Scenario] = "Low", "Expected case: " & ( VAR __v = ( [Rec NPV Expected] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & " and " & ( VAR __v = ( [Rec Run-rate Expected] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ".", "Low case: " & ( VAR __v = ( [Rec NPV Low] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ", " & IF ( rr > 0, "still ", "" ) & ( VAR __v = ( rr ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 67815844-3fbc-53db-a271-b5c39482d257

	/// Decision card, line 2 (R-P2-6, E13): what the booking app earns on its own (NPV through 2032, or the yearly figure when A does not pay back by 2032; the measure is named), and what each year without it leaves with the agencies.
	measure 'Rec Line 2 (text)' = VAR npv = [Rec NPV (sel)] RETURN "The app alone: " & IF ( ROUND ( npv / 100000, 0 ) < 0, ( VAR __v = ( [App Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ), ( VAR __v = ( [App NPV (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) ) & ". Every year without it leaves about " & ( VAR __v = ( [App Commission Saving (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " with the agencies."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 2fec4c4d-c1f4-5307-95da-c3d906a5bea1

	/// Decision card, both lines with a line break (alt text and tables; on the canvas two cards, spike S-7).
	measure 'Rec Lines (text)' = [Rec Line 1 (text)] & UNICHAR ( 10 ) & [Rec Line 2 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 60da4e88-dd24-5a4b-b18c-f50955f26fa6

	/// Decision card: the ink of A's NPV, Burnt Tangerine when the shown value is below zero (the sign carries it too), Night otherwise.
	measure 'Rec NPV Ink' = IF ( ROUND ( [Rec NPV (sel)] / 100000, 0 ) < 0, "#A63F0E", "#12233D" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 987379d2-3759-5611-997c-6cfdacb562a6

	/// Decision card: the ink of A's profit a year by 2032, Burnt Tangerine when the shown value is below zero, Night otherwise.
	measure 'Rec Run-rate Ink' = IF ( ROUND ( [Rec Run-rate (sel)] / 100000, 0 ) < 0, "#A63F0E", "#12233D" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: e600fd1d-4312-5ed2-9ebe-cd9a21df6939

	/// The decision card's head read aloud: the recommendation and its moves, named as the hero table names them, read from the package.
	measure 'Alt Rec Head (text)' = VAR a = [Recommended Package] RETURN "Our recommendation: package A. " & CONCATENATEX ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), LOOKUPVALUE ( InvestmentProjects[Move Name], InvestmentProjects[ProjectID], PackageProject[ProjectID] ), " + ", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], PackageProject[ProjectID] ), ASC ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: f41daa73-d0c2-55d6-8ae0-91054130aa5c

	/// The ledger read aloud (build step 10: shortened from the row-by-row reading of step 6, which ran to 760 characters): each finding with its status words; what we track and the two values are read cell by cell inside the table.
	measure 'Alt Ledger (text)' = "What package A changes for each finding by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ", " & [Selected Scenario] & " case. " & CONCATENATEX ( ALLNOBLANKROW ( Finding ), Finding[Label] & ": " & [Ledger Status (text)], "; ", Finding[Ledger Sort], ASC ) & ". The table gives what we track and both values."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 9db36d62-5c11-58b2-916a-f529d2d8542e

	/// Ledger F4: the rise in check-in and waiting complaints per 1,000 room nights sold at the hotels the kiosk move of package A covers, 2021 to 2025 (the organisers' GuestComplaints sheet).
	measure 'Kiosk Check-in Complaints Rise %' = VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "IV" ), MoveDecision[ProjectID] ) VAR kh = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kp ), "@h", InvestmentProjectProperties[HotelID] ) VAR r0 = CALCULATE ( DIVIDE ( CALCULATE ( SUM ( GuestComplaints[Complaints] ), GuestComplaints[Category] = "Check-in & waiting times" ), [Rooms Sold] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021, REMOVEFILTERS ( Hotels ), TREATAS ( kh, Hotels[HotelID] ) ) VAR r1 = CALCULATE ( DIVIDE ( CALCULATE ( SUM ( GuestComplaints[Complaints] ), GuestComplaints[Category] = "Check-in & waiting times" ), [Rooms Sold] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, REMOVEFILTERS ( Hotels ), TREATAS ( kh, Hotels[HotelID] ) ) RETURN DIVIDE ( r1, r0 ) - 1
		formatString: 0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: b6fdb216-876a-5093-be40-37b8cd19817a

	/// Ledger, 'What we track' (R-P2-5, doc 22 section 4; review round 2: DS2-07, INV-RK-6, J-AQ-9): the measure, a line break, the move(s) that act on it. F4 tracks one thing, the kiosk hotels, and says why they get kiosks (check-in complaints there); F3 tracks the NPS of the hotels last renovated ten or more years ago, the number the refresh is about.
	measure 'Ledger Measure (text)' = VAR c = SELECTEDVALUE ( Finding[Code] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "IV" ), MoveDecision[ProjectID] ) VAR rp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Finding] = "III" && MoveDecision[Tranche] = 3 ), MoveDecision[ProjectID] ) VAR s = [Selected Scenario] RETURN SWITCH ( c, "II", "distribution cost, % of room revenue" & UNICHAR ( 10 ) & "booking app with member rates", "I", "operating margin after commissions" & UNICHAR ( 10 ) & "app + revenue management + kiosks", "IV", "self check-in at the " & COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kp ) ) & " busiest hotels" & UNICHAR ( 10 ) & "kiosks; check-in complaints there up " & FORMAT ( [Kiosk Check-in Complaints Rise %], "0%", "en-US" ) & " since 2021", "III", "NPS, hotels renovated 10+ years ago" & UNICHAR ( 10 ) & "the refresh: see What waits, and why" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 2131a4db-d79d-5d43-87c7-0137bb08f416

	/// Ledger, 2025: distribution cost and the margin after commissions as they were; no kiosk hotel yet; the NPS of the hotels last renovated ten or more years ago (F3's own number).
	measure 'Ledger 2025 (text)' = VAR c = SELECTEDVALUE ( Finding[Code] ) VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "IV" ), MoveDecision[ProjectID] ) VAR v3 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, Hotels[Renovation Age Sort] = 3 ) RETURN SWITCH ( c, "II", ( VAR __p = ( [Dist Cost % 2025 GI] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ), "I", ( VAR __p = ( [KPI Margin after GI] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ), "IV", "0", "III", ( VAR __q = ( v3 ) RETURN IF ( ROUND ( __q, 1 ) = 0, "0.0", IF ( __q < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __q ), "0.0", "en-US" ) ) ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 7c44dc34-fca2-53ad-8705-0e8a898bea5c

	/// Ledger, 2032 with A (metric contracts M-102, M-103): the 2025 brand plus A's full yearly effect, in 2025 dollars, scenario in view.
	measure 'Ledger 2032 (text)' = VAR c = SELECTEDVALUE ( Finding[Code] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "IV" ), MoveDecision[ProjectID] ) VAR rp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Finding] = "III" && MoveDecision[Tranche] = 3 ), MoveDecision[ProjectID] ) VAR rooms = SUMX ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[AddedRooms] ), InvestmentProjects[ProjectID] IN aIds ), InvestmentProjects[AddedRooms] ) + 0 RETURN SWITCH ( c, "II", ( VAR __p = ( [Dist Cost % 2032 with A (sel)] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ), "I", ( VAR __p = ( [Margin after 2032 with A (sel)] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ), "IV", FORMAT ( IF ( kp IN aIds, COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kp ) ), 0 ), "0", "en-US" ), "III", IF ( rp IN aIds, "in A", "not in A" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: cfc63fe7-22cf-5e54-985b-e4560c6b6c07

	/// Ledger status words (P-6): the share of the 2021-2025 rise in distribution cost that A undoes and of the 2023-2025 fall in the margin it recovers, in words; F4 and F3 wait for the gate.
	measure 'Ledger Status (text)' = VAR c = SELECTEDVALUE ( Finding[Code] ) RETURN SWITCH ( c, "II", ( VAR __x = [Dist Cost Rise Undone % (sel)] RETURN SWITCH ( TRUE (), __x <= 0, "none of", __x < 0.2, "a little of", __x < 0.3, "a quarter of", __x < 0.4, "a third of", __x < 0.6, "half", __x < 0.7, "two thirds of", __x < 0.85, "three quarters of", __x < 1, "most of", "all of" ) ) & " the rise undone", "I", ( VAR __x = [Margin Fall Recovered % (sel)] RETURN SWITCH ( TRUE (), __x <= 0, "none of", __x < 0.2, "a little of", __x < 0.3, "a quarter of", __x < 0.4, "a third of", __x < 0.6, "half", __x < 0.7, "two thirds of", __x < 0.85, "three quarters of", __x < 1, "most of", "all of" ) ) & " the fall recovered", "IV", "rooms: at the 2028 gate", "III", "decided at the 2028 gate" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 016e5dd0-586a-58df-bf94-8616d2ce8222

	/// Capital plan title (R-P2-7): the budget, tranche 1 now and the decisions at the gate.
	measure 'Capital Plan Title (text)' = VAR k = COUNTROWS ( FILTER ( { [Tranche 2 Capex], [Tranche 3 Capex] }, [Value] > 0 ) ) RETURN "The $" & FORMAT ( CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) / 1000000, "#,0", "en-US" ) & "M plan: " & ( VAR __v = ( [Tranche 1 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " now, " & ( VAR __v = ( [Tranche 2 Capex] + [Tranche 3 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " at the 2028 gate, " & ( VAR __v = ( [Not Needed Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " not needed"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 91081d48-99f4-5e20-bf8b-18a5246d96dd

	/// Capital plan, the label of segment 1, line 1 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T1 L1 (text)' = "Tranche 1 · package A"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: fb6862fc-da95-54e3-9080-f9abfe269d8f

	/// Capital plan, the label of segment 1, line 2 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T1 L2 (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR y1 = YEAR ( CALCULATE ( MIN ( InvestmentProjects[Planned Start] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( aIds, InvestmentProjects[ProjectID] ) ) ) RETURN ( VAR __v = ( [Tranche 1 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " · " & y1
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 3e7641a4-4e89-58f5-9ab4-553152ae77ff

	/// Capital plan, the label of segment 1, all lines with line breaks.
	measure 'Plan T1 (text)' = [Plan T1 L1 (text)] & UNICHAR ( 10 ) & [Plan T1 L2 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 16440f5d-a154-5a91-ab4a-83609bf37152

	/// Capital plan, the label of segment 2, line 1 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T2 L1 (text)' = VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) RETURN "Tranche 2 · " & CONCATENATEX ( th, [@n], " and ", [@o], ASC ) & " +" & MAXX ( th, [@r] ) & " rooms"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8c03794f-8c71-5a44-99f0-473a64d0508c

	/// Capital plan, the label of segment 2, line 2 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T2 L2 (text)' = ( VAR __v = ( [Tranche 2 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " · 2028 gate"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 9fc7fc1a-195f-5ab3-aa82-5dc7acbb0193

	/// Capital plan, the label of segment 2, line 3 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T2 L3 (text)' = ( VAR __v = ( [Tranche 2 Run-rate] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year once live · " & ( VAR __p = ( [Tranche 2 Year on Cost] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 592afa66-fef1-506e-a664-531850b3035d

	/// Capital plan, the label of segment 2, all lines with line breaks.
	measure 'Plan T2 (text)' = [Plan T2 L1 (text)] & UNICHAR ( 10 ) & [Plan T2 L2 (text)] & UNICHAR ( 10 ) & [Plan T2 L3 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: f6b4f477-d3db-5c11-bbbf-e7144ad04e43

	/// Capital plan, the label of segment 3, line 1 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T3 L1 (text)' = VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 3 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) RETURN "Tranche 3 · the " & SWITCH ( MAXX ( th, [@p] ), "GI-01", "booking app", "GI-02", "kiosks", "GI-03", "energy programme", "GI-04", "Toronto extension", "GI-05", "Gatwick extension", "GI-06", "Kingston extension", "GI-07", "refresh", "GI-08", "Boston hotel", "GI-09", "breakfast upgrade", "GI-10", "revenue management system", "" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 45fbecb5-2a0c-5ff3-b310-6b704c8bbc56

	/// Capital plan, the label of segment 3, line 2 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T3 L2 (text)' = ( VAR __v = ( [Tranche 3 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " · 2028 gate, only with a case beyond " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 367af642-26ae-5975-8830-380ba88a733f

	/// Capital plan, the label of segment 3, line 3 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T3 L3 (text)' = ( VAR __v = ( [Tranche 3 Run-rate] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year once live · " & ( VAR __p = ( [Tranche 3 Year on Cost] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 6b4aad43-4945-5c36-b7f4-7bdee15fd366

	/// Capital plan, the label of segment 3, all lines with line breaks.
	measure 'Plan T3 (text)' = [Plan T3 L1 (text)] & UNICHAR ( 10 ) & [Plan T3 L2 (text)] & UNICHAR ( 10 ) & [Plan T3 L3 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 94cffbbb-3639-51c3-838f-737b0a27217d

	/// Capital plan, the label of segment 4, line 1 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T4 L1 (text)' = "Not needed · " & ( VAR __v = ( [Not Needed Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 664bd8e5-0cc4-54fa-be44-f44fa5d0eff0

	/// Capital plan, the label of segment 4, line 2 (one card callout per line: a card value never breaks a line, spike S-7).
	measure 'Plan T4 L2 (text)' = "stays with the group"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 4d848140-412a-5f79-821c-d2cee26eba22

	/// Capital plan, the label of segment 4, all lines with line breaks.
	measure 'Plan T4 (text)' = [Plan T4 L1 (text)] & UNICHAR ( 10 ) & [Plan T4 L2 (text)]
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: bca77378-af5c-5409-a398-5bbd49adc4fe

	/// The gate rule (R-P2-7; review round 2: INV-CA-6, INV-RK-5, INV-RK-6), the one release rule of the report. The 0.6 points are the app's Expected-case change in distribution cost at the first-year ramp-up (FinanceParameters): where the Expected case stands at a mid-2028 meeting.
	measure 'Gate Rule (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR appIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "II" ), "@p", MoveDecision[ProjectID] ) VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR pts = - CALCULATE ( SUM ( InvestmentScenarios[DistributionCostChangePts] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( appIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = "Expected" ) * LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Ramp-up - first year after completion" ) * 100 RETURN "The 2028 gate: one Board meeting once all " & ( VAR __n = COUNTROWS ( aIds ) RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " moves are live. It releases tranche 2 if the first money worked (distribution cost down " & FORMAT ( pts, "0.0", "en-US" ) & " points or more, the Expected track) and " & CONCATENATEX ( th, [@n], " and ", [@o], ASC ) & " topped 90% in 6 of the last 12 months. A rule, not a forecast."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 1b0a5773-64af-5a87-895e-509c7c69a1fb

	/// The gate in one line for the What-waits table (When we decide); the full rule is Gate Rule (text).
	measure 'Gate Rule Short (text)' = "2028 gate: if the first money worked and both stay full."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 68a5d61c-e817-56a5-b80b-9d460547ef84

	/// Capital plan milestone strip: the go-live of A's moves in order, the dependency, and the year A turns cash positive (undiscounted cumulative), scenario in view.
	measure 'Milestones (text)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR t = ADDCOLUMNS ( aIds, "@d", LOOKUPVALUE ( InvestmentProjects[Completion Date], InvestmentProjects[ProjectID], [@p] ), "@dep", LOOKUPVALUE ( InvestmentProjects[DependsOn], InvestmentProjects[ProjectID], [@p] ) ) VAR pb = [Preset A Payback Year] RETURN "Live: " & CONCATENATEX ( t, LOWER ( SWITCH ( [@p], "GI-01", "App", "GI-02", "Kiosks", "GI-03", "Energy", "GI-04", "Toronto +40", "GI-05", "Gatwick +40", "GI-06", "Kingston +40", "GI-07", "refresh", "GI-08", "Boston", "GI-09", "Breakfast", "GI-10", "Revenue management", "" ) ) & " " & FORMAT ( [@d], "mmm yyyy", "en-US" ) & IF ( [@dep] <> "", " (" & IF ( ( [@p] IN { "GI-02" } ), "they need", "it needs" ) & " the " & LOWER ( SWITCH ( [@dep], "GI-01", "App", "GI-02", "Kiosks", "GI-03", "Energy", "GI-04", "Toronto +40", "GI-05", "Gatwick +40", "GI-06", "Kingston +40", "GI-07", "refresh", "GI-08", "Boston", "GI-09", "Breakfast", "GI-10", "Revenue management", "" ) ) & ")", "" ), " · ", [@d], ASC ) & " · " & IF ( ISBLANK ( pb ), "Not cash positive by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ), "Cash positive during " & pb ) & " (" & [Selected Scenario] & ")"
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: a041666e-4a3a-5c48-993c-84f2fba3a944

	/// Hero row: the text colour of the status word (Deep Coffee for package A, Night for the 2028 gate, Dusk for not now). The bars keep the mark colours (Move Status Color).
	measure 'Move Status Ink' = VAR st = LOOKUPVALUE ( MoveDecision[Status], MoveDecision[ProjectID], SELECTEDVALUE ( InvestmentProjects[ProjectID] ) ) RETURN IF ( ISBLANK ( st ), BLANK (), SWITCH ( st, "A", "#1763A8", "2028 gate", "#12233D", "#4B5466" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: c19569d0-ba81-5495-bba8-177ec1b61a85

	/// Hero row: the ink of the move's NPV, Burnt Tangerine when the shown value is below zero (the sign carries it too), Night otherwise.
	measure 'Move NPV Ink' = VAR v = [Move NPV (num)] RETURN IF ( ROUND ( v / 10000, 0 ) < 0, "#A63F0E", "#12233D" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 78c2b4bb-717c-56da-a17e-d60f6aef7133

	/// The hero table read aloud (build step 10: under 250 characters): what it ranks, the first move with both numbers, and what the two reference lines mean. The title's verdict is the tab stop before it; the rows are read cell by cell inside the table.
	measure 'Alt Hero (text)' = VAR t = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Brand], InvestmentProjects[Hero Sort] ), InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID], "@o", InvestmentProjects[Hero Sort] ), "@y", VAR p = [@p] RETURN CALCULATE ( [A Year on Cost], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR s = [Selected Scenario] VAR top1 = TOPN ( 1, t, [@o], ASC ) RETURN "The ten moves ranked by what each earns a year on its cost, " & s & " case, with the finding each answers, its status and its NPV through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ". First: " & CONCATENATEX ( top1, LOOKUPVALUE ( InvestmentProjects[Move Name], InvestmentProjects[ProjectID], [@p] ) & ", " & ( VAR __p = ( [@y] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost, NPV " & ( VAR __v = ( [@v] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), "; " ) & ". The two marked lines are our " & FORMAT ( LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ), "0%", "en-US" ) & " cost of money and NPV zero."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: a7b5ff8a-2a35-5f76-ade7-a430d3cfa25c

	/// The capital plan bar read aloud (build step 10: the message and the four amounts; each segment's own label is a tab stop above the bar).
	measure 'Alt Plan Bar (text)' = "How the $" & FORMAT ( CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) / 1000000, "#,0", "en-US" ) & "M budget is planned: tranche 1, package A, " & ( VAR __v = ( [Tranche 1 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " now; tranche 2, " & ( VAR __v = ( [Tranche 2 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ", and tranche 3, " & ( VAR __v = ( [Tranche 3 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ", wait for the 2028 gate; " & ( VAR __v = ( [Not Needed Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " is not needed."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 4eb48b17-da97-53b1-9e84-d5889ccde30d

	/// The capital plan's cumulative chart read aloud: the three end points, the cash-positive year in the case in view, and the gate.
	measure 'Alt Plan Cum (text)' = VAR pb = [Preset A Payback Year] VAR s = [Selected Scenario] VAR hz = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) RETURN "Package A, cumulative cash by year to " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ", not discounted, in the three cases. By " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ": Low " & ( VAR __v = ( CALCULATE ( [TT Year A (Low)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = hz ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ", Expected " & ( VAR __v = ( CALCULATE ( [TT Year A (Expected)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = hz ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ", High " & ( VAR __v = ( CALCULATE ( [TT Year A (High)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = hz ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ". In the " & s & " case " & IF ( ISBLANK ( pb ), "A is not cash positive by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ), "A is cash positive from " & pb ) & ". The Board decides on the rest at the 2028 gate."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 0cceffcb-c65f-5fa9-9f6a-b186c9218717

	/// Proof chart title (R-W-1): every package the contest rules allow, and how many beat A's NPV through 2032 in the case in view (none, in all three).
	measure 'Proof Title (text)' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) VAR av = [Rec NPV (sel)] VAR beat = COUNTROWS ( FILTER ( t, [@v] > av ) ) + 0 RETURN IF ( beat = 0, "None", FORMAT ( beat, "0", "en-US" ) ) & " of the " & COUNTROWS ( t ) & " packages " & IF ( beat <= 1, "beats A", "beat A" ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: e9f35ecd-10c2-5c13-abf2-1efb8922ee59

	/// Proof chart subtitle: how many packages pay back by 2032 in the case in view and the $5M step above the largest of them.
	measure 'Proof Subtitle (text)' = VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( ALLNOBLANKROW ( Package ), "@v", SWITCH ( s, "Low", Package[NPV Low], "High", Package[NPV High], Package[NPV Expected] ) ) VAR pos = FILTER ( t, [@v] >= 0 ) VAR k = COUNTROWS ( pos ) + 0 VAR cap = ( INT ( MAXX ( pos, Package[CapexUSD] ) / 5000000 ) + 1 ) * 5 RETURN IF ( k = 0, "None pays back by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ".", "Only " & k & IF ( k = 1, " pays", " pay" ) & " back by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & IF ( k = 1, ", under $", ", all under $" ) & cap & "M." ) & " Each dot is a package."
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 1dc5368a-c4e3-5605-98db-f84478519337

	/// What waits, 'The numbers' (R-W-2): four lines per option, scenario in view; the tranches show no NPV (a gated start is not modelled), the refresh its package C for reference.
	measure 'Wait Numbers (text)' = VAR k = SELECTEDVALUE ( WaitOption[Key] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR b = [Preset B Package] VAR bIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = b ), "@p", PackageProject[ProjectID] ) VAR capA = [Rec Capex] VAR capB = [Preset B Capex] VAR npvA = [Rec NPV (sel)] VAR npvB = [Preset B NPV (sel)] VAR cP = [Preset C Package] VAR cIds = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = cP ), "@p", PackageProject[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ) ) VAR bLo = CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = b ) VAR bHi = CALCULATE ( SUM ( Package[NPV High] ), REMOVEFILTERS ( Package ), Package[PackageID] = b ) RETURN SWITCH ( k, "B", ( VAR __v = ( capB ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " capex" & UNICHAR ( 10 ) & ( VAR __v = ( npvB ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " NPV through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & UNICHAR ( 10 ) & ( VAR __v = ( [Preset B Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & UNICHAR ( 10 ) & "Low " & ( VAR __v = ( bLo ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " · High " & ( VAR __v = ( bHi ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), "T2", ( VAR __v = ( [Tranche 2 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " capex" & UNICHAR ( 10 ) & ( VAR __v = ( [Tranche 2 Run-rate] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year once live" & UNICHAR ( 10 ) & ( VAR __p = ( [Tranche 2 Year on Cost] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost", "T3", ( VAR __v = ( [Tranche 3 Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " capex" & UNICHAR ( 10 ) & ( VAR __v = ( [Tranche 3 Run-rate] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " a year once live" & UNICHAR ( 10 ) & ( VAR __p = ( [Tranche 3 Year on Cost] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost" & UNICHAR ( 10 ) & "in package C: " & ( VAR __v = ( [Preset C NPV (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 6a85cf65-3d1b-5608-89dd-499aa3d9037f

	/// What waits, 'Why it's on the table' (R-W-2): B's wider guest-score reach, the airports' months above 90 %, and the hotels renovated last against the rest of the brand (NPS 2021 to 2025).
	measure 'Wait Why (text)' = VAR k = SELECTEDVALUE ( WaitOption[Key] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR b = [Preset B Package] VAR bIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = b ), "@p", PackageProject[ProjectID] ) VAR capA = [Rec Capex] VAR capB = [Preset B Capex] VAR npvA = [Rec NPV (sel)] VAR npvB = [Preset B NPV (sel)] VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR gh = CALCULATETABLE ( VALUES ( Hotels[HotelID] ), REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[Brand] = "Goodnight Inn" ) VAR ly = MAXX ( gh, YEAR ( LOOKUPVALUE ( Hotels[LastRenovationDate], Hotels[HotelID], Hotels[HotelID] ) ) ) VAR grp = FILTER ( gh, YEAR ( LOOKUPVALUE ( Hotels[LastRenovationDate], Hotels[HotelID], Hotels[HotelID] ) ) = ly ) VAR rest = EXCEPT ( gh, grp ) VAR nh = COUNTROWS ( gh ) VAR rA = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = a ) VAR rB = CALCULATE ( SUM ( Package[HotelsRated] ), REMOVEFILTERS ( Package ), Package[PackageID] = b ) VAR g21 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( grp, Hotels[HotelID] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR g25 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( grp, Hotels[HotelID] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR r21 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( rest, Hotels[HotelID] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR r25 = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), TREATAS ( rest, Hotels[HotelID] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN SWITCH ( k, "B", "Lifts guest scores in " & IF ( rB = nh, "all ", "" ) & rB & " hotels, not " & rA & ".", "T2", VAR mx = MAXX ( th, [@m] ) RETURN CONCATENATEX ( th, [@n] & IF ( [@m] = mx, " topped 90% in " & [@m] & " of the last 24 months", " in " & [@m] ), ", ", [@m], DESC, [@o], ASC ) & ".", "T3", "Renovation works: the " & ( VAR __n = COUNTROWS ( grp ) RETURN SWITCH ( __n, 0, "no", 1, "one", 2, "two", 3, "three", 4, "four", 5, "five", 6, "six", 7, "seven", 8, "eight", 9, "nine", 10, "ten", FORMAT ( __n, "0", "en-US" ) ) ) & " hotels whose renovation finished in " & ly & IF ( ROUND ( g25, 0 ) = ROUND ( g21, 0 ), " held NPS near ", " moved NPS to " ) & ( VAR __i = ROUND ( g25, 0 ) RETURN IF ( __i < 0, UNICHAR ( 8722 ), IF ( __i > 0, "+", "" ) ) & FORMAT ( ABS ( __i ), "0", "en-US" ) ) & " while the rest " & IF ( r25 < r21, "fell", "rose" ) & " to " & ( VAR __q = ( r25 ) RETURN IF ( ROUND ( __q, 1 ) = 0, "0.0", IF ( __q < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __q ), "0.0", "en-US" ) ) ) & "." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 5078aef3-bb05-533d-a25c-5ebab8752550

	/// What waits, 'Why not now' (R-W-2; doc 22 section 6, question 2): B against A, the airports' NPV through 2032, and the refresh against our cost of money (at or above 8 %, only High, it says that it still does not pay back by 2032).
	measure 'Wait WhyNot (text)' = VAR k = SELECTEDVALUE ( WaitOption[Key] ) VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR b = [Preset B Package] VAR bIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = b ), "@p", PackageProject[ProjectID] ) VAR capA = [Rec Capex] VAR capB = [Preset B Capex] VAR npvA = [Rec NPV (sel)] VAR npvB = [Preset B NPV (sel)] VAR kp = MAXX ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "IV" ), MoveDecision[ProjectID] ) VAR th0 = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ), "@r", LOOKUPVALUE ( InvestmentProjects[AddedRooms], InvestmentProjects[ProjectID], [@p] ), "@h", VAR p = [@p] RETURN MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = p ), InvestmentProjectProperties[HotelID] ) ) VAR th = ADDCOLUMNS ( th0, "@n", LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], [@h] ), "@m", VAR h = [@h] RETURN CALCULATE ( [Months Topped 90% (last 24)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = h ), "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR rrA = [Rec Run-rate (sel)] VAR rrB = [Preset B Run-rate (sel)] VAR dr = ( ROUND ( rrB / 100000, 0 ) - ROUND ( rrA / 100000, 0 ) ) * 100000 VAR yA = [Rec A Year on Cost (sel)] VAR yB = DIVIDE ( rrB, capB ) VAR dc = capB - capA VAR dn = ( ROUND ( npvA / 100000, 0 ) - ROUND ( npvB / 100000, 0 ) ) * 100000 VAR nNeg = COUNTROWS ( FILTER ( th, ROUND ( [@v] / 100000, 0 ) < 0 ) ) VAR t3y = [Tranche 3 Year on Cost] VAR rate = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Discount rate" ) VAR ext = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Category], InvestmentProjects[Brand] ), InvestmentProjects[Category] = "Expansion" && InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID] ) VAR t2g = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ) VAR kx = MAXX ( EXCEPT ( ext, t2g ), [@p] ) VAR kh = MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kx ), InvestmentProjectProperties[HotelID] ) RETURN SWITCH ( k, "B", ( VAR __v = ( ABS ( dc ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & IF ( dc >= 0, " more", " less" ) & " than A for " & ( VAR __v = ( ABS ( dr ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & IF ( dr >= 0, " more", " less" ) & " a year: " & IF ( ROUND ( yA, 3 ) = ROUND ( yB, 3 ), "the same " & ( VAR __p = ( yA ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost", ( VAR __p = ( yB ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost against A's " & ( VAR __p = ( yA ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) ) & ", and " & ( VAR __v = ( ABS ( dn ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & IF ( dn >= 0, " less", " more" ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "." & IF ( kp IN aIds && NOT ( kp IN bIds ), " The queues at the " & COUNTROWS ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kp ) ) & " busiest hotels stay.", "" ), "T2", SWITCH ( nNeg, COUNTROWS ( th ), "Neither pays back by ", 0, "Both pay back by ", "Only one pays back by " ) & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & " (" & CONCATENATEX ( th, ( VAR __v = ( [@v] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), ", ", [@m], DESC, [@o], ASC ) & ")." & IF ( COUNTROWS ( EXCEPT ( ext, t2g ) ) = 1, " " & LOOKUPVALUE ( Hotels[Copy Name], Hotels[HotelID], kh ) & " (" & FORMAT ( CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), Hotels[HotelID] = kh ), "0%", "en-US" ) & " full) is not on the list.", "" ), "T3", ( VAR __p = ( t3y ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) & " a year on cost" & IF ( ROUND ( t3y, 3 ) >= rate, " but does not pay back by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & " (" & ( VAR __v = ( [Tranche 3 NPV] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ")", IF ( rate - t3y < 0.005, ", just under our ", ", under our " ) & FORMAT ( rate, "0%", "en-US" ) ) & ". The data cannot price the cost of waiting, so this case is understated." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: cfa2393f-0d34-519e-bc3a-4ab6ed3700fc

	/// NPV through 2032 of tranche 3 (the refresh) alone, scenario in view; said only where 'a year on cost' alone would mislead (What waits, High).
	measure 'Tranche 3 NPV' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 3 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 084b8cf4-7b4f-5b9f-a912-54b170b22c87

	/// What waits, 'When we decide' (R-W-2): B is not planned; the tranches come back at the gate (the short rule), with the extension that is not on the list.
	measure 'Wait When (text)' = VAR k = SELECTEDVALUE ( WaitOption[Key] ) VAR ext = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( InvestmentProjects[ProjectID], InvestmentProjects[Category], InvestmentProjects[Brand] ), InvestmentProjects[Category] = "Expansion" && InvestmentProjects[Brand] = "Goodnight Inn" ), "@p", InvestmentProjects[ProjectID] ) VAR t2 = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ) VAR kx = MAXX ( EXCEPT ( ext, t2 ), [@p] ) VAR kh = MAXX ( FILTER ( ALLNOBLANKROW ( InvestmentProjectProperties ), InvestmentProjectProperties[ProjectID] = kx ), InvestmentProjectProperties[HotelID] ) RETURN SWITCH ( k, "B", "Not planned.", "T2", [Gate Rule Short (text)], "T3", "2028 gate, with a case beyond " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "." )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 702376ce-c68f-5b38-8a2b-e496e5ee3e84

	/// Title of the comparison chart in What waits (R-W-3, R-G2): B against A by 2032, and whether C turns cash positive by 2032, scenario in view.
	measure 'Cmp Alts Title (text)' = VAR cP = [Preset C Package] VAR cIds = ADDCOLUMNS ( SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = cP ), "@p", PackageProject[ProjectID] ), "@o", LOOKUPVALUE ( InvestmentProjects[Hero Sort], InvestmentProjects[ProjectID], [@p] ) ) VAR a32 = CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR b32 = CALCULATE ( [Preset B Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR pbC = [Preset C Payback Year] RETURN "Cumulative cash, not discounted, $M: B " & IF ( ABS ( a32 - b32 ) < 1000000, "ends within $1M of A", IF ( b32 < a32, "trails A by ", "ends ahead of A by " ) & ( VAR __v = ( ABS ( a32 - b32 ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) ) & " by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "; C (" & CONCATENATEX ( cIds, LOWER ( SWITCH ( [@p], "GI-01", "App", "GI-02", "Kiosks", "GI-03", "Energy", "GI-04", "Toronto +40", "GI-05", "Gatwick +40", "GI-06", "Kingston +40", "GI-07", "refresh", "GI-08", "Boston", "GI-09", "Breakfast", "GI-10", "Revenue management", "" ) ), ", ", [@o], ASC ) & ") " & IF ( ISBLANK ( pbC ), "is not cash positive by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ), "is cash positive from " & pbC )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: dcc92f7c-7694-5eb4-aedb-c576027f0de8

	/// Value axis start of the comparison chart in What waits: the whole step under the lowest point of its lines (2027 to 2032, scenario in view), one step under zero when nothing is negative.
	measure 'Cmp Alts Y Start' = VAR h = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) VAR t = GENERATE ( SELECTCOLUMNS ( GENERATESERIES ( 2027, h, 1 ), "@y", [Value] ), VAR y = [@y] RETURN UNION ( ROW ( "@v", CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y ) ), ROW ( "@v", CALCULATE ( [Preset B Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y ) ), ROW ( "@v", CALCULATE ( [Preset C Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y ) ) ) ) VAR mn = MIN ( MINX ( t, [@v] ), 0 ) / 1000000 VAR mx0 = MAX ( MAXX ( t, [@v] ), 0 ) / 1000000 VAR mx = mx0 + ( mx0 - mn ) * 0.08 VAR span = IF ( mx - mn = 0, 1, mx - mn ) VAR mag = POWER ( 10, INT ( LOG10 ( span / 5 ) ) ) VAR step = MINX ( FILTER ( { 1, 2, 2.5, 5, 10 }, span / ( [Value] * mag ) <= 6 ), [Value] ) * mag VAR lo0 = INT ( mn / step ) * step VAR hi0 = - INT ( - mx / step ) * step RETURN IF ( lo0 = 0, - step, lo0 ) * 1000000
		formatString: 0
		displayFolder: 15 Storytelling rebuild
		lineageTag: 5b46c290-8617-5ddc-8fb8-c36dfc6ccf3c

	/// Value axis end of the comparison chart in What waits: the whole step above the highest point of its lines plus 8 % of their span, so a label above the top line stays inside the plot.
	measure 'Cmp Alts Y End' = VAR h = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) VAR t = GENERATE ( SELECTCOLUMNS ( GENERATESERIES ( 2027, h, 1 ), "@y", [Value] ), VAR y = [@y] RETURN UNION ( ROW ( "@v", CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y ) ), ROW ( "@v", CALCULATE ( [Preset B Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y ) ), ROW ( "@v", CALCULATE ( [Preset C Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = y ) ) ) ) VAR mn = MIN ( MINX ( t, [@v] ), 0 ) / 1000000 VAR mx0 = MAX ( MAXX ( t, [@v] ), 0 ) / 1000000 VAR mx = mx0 + ( mx0 - mn ) * 0.08 VAR span = IF ( mx - mn = 0, 1, mx - mn ) VAR mag = POWER ( 10, INT ( LOG10 ( span / 5 ) ) ) VAR step = MINX ( FILTER ( { 1, 2, 2.5, 5, 10 }, span / ( [Value] * mag ) <= 6 ), [Value] ) * mag VAR lo0 = INT ( mn / step ) * step VAR hi0 = - INT ( - mx / step ) * step RETURN IF ( hi0 = 0, step, hi0 ) * 1000000
		formatString: 0
		displayFolder: 15 Storytelling rebuild
		lineageTag: 17847413-3b9e-54ce-bafb-d64c823756d3

	/// Package C's line in the comparison chart of What waits, in whole $M: it is the chart's first series (drawn under B and A), and a value axis prints its first series' format on every tick (build step 7).
	measure 'Preset C Cumulative Line' = [Preset C Cumulative Net (sel)]
		formatString: +\$#,0,,.\M;−\$#,0,,.\M;\$0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 661d37c2-b725-5393-8a8c-e8ddd479b14b

	/// The What-waits table read aloud (build step 10: shortened from the row-by-row reading of step 8, which ran to 1,300 characters): the three options and what each row holds; the cells are read inside the table.
	measure 'Alt Waits (text)' = "Three options weighed against A, " & [Selected Scenario] & " case: " & CONCATENATEX ( ALLNOBLANKROW ( WaitOption ), WaitOption[Title], "; ", WaitOption[Sort], ASC ) & ". For each: its numbers, why it is on the table, why not now and when we decide."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: f3ac2ccf-946e-5695-867b-c63fef0ad553

	/// Your plan: profit a year by 2032, scenario in view; empty while nothing is picked.
	measure 'Build Run-rate (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, "", ( VAR __v = ( [Build Run-rate (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 44d3762a-77ca-5a81-83dd-36a0a5a61caf

	/// Your plan: a year on cost, scenario in view; empty while nothing is picked.
	measure 'Build A Year on Cost (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, "", ( VAR __p = ( [Build A Year on Cost (sel)] ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 164ce22c-23e1-5ed8-b46f-54a4b8f8f09a

