	measure 'Build Bar Order' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR me = SELECTEDVALUE ( BuildBar[ProjectID] ) VAR pad = SELECTEDVALUE ( BuildBar[Pad] ) RETURN IF ( n > 0, IF ( me IN ids, CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = me ), IF ( pad > 0 && pad <= 5 - n, -1000000000000 - pad ) ) )
		formatString: 0
		displayFolder: 15 Storytelling rebuild
		lineageTag: 9e626e4b-9736-59e5-a99e-980dd299294b

	/// Build bar chart: where its zero line stands; blank while nothing is picked, so the empty chart draws no line.
