	/// What the booking app saves in commissions a year: its change in distribution cost (points of room revenue, scenario in view) on 2025 room revenue. Also what every year without it leaves with the agencies.
	measure 'App Commission Saving (sel)' = VAR appIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "F2" ), "@p", MoveDecision[ProjectID] ) VAR s = [Selected Scenario] VAR rr = CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN - CALCULATE ( SUM ( InvestmentScenarios[DistributionCostChangePts] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( appIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = s ) * rr
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 845720ab-573a-58ac-b14c-a95c8f27e7f1

	/// NPV through 2032 of the booking app alone (the move of A that answers F2), scenario in view.
	measure 'App NPV (sel)' = VAR appIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "F2" ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( appIds, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
