	/// Selector: the Goodnight Inn budget, repeated on every row (the footer's cap).
	measure 'Move Budget (num)' = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0
