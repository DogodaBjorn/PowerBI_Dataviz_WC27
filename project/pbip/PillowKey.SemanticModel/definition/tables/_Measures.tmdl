/// Measure home for the three sketches. Base measures read columns; everything else reads measures.
table _Measures
	lineageTag: 1458bfa0-b6ec-5a43-b70a-dba08e4c82c9

	/// Room nights on offer in the period.
	measure 'Rooms Available' = SUM ( MonthlyPerformance[RoomsAvailable] )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 15e620f0-72e5-5bb0-af92-a42e8b058465

	/// Room nights sold in the period.
	measure 'Rooms Sold' = SUM ( MonthlyPerformance[RoomsSold] )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: bc28c802-0b83-558e-bfc9-0a5f5e50f676

	/// Rooms sold over rooms available.
	measure 'Occupancy %' = DIVIDE ( [Rooms Sold], [Rooms Available] )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: 81edb257-d639-55c7-a515-2a1dc41d7d00

	/// Room revenue from MonthlyPerformance.
	measure 'Room Revenue' = SUM ( MonthlyPerformance[RoomRevenue] )
		formatString: \$#,0;(\$#,0)
		displayFolder: 01 Core
		lineageTag: 6c9fd4c1-1eab-582d-91bc-ac6adc59f88e

	/// Room, food and beverage and other revenue.
	measure 'Total Revenue' = SUM ( MonthlyPerformance[TotalRevenue] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 01 Core
		lineageTag: 611eda89-e11a-51f9-852c-84ad2869c1ed

	/// Average daily rate: room revenue per room night sold.
	measure ADR = DIVIDE ( [Room Revenue], [Rooms Sold] )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: 4e3b018b-5c85-54e6-b87b-03305e86610e

	/// Room revenue per available room night.
	measure RevPAR = DIVIDE ( [Room Revenue], [Rooms Available] )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: f991f809-aa2a-5bee-abc0-e2694d36590a

	/// Total operating expenses; excludes distribution cost (workbook convention).
	measure 'Operating Expenses' = SUM ( MonthlyPerformance[TotalOperatingExpenses] )
		formatString: \$#,0;(\$#,0)
		displayFolder: 01 Core
		lineageTag: c8e49cde-76f5-5dc3-a8e8-2d7ddd917544

	/// Gross operating profit before distribution cost.
	measure GOP = [Total Revenue] - [Operating Expenses]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 01 Core
		lineageTag: 9522763a-3950-59b3-b72b-5044bac9cc91

	/// GOP as a share of total revenue.
	measure 'GOP Margin %' = DIVIDE ( [GOP], [Total Revenue] )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: 79725232-88a8-572a-871e-1251de9a9e45

	/// Number of hotels in context.
	measure 'Hotels in Context' = DISTINCTCOUNT ( Hotels[HotelID] )
		formatString: #,0
		displayFolder: 01 Core
		lineageTag: 015b332f-be85-57fa-bc9c-2abf93898329

	/// Renovation capex since 2018 divided by the hotels in context.
	measure 'Renovation Spend per Hotel since 2018' = DIVIDE ( CALCULATE ( SUM ( Renovations[CostUSD] ), Renovations[StartDate] >= DATE ( 2018, 1, 1 ) ), [Hotels in Context] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 01 Core
		lineageTag: f8841b09-39ea-58eb-9629-f5a70a7189b2

	/// Room revenue by booking channel (reconciles to MonthlyPerformance).
	measure 'Channel Room Revenue' = SUM ( BookingChannels[RoomRevenue] )
		formatString: \$#,0;(\$#,0)
		displayFolder: 02 Channels
		lineageTag: 63c08a11-af6c-5f11-9d97-a3508d14034b

	/// Room nights by booking channel.
	measure 'Channel Room Nights' = SUM ( BookingChannels[RoomNights] )
		formatString: #,0
		displayFolder: 02 Channels
		lineageTag: 0c30643e-51b4-5929-a5d4-a0c86f8a8c92

	/// Commissions and fees paid to booking channels; outside operating expenses.
	measure 'Distribution Cost' = SUM ( BookingChannels[DistributionCost] )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 02 Channels
		lineageTag: 92403efb-edbf-551f-a49e-beb303313859

	/// Distribution cost as a share of room revenue.
	measure 'Distribution Cost % of Room Revenue' = DIVIDE ( [Distribution Cost], [Channel Room Revenue] )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: 2c9291bd-7430-52de-8a8f-c389672e9ee7

	/// A channel's share of room revenue in context.
	measure 'Channel Share %' = DIVIDE ( [Channel Room Revenue], CALCULATE ( [Channel Room Revenue], ALL ( BookingChannels[Channel] ) ) )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: bd865932-a5f0-5c0b-b548-c0f812916144

	/// Share of room revenue booked through online travel agencies.
	measure 'OTA Share %' = CALCULATE ( [Channel Share %], BookingChannels[Channel] = "Online Travel Agencies" )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: f4591194-41ca-5fe2-b414-8179f3432176

	/// GOP after commissions and channel fees.
	measure 'GOP after Distribution' = [GOP] - [Distribution Cost]
		formatString: \$#,0;(\$#,0)
		displayFolder: 02 Channels
		lineageTag: ef3a40f4-8904-58c6-90dc-8fc578b7da82

	/// Margin after distribution cost; the like-for-like benchmark across brands.
	measure 'GOP Margin after Distribution %' = DIVIDE ( [GOP after Distribution], [Total Revenue] )
		formatString: 0.0%
		displayFolder: 02 Channels
		lineageTag: e2e5cd3f-bb4a-5ef3-b6f4-a199afea1738

	/// Counterfactual, labeled as such: this period's room revenue at the 2021 channel mix, at each channel's current cost rate.
	measure 'Distribution Cost at 2021 Mix' = SUMX ( VALUES ( BookingChannels[Channel] ), VAR share21 = CALCULATE ( [Channel Share %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR rate = [Distribution Cost % of Room Revenue] VAR total = CALCULATE ( [Channel Room Revenue], ALL ( BookingChannels[Channel] ) ) RETURN share21 * total * rate )
		formatString: \$#,0;(\$#,0)
		displayFolder: 02 Channels
		lineageTag: 592d2231-41ee-5fc4-af2e-977ec1a92673

	/// What the channel drift since 2021 costs per period (counterfactual).
	measure 'Distribution Cost above 2021 Mix' = [Distribution Cost] - [Distribution Cost at 2021 Mix]
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 02 Channels
		lineageTag: 21b93e32-ba99-5974-bf0c-fbad68f61752

	/// Guest survey responses.
	measure 'Survey Responses' = SUM ( GuestExperience[SurveyResponses] )
		formatString: #,0
		displayFolder: 03 Guest
		lineageTag: 08fe88a8-c4c9-5d98-9874-85883fb6f133

	/// Net promoter score weighted by survey responses (an unweighted average is a contract violation).
	measure 'NPS (weighted)' = DIVIDE ( SUMX ( GuestExperience, GuestExperience[NetPromoterScore] * GuestExperience[SurveyResponses] ), [Survey Responses] )
		formatString: +0.0;-0.0;0.0
		displayFolder: 03 Guest
		lineageTag: a0f109f1-4572-5b54-8803-9ae71c64aff9

	/// Occupancy % fixed to calendar 2025, ignoring the page's date context.
	measure 'Occupancy % 2025' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 01 Core
		lineageTag: 7640b601-d6d0-5ab5-b9b6-4edfd10e57e3

	/// RevPAR fixed to calendar 2025, ignoring the page's date context.
	measure 'RevPAR 2025' = CALCULATE ( [RevPAR], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: f5ed19d9-8242-5736-8f5f-863ccdf8335a

	/// ADR fixed to calendar 2025, ignoring the page's date context.
	measure 'ADR 2025' = CALCULATE ( [ADR], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0.00
		displayFolder: 01 Core
		lineageTag: fab2a2eb-3ca6-52ac-9ef6-85b42a2e820c

	/// NPS (weighted) fixed to calendar 2021, ignoring the page's date context.
	measure 'NPS (weighted) 2021' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 03 Guest
		lineageTag: edb5f5d0-0958-565f-99fb-d48a86707322

	/// NPS (weighted) fixed to calendar 2025, ignoring the page's date context.
	measure 'NPS (weighted) 2025' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: +0.0;-0.0;0.0
		displayFolder: 03 Guest
		lineageTag: 5a57e5a8-c937-52d2-ace4-4ce0ab4e4220

	/// Distribution Cost above 2021 Mix fixed to calendar 2025, ignoring the page's date context.
	measure 'Distribution Cost above 2021 Mix 2025' = CALCULATE ( [Distribution Cost above 2021 Mix], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 02 Channels
		lineageTag: f397a61b-9620-5567-ae1e-838987425999

	/// Scenario chosen in the toggle; Expected when nothing is selected.
	measure 'Selected Scenario' = SELECTEDVALUE ( Scenario[Scenario], "Expected" )
		formatString: @
		displayFolder: 04 Plan builder
		lineageTag: a667d7ba-5113-5697-b333-732f2553aa79

	/// Revenue lost from rooms out of service during works, no cost relief (conservative).
	measure Disruption = VAR s = [Selected Scenario] RETURN CALCULATE ( SUM ( ProjectCashflow[Disruption] ), ProjectCashflow[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 85e3fc0f-1b5c-5304-a872-7cdef0868843

	/// Full annual operating-profit impact of the selection once ramped (every project is at 100 percent by 2032).
	measure '2032 Run-rate' = VAR s = [Selected Scenario] RETURN CALCULATE ( SUM ( InvestmentScenarios[AnnualOperatingProfitImpactUSD] ), InvestmentScenarios[Scenario] = s )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: 6ff79109-49fe-5ba6-892f-e12f3569b0b2

	/// Net impact through 2032 discounted monthly at the FinanceParameters rate to January 2027 (the close of the 2026 planning year), no terminal value (convention of 04-p2-build-method.md).
	measure 'NPV @ 8%' = VAR s = [Selected Scenario] RETURN CALCULATE ( SUMX ( FILTER ( ProjectCashflow, ProjectCashflow[Scenario] = s ), ( ProjectCashflow[Benefit] - ProjectCashflow[Capex] - ProjectCashflow[Disruption] ) * ProjectCashflow[DiscountFactor] ), REMOVEFILTERS ( 'Date' ) )
		formatString: \$#,0,,.0\ \M;-\$#,0,,.0\ \M
		displayFolder: 05 Impact
		lineageTag: fc5fb743-e30c-5399-ad34-115471b592a1

	/// The folio's OTA column as text; the kept line is the difference of the two shown amounts.
	measure 'Folio OTA Guest (text)' = VAR line = SELECTEDVALUE ( FolioLine[Line] ) VAR rate = ROUND ( CALCULATE ( DIVIDE ( [Channel Room Revenue], [Channel Room Nights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ), 2 ) VAR comm = ROUND ( CALCULATE ( DIVIDE ( [Distribution Cost], [Channel Room Nights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Online Travel Agencies" ), 2 ) RETURN SWITCH ( line, "The guest pays", FORMAT ( rate, "$#,0.00" ), "Commission and fees", UNICHAR ( 8722 ) & FORMAT ( comm, "$#,0.00" ), "Goodnight Inn keeps", FORMAT ( rate - comm, "$#,0.00" ) )
		formatString: @
		displayFolder: 07 Display
		lineageTag: 08322d27-417b-5f9a-a82f-e5279670ad23

	/// The folio's direct column as text; the kept line is the difference of the two shown amounts.
	measure 'Folio Direct Guest (text)' = VAR line = SELECTEDVALUE ( FolioLine[Line] ) VAR rate = ROUND ( CALCULATE ( DIVIDE ( [Channel Room Revenue], [Channel Room Nights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ), 2 ) VAR comm = ROUND ( CALCULATE ( DIVIDE ( [Distribution Cost], [Channel Room Nights] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025, BookingChannels[Channel] = "Direct Website & App" ), 2 ) RETURN SWITCH ( line, "The guest pays", FORMAT ( rate, "$#,0.00" ), "Commission and fees", UNICHAR ( 8722 ) & FORMAT ( comm, "$#,0.00" ), "Goodnight Inn keeps", FORMAT ( rate - comm, "$#,0.00" ) )
		formatString: @
		displayFolder: 07 Display
		lineageTag: 453d9efc-9622-55c7-a56e-7e686ff72288

	/// Goodnight Inn: GOP Margin after Distribution % on the trend axis.
	measure 'Trend Margin after GI' = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 09da73de-a1a6-549d-93c5-9b2340915f6c

	/// Goodnight Inn: OTA Share % on the trend axis.
	measure 'Trend OTA GI' = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: b10685df-2ae9-5dff-a165-38e74765b1a8

	/// The three sister brands together: OTA share of room revenue on the trend axis (room-revenue weighted), for the compact F2 tooltip chart.
	measure 'Trend OTA Sisters' = CALCULATE ( [OTA Share %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] <> "Goodnight Inn" )
		formatString: 0.0%
		displayFolder: 08 Brand comparison
		lineageTag: 3934539a-33a7-5015-b7a4-023f5530316f

	/// Capex of the package(s) in context (scatter X). Whole $M: a scatter axis prints its measure's format on every tick (doc 21 P-1 b, build step 8); the exact amounts are text measures.
	measure 'Package Capex' = SUM ( Package[CapexUSD] )
		formatString: \$#,0,,.\M
		displayFolder: 09 Package matrix
		lineageTag: 305768c2-ca80-5ebd-8cc9-cffc083628f2

	/// Package NPV through 2032 in the selected scenario (scatter Y). Whole $M for the axis ticks (doc 21 P-1 b, build step 8); the exact amounts are text measures.
	measure 'Package NPV (sel)' = VAR s = [Selected Scenario] RETURN SWITCH ( s, "Low", SUM ( Package[NPV Low] ), "High", SUM ( Package[NPV High] ), SUM ( Package[NPV Expected] ) )
		formatString: +\$#,0,,.\M;−\$#,0,,.\M;\$0\M
		displayFolder: 09 Package matrix
		lineageTag: 8d5996a9-7e10-58b7-bc3c-2dd1ce3b9283

	/// Package operating-profit run-rate in 2032, selected scenario.
	measure 'Package Run-rate (sel)' = VAR s = [Selected Scenario] RETURN SWITCH ( s, "Low", SUM ( Package[RunRate Low] ), "High", SUM ( Package[RunRate High] ), SUM ( Package[RunRate Expected] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: bcb320b0-8072-5bf2-a2fc-2ae56c42a979

	/// Package A: the valid package with the highest NPV through 2032 in the Expected case.
	measure 'Preset A Package' = LOOKUPVALUE ( Package[PackageID], Package[Preset], "A" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: dd99764d-7e56-59b3-a7a2-ed937b518ae3

	/// Package B: most hotels with a dataset guest-score effect among packages with NPV at least zero (Expected case), ties by NPV.
	measure 'Preset B Package' = LOOKUPVALUE ( Package[PackageID], Package[Preset], "B" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 1c02b9ab-d86b-56fb-98c3-be0146a58a84

	/// Package C: the highest-NPV package that includes the refresh of the ten oldest hotels (Expected case).
	measure 'Preset C Package' = LOOKUPVALUE ( Package[PackageID], Package[Preset], "C" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: e83c21c8-4e0c-5bed-a7ee-f14f4e832df8

	/// The Board recommendation (06-d1-briefing-opzet.md, Björn 7 Nov): package A, the valid package with the highest NPV through 2032 in the Expected case. Fixed: the scenario switch changes its numbers, never the package.
	measure 'Recommended Package' = LOOKUPVALUE ( Package[PackageID], Package[Preset], "A" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: a67c2caa-6b07-5730-96fb-7d19afe68cff

	/// Scatter color: Deep Coffee for A (the recommended plan; its white letter 6.2:1), Night for the alternatives B and C, Warm Grey for the other packages (3.5:1 on white; the earlier light lilac was 2.1:1). Plan 10 D6 on the v3 presets.
	measure 'Package Point Color' = VAR k = SELECTEDVALUE ( Package[Preset] ) RETURN SWITCH ( k, "A", "#1763A8", "B", "#12233D", "C", "#12233D", "#8E897D" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 88ed7370-015c-50b1-a96b-e3f6ab6a6b56

	/// Marker colour of the A/B/C layer only (it draws nothing else): Deep Coffee for A, Night for B and C, so its white letters read at 6.2:1 and 15.8:1 (plan 11).
	measure 'Named Point Color' = IF ( SELECTEDVALUE ( Package[Preset] ) = "A", "#1763A8", "#12233D" )
		formatString: @
		displayFolder: 09 Package matrix
		lineageTag: 4682440d-8100-5463-8c6e-43783fc783e0

	/// Size of the A/B/C layer's dots in the small scatter (What waits and Build): 22 px for all three, the comp's lettered discs (build step 8, measured 21.8 px at the stack's multiplier). Their letters are a layer of their own, see Named Letter NPV (sel).
	measure 'Named Point Size (small)' = 7.2
		formatString: 0
		displayFolder: 09 Package matrix
		lineageTag: a9941996-fe80-5651-9d15-973caf2f8184

	/// Where the letter of A, B or C is anchored in the small scatter, NOT a value: the package's NPV plus a fixed lift, so that Power BI's label, which it sets under an invisible point, lands inside the package's disc. Shown nowhere as a number (the layer has no tooltip and no tab stop).
	measure 'Named Letter NPV (sel)' = [Package NPV (sel)] + 4340000
		formatString: +\$#,0,,.\M;−\$#,0,,.\M;\$0\M
		displayFolder: 09 Package matrix
		lineageTag: ce6d57d8-4126-56b1-a461-68464b3a5858

	/// The brand's funded chip (Coffee Blue hanger on Ice) as an image, beside the recommendation's title; decorative.
	measure 'Chip Funded' = "data:image/svg+xml;utf8," & "<svg xmlns='http://www.w3.org/2000/svg' width='40' height='28' viewBox='0 0 40 28'><rect x='0.5' y='0.5' width='39' height='27' rx='13.5' fill='%23EAF2FB' stroke='%23EAF2FB'/><g transform='translate(14.2 3) scale(0.2115)'><mask id='h'><rect width='64' height='104' fill='white'/><circle cx='32' cy='24' r='10' fill='black'/><rect x='32' y='22.5' width='40' height='3' fill='black'/></mask><rect x='4' y='4' width='56' height='96' rx='14' fill='%232589D8' mask='url(%23h)'/></g></svg>"
		formatString: @
		displayFolder: 09 Package matrix
		dataCategory: ImageUrl
		lineageTag: c7181024-7080-5d26-a367-3bb1954bc727

	/// Preset A: capex.
	measure 'Preset A Capex' = VAR f = [Preset A Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: \$#,0,,.0\M
		displayFolder: 09 Package matrix
		lineageTag: 46a2e199-e497-5930-a283-413063b64ef2

	/// Preset A: npv (sel).
	measure 'Preset A NPV (sel)' = VAR f = [Preset A Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: cc2f33e5-27cb-513a-b477-eec63909c6b6

	/// Preset B: capex.
	measure 'Preset B Capex' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: \$#,0,,.0\M
		displayFolder: 09 Package matrix
		lineageTag: c8d9a4d9-adc7-5c61-a8ea-9436ec43fcce

	/// Preset B: npv (sel).
	measure 'Preset B NPV (sel)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 41d4b473-fa25-565e-b6e7-efed6d4ebeeb

	/// Preset B: run-rate (sel).
	measure 'Preset B Run-rate (sel)' = VAR f = [Preset B Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package Run-rate (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: 26da20e6-4560-5ee0-b680-5aa553d95ae4

	/// Preset C: capex.
	measure 'Preset C Capex' = VAR f = [Preset C Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( SUM ( Package[CapexUSD] ), REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: \$#,0,,.0\M
		displayFolder: 09 Package matrix
		lineageTag: bd006f42-85de-5326-b9a3-76bcd6366dad

	/// Preset C: npv (sel).
	measure 'Preset C NPV (sel)' = VAR f = [Preset C Package] RETURN IF ( ISBLANK ( f ), BLANK (), CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = f ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 09 Package matrix
		lineageTag: ebb5e682-9b2f-5595-b42b-4b01c95c231a

	/// Tooltip header: A, B or C by name and role (PlanSelector[Label]; build step 10: C is named by its moves, R-G2), any other package by its size.
	measure 'TT Title (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR k = LOOKUPVALUE ( Package[Preset], Package[PackageID], pkg ) VAR n = LOOKUPVALUE ( Package[Projects], Package[PackageID], pkg ) RETURN IF ( ISBLANK ( pkg ), BLANK (), SWITCH ( k, "", "A package of " & n & " moves", LOOKUPVALUE ( PlanSelector[Label], PlanSelector[Key], k ) ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: d6a2d462-1ad1-5ea5-b8fc-c9095bf65a69

	/// Tooltip: capex of the hovered package, two decimals like the NPV beside it (round 5).
	measure 'TT Capex (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) RETURN IF ( ISBLANK ( pkg ), BLANK (), ( VAR __v = ( LOOKUPVALUE ( Package[CapexUSD], Package[PackageID], pkg ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: b8f1f889-1e83-5d4f-9752-796754413eb7

	/// Tooltip: NPV through 2032 of the hovered package, scenario in view, two decimals (round 5).
	measure 'TT NPV (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR npv = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = pkg ) RETURN IF ( ISBLANK ( pkg ), BLANK (), ( VAR __v = ( npv ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: b093484c-69bb-5165-8219-c821d8300140

	/// Tooltip NPV colour: Night when it pays back by 2032 (NPV at least zero), Burnt Tangerine below; the sign and the payback line carry it too. Build step 10 (R-TT-4, R-G3): blue means package A only, so a positive NPV of any package is Night.
	measure 'TT NPV Color' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR npv = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = pkg ) RETURN IF ( ROUND ( npv / 100000, 0 ) >= 0, "#12233D", "#A63F0E" )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 9b298b18-b872-5fa7-b539-bfafab6ee91d

	/// Tooltip (R-TT-1): NPV of the hovered package in the three cases in one sentence, and what 'pays back' means; also the keyboard layer's text twin.
	measure 'TT Range (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR lo = LOOKUPVALUE ( Package[NPV Low], Package[PackageID], pkg ) VAR ex = LOOKUPVALUE ( Package[NPV Expected], Package[PackageID], pkg ) VAR hi = LOOKUPVALUE ( Package[NPV High], Package[PackageID], pkg ) RETURN IF ( ISBLANK ( pkg ), BLANK (), "Low " & ( VAR __v = ( lo ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " · Expected " & ( VAR __v = ( ex ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " · High " & ( VAR __v = ( hi ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & "." )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 4357e07f-0d11-526f-8e6b-dbc04ccfd4e6

	/// First year the cumulative net of the hovered package turns positive, scenario in view; blank when not by 2032.
	measure 'TT Payback Year' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( GENERATESERIES ( 2027, 2032, 1 ), "@c", VAR y = [Value] RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = s, TREATAS ( ids, ProjectCashflow[ProjectID] ) ) ) RETURN MINX ( FILTER ( t, [@c] >= 0 ), [Value] )
		formatString: 0
		displayFolder: 10 Package tooltip
		lineageTag: 02751a1a-5f9f-5354-8666-b105b0c339ff

	/// Tooltip verdict: whether the hovered package pays back by 2032 across the three cases (not even in High / only in High / Expected and High / every case), and the first cash-positive year when the case in view pays back.
	measure 'TT Payback (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR npv = CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = pkg ) VAR pb = [TT Payback Year] VAR lo = ROUND ( LOOKUPVALUE ( Package[NPV Low], Package[PackageID], pkg ) / 100000, 0 ) VAR ex = ROUND ( LOOKUPVALUE ( Package[NPV Expected], Package[PackageID], pkg ) / 100000, 0 ) VAR hi = ROUND ( LOOKUPVALUE ( Package[NPV High], Package[PackageID], pkg ) / 100000, 0 ) VAR cash = IF ( ROUND ( npv / 100000, 0 ) >= 0 && NOT ISBLANK ( pb ), "; cash positive from " & pb, "" ) RETURN IF ( ISBLANK ( pkg ), BLANK (), SWITCH ( TRUE (), hi < 0, "Does not pay back by 2032, not even in the High case", lo >= 0, "Pays back by 2032 in every case" & cash, ex >= 0, "Pays back by 2032 except in Low" & cash, "Pays back by 2032 only in the High case" & cash ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 78b2dbb1-333d-5bbb-9d56-587498dc7971

	/// Goodnight Inn occupancy, 2025 (KPI band).
