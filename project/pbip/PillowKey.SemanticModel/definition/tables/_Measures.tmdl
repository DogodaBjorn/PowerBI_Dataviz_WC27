	/// Capital plan chart, end label of the Low line as a card right of the line's end: 'Low' and package A's cumulative cash in the horizon year; empty while Low is the case in view.
	measure 'Plan End Low (text)' = IF ( [Selected Scenario] = "Low", "", VAR hz = LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) RETURN "Low " & ( VAR __v = ( CALCULATE ( [TT Year A (Low)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = hz ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: d1231fff-203a-5a30-8edc-399bc26717e7

	/// Capital plan chart, end label of the emphasised line when Low is the case in view: 'Low' and the amount; empty in the other cases.
