	/// Month the last move of the plan being built goes live.
	measure 'Build Live (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, BLANK (), FORMAT ( CALCULATE ( MAX ( InvestmentProjects[Completion Date] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) ), "mmm yyyy", "en-US" ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 98b16d21-c2c1-504b-83d0-1d9050c165a5

	/// Title of the your-plan tile; its empty state asks for a first move; over the budget it becomes the alarm (round 5, Björn: a big alarm when the selection passes the budget).
	measure 'Build Title (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( n = 0, "Nothing picked yet", IF ( over, "Over the " & ( VAR __v = ( budget ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " budget by " & ( VAR __v = ( cap - budget ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ), "Your plan: " & n & IF ( n = 1, " move", " moves" ) & ", live by " & [Build Live (text)] ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: f1c18fa0-d54a-5b8c-a8f7-6955ba2bc640

	/// Title of the your-plan tile while the plan is within the budget (or empty); empty over the budget, where the alarm band carries the title.
	measure 'Build Title Plain (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( over, "", [Build Title (text)] )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: a33768ec-2923-57a5-b08f-84c78311ef93

	/// The alarm band of the your-plan tile: the title while the picked capex passes the budget; empty otherwise.
	measure 'Build Title Alarm (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( over, [Build Title (text)], "" )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 7ce14136-123f-5807-9ac8-4bd75ffe1896

	/// Fill of the your-plan title row: Tangerine while the picked capex passes the budget (the alarm band), white otherwise. Paired with Build Title Ink, branch for branch.
	measure 'Build Title Fill' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( over, "#E05A22", "#FFFFFF" )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 4cc138a1-5a32-564c-86a1-9fced830b373

	/// Text of the your-plan title row: white on the Tangerine alarm band (18 pt: 4.2:1, WCAG large text), Night otherwise.
	measure 'Build Title Ink' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( over, "#FFFFFF", "#12233D" )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 445da63e-1ec4-5a64-83e9-2d6e763c6752

	/// Capex of the plan being built as text; empty while nothing is picked (R-B-2: the empty state shows no numbers).
	measure 'Build Capex (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, "", ( VAR __v = ( [Build Capex] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 6468fcdd-4359-5177-bd72-0d2ecbee7690

	/// NPV of the plan being built as text; empty while nothing is picked.
	measure 'Build NPV (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, "", ( VAR __v = ( [Build NPV (sel)] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: d3d8db17-4d6f-574d-9e4e-08ccc9503ac9

	/// NPV of the plan being built in the Low and in the High scenario, each named (review round 3: UX3-08, CL3-13, DS3-08), the unit on both (R-G1); empty while nothing is picked.
	measure 'Build Range (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR lo = [Build NPV Low] VAR hi = [Build NPV High] RETURN IF ( n = 0, "", "Low " & ( VAR __v = ( lo ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & " · High " & ( VAR __v = ( hi ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 2b63a2c8-8bc9-58bc-b1dc-229d2bbca79a

	/// The contest rules against the plan being built: at least 3 moves, 1 growth, within budget, kiosks need the app.
	measure 'Build Valid (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR g = COALESCE ( [Build Growth], 0 ) VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR kiosk = "GI-02" IN ids VAR app = "GI-01" IN ids VAR broken = n > 0 && ( n < 3 || g < 1 || cap > budget || ( kiosk && NOT app ) ) VAR issues = IF ( n < 3, "at least 3 moves; ", "" ) & IF ( g < 1, "at least 1 growth move; ", "" ) & IF ( cap > budget, "over the budget; ", "" ) & IF ( kiosk && NOT app, "the kiosks need the booking app; ", "" ) RETURN IF ( n = 0, "Pick at least three moves, one of them growth, within " & ( VAR __v = ( budget ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ". Your plan appears here, against A below.", IF ( NOT broken, "Within the rules: " & n & " moves, " & g & " growth, " & ( VAR __v = ( cap ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & " of " & ( VAR __v = ( budget ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) & ".", "Not yet within the rules: " & LEFT ( issues, LEN ( issues ) - 2 ) & "." ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 345be5c8-25e5-54ef-b462-6b2667b44f7c

	/// Ink of the rules line: Night for the empty state's instruction, Burnt Tangerine while a rule is broken, Dusk when the plan is within the rules (the sentence says which).
	measure 'Build Valid Color' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR g = COALESCE ( [Build Growth], 0 ) VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR kiosk = "GI-02" IN ids VAR app = "GI-01" IN ids VAR broken = n > 0 && ( n < 3 || g < 1 || cap > budget || ( kiosk && NOT app ) ) RETURN IF ( n = 0, "#12233D", IF ( broken, "#A63F0E", "#4B5466" ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: cea0e9ba-358d-5371-b0da-b37c06f6ad89

	/// Cumulative net impact of the plan being built, undiscounted 2025 dollars, scenario in view.
	measure 'Build Cumulative Net (sel)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR s = [Selected Scenario] VAR y = MAX ( 'Date'[Year] ) RETURN IF ( n = 0, BLANK (), CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = s, TREATAS ( ids, ProjectCashflow[ProjectID] ) ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 12 Build your own
		lineageTag: 5d548f30-8990-5f03-bd27-7a91a53ace61

	/// First year the cumulative net of the plan being built turns positive; blank when not by 2032 or when empty.
	measure 'Build Payback Year' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR s = [Selected Scenario] VAR t = ADDCOLUMNS ( GENERATESERIES ( 2027, 2032, 1 ), "@c", VAR y = [Value] RETURN CALCULATE ( SUM ( ProjectCashflow[Benefit] ) - SUM ( ProjectCashflow[Capex] ) - SUM ( ProjectCashflow[Disruption] ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] <= y, ProjectCashflow[Scenario] = s, TREATAS ( ids, ProjectCashflow[ProjectID] ) ) ) RETURN IF ( n = 0, BLANK (), MINX ( FILTER ( t, [@c] >= 0 ), [Value] ) )
		formatString: 0
		displayFolder: 12 Build your own
		lineageTag: 15a9fdd2-283a-5074-95a0-28a0f04954fe

	/// Marker colour of the plan dot in the proof chart: Night (Night is 'your plan', R-G3), Tangerine while the picked capex passes the budget.
	measure 'Build Point Color' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( over, "#E05A22", "#12233D" )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 5f7886c9-0b8c-5ea6-9635-513f0c7dd351

	/// Ink of the name 'You' above the plan dot: Night, Burnt Tangerine while over the budget (the text cut of Tangerine: 6.2:1 on white).
	measure 'Build You Ink' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR cap = COALESCE ( [Build Capex], 0 ) VAR budget = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) VAR over = n > 0 && cap > budget RETURN IF ( over, "#A63F0E", "#12233D" )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: e2b2b714-014b-5ead-acd5-4595a511cbac

	/// Where the name 'You' is anchored in the proof chart, NOT a value: the plan's NPV plus a fixed lift, so that Power BI's label, which it sets under an invisible point, lands above the plan dot. Shown nowhere as a number (the layer has no tooltip and no tab stop).
	measure 'Build You Label NPV' = VAR v = [Build NPV (sel)] RETURN IF ( NOT ISBLANK ( v ), v + 11090000 )
		formatString: +\$#,0,,.\M;−\$#,0,,.\M;\$0\M
		displayFolder: 12 Build your own
		lineageTag: 3e7a169c-b1e9-51f6-80b4-3faf6b30223a

	/// Title of the comparer in the build state: your plan against A by 2032 and its payback, scenario in view.
	measure 'Cmp Build Title (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR s = [Selected Scenario] VAR a32 = CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR y32 = CALCULATE ( [Build Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR pb = [Build Payback Year] RETURN IF ( n = 0, "Your plan against A, cumulative cash, not discounted, $M (" & s & ")", "Your plan against A, cumulative cash, not discounted, $M (" & s & "): " & IF ( ROUND ( ( y32 - a32 ) / 100000, 0 ) = 0, "level with A", IF ( y32 > a32, "ahead of A by ", "behind A by " ) & ( VAR __v = ( ABS ( y32 - a32 ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) ) & " in 2032" & IF ( ISBLANK ( pb ), ", not cash positive by 2032", ", cash positive from " & pb ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 09d9c527-b652-50c1-86ce-d837555d7549

	/// Selector row: capex of the move, one decimal (fm).
	measure 'Move Capex (text)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) RETURN IF ( ISBLANK ( p ), BLANK (), ( VAR __v = ( LOOKUPVALUE ( InvestmentProjects[CapexUSD], InvestmentProjects[ProjectID], p ) ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 4c573b78-8e8e-59c5-90d2-15b7fc66d5c6

	/// Selector row: NPV through 2032 of the move alone, scenario in view.
	measure 'Move NPV (num)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) RETURN IF ( ISBLANK ( p ), BLANK (), CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 12 Build your own
		lineageTag: 85d6b9d4-cac6-5a99-8a2a-d835a586c182

	/// Selector row: the move's NPV as text.
	measure 'Move NPV (text)' = VAR v = [Move NPV (num)] RETURN IF ( ISBLANK ( v ), BLANK (), ( VAR __v = ( v ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: a0246ca6-5fe0-5a41-84c6-a3284b821188

	/// Hero and selector row: the page-1 finding the move answers (MoveDecision, doc 21 10.3) and the growth flag.
	measure 'Move Answers (text)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) RETURN IF ( ISBLANK ( p ), BLANK (), LOOKUPVALUE ( MoveDecision[Finding], MoveDecision[ProjectID], p ) & IF ( LOOKUPVALUE ( InvestmentProjects[GrowthInitiative], InvestmentProjects[ProjectID], p ) = "Yes", " · growth", "" ) )
		formatString: @
		displayFolder: 12 Build your own
		lineageTag: 7ba93188-3a9e-56c8-80a7-34dc40d7dcf8

	/// Selector: the Goodnight Inn budget, repeated on every row (the footer's cap).
	measure 'Move Budget (num)' = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0
		displayFolder: 12 Build your own
		lineageTag: 6e676f80-fef1-5e05-86cc-4ec8c40c2ea3

	/// Tooltip: the line above the moves list.
	measure 'TT Moves Label (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) RETURN IF ( ISBLANK ( pkg ), BLANK (), "In this package: " & COUNTROWS ( ids ) & " moves" )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: fe389894-7826-5f31-86e3-ec13cb9783a3

	/// Tooltip (alt text only since round 6): the moves the hovered package leaves out.
	measure 'TT Not Included (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR t = FILTER ( ALLNOBLANKROW ( InvestmentProjects ), InvestmentProjects[Brand] = "Goodnight Inn" && NOT ( InvestmentProjects[ProjectID] IN ids ) ) RETURN IF ( ISBLANK ( pkg ), BLANK (), IF ( COUNTROWS ( t ) = 0, "Every move is in it.", "Not in it: " & CONCATENATEX ( t, InvestmentProjects[Short Name], ", ", InvestmentProjects[ProjectID], ASC ) & "." ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 33f2f3aa-ec6d-598d-8c1e-1f0632e99baa

	/// Tooltip kicker on the night banner (round 7): the package's letter when it has one and the case in view, in the page's eyebrow style.
	measure 'TT Kicker (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR k = LOOKUPVALUE ( Package[Preset], Package[PackageID], pkg ) RETURN IF ( ISBLANK ( pkg ), BLANK (), "PACKAGE" & IF ( k <> "", "  " & k, "" ) & "  ·  " & UPPER ( [Selected Scenario] ) & " CASE" )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 35eca03e-56b0-5fc6-966c-b9386baae031

	/// Package tooltip, moves table: the capex of the row's move when it is in the hovered package, the package's capex on the Total row, blank otherwise (so the table lists the package's moves only).
	measure 'TT Row Capex (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR p = SELECTEDVALUE ( TTMove[ProjectID] ) VAR c = SWITCH ( TRUE (), ISBLANK ( pkg ) || ISBLANK ( p ), BLANK (), p = "total", LOOKUPVALUE ( Package[CapexUSD], Package[PackageID], pkg ), p IN ids, LOOKUPVALUE ( InvestmentProjects[CapexUSD], InvestmentProjects[ProjectID], p ) ) RETURN IF ( ISBLANK ( c ), BLANK (), ( VAR __v = ( c ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __v < 0 && __r2 > 0, UNICHAR ( 8722 ) & UNICHAR ( 8288 ), "" ) & __m ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: fec1fd38-c180-5cf4-95ee-0dab2859618b

	/// Package tooltip, moves table: NPV through 2032 of the row's move alone (as the hero table and the selector print it), the package's NPV on the Total row; scenario in view; blank for a move outside the package.
	measure 'TT Row NPV (num)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR p = SELECTEDVALUE ( TTMove[ProjectID] ) RETURN SWITCH ( TRUE (), ISBLANK ( pkg ) || ISBLANK ( p ), BLANK (), p = "total", CALCULATE ( [Package NPV (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = pkg ), p IN ids, CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 10 Package tooltip
		lineageTag: 8e4e0c6b-3c9d-5b57-83f5-bd87d6682256

	/// Package tooltip, moves table: the row's NPV as text (sfm).
	measure 'TT Row NPV (text)' = VAR v = [TT Row NPV (num)] RETURN IF ( ISBLANK ( v ), BLANK (), ( VAR __v = ( v ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 8ebf148c-832c-5900-af00-d314bed705f8

	/// Package tooltip, moves table: Burnt Tangerine for an NPV below zero, Night otherwise (R-G3; the sign says it too).
	measure 'TT Row NPV Ink' = VAR v = [TT Row NPV (num)] RETURN IF ( ROUND ( v / 10000, 0 ) < 0, "#A63F0E", "#12233D" )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: 7fdc048e-6c30-50f6-a077-92413ce8f93f

	/// Tooltip text twin of the moves list: each move with its NPV inside the package, positives first (the keyboard layer's tooltip and the alt text).
	measure 'TT Moves (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = pkg ), "@p", PackageProject[ProjectID] ) VAR base = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) VAR tr = ROUND ( SUMX ( base, [@v] ) / 10000, 0 ) VAR fl = ADDCOLUMNS ( base, "@f", INT ( [@v] / 10000 ) ) VAR fr = ADDCOLUMNS ( fl, "@r", [@v] / 10000 - [@f] + VALUE ( RIGHT ( [@p], 2 ) ) * 0.000000001 ) VAR k = tr - SUMX ( fr, [@f] ) VAR adj = ADDCOLUMNS ( fr, "@s", ( [@f] + IF ( RANKX ( fr, [@r], , DESC ) <= k, 1, 0 ) ) * 10000 ) RETURN IF ( ISBLANK ( pkg ), BLANK (), CONCATENATEX ( adj, LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) & " " & ( VAR __v = ( [@s] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), "; ", [@s], DESC ) )
		formatString: @
		displayFolder: 10 Package tooltip
		lineageTag: b8c66b16-0bef-57c3-a10b-81142196875a

	/// Header of the F3 band tooltip: the band, its hotels and rooms.
	measure 'Band Header (text)' = VAR bnd = SELECTEDVALUE ( Hotels[Renovation Age Label] ) RETURN IF ( ISBLANK ( bnd ), BLANK (), bnd & ": " & COUNTROWS ( Hotels ) & " hotels, " & FORMAT ( SUM ( Hotels[Rooms] ), "#,0", "en-US" ) & " rooms" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 6e2a0089-24f5-5cb1-89ea-914f74bcdb88

	/// F3 band tooltip: the brand's own 2025 figures under the band's three, the same formatters.
	measure 'Band vs Brand (text)' = "Goodnight Inn, all hotels, 2025: NPS " & IF ( CALCULATE ( [NPS (weighted) 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( CALCULATE ( [NPS (weighted) 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ) ), "0.0", "en-US" ) & ", occupancy " & FORMAT ( CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "0.0%", "en-US" ) & ", RevPAR " & FORMAT ( CALCULATE ( [RevPAR 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "$#,0.00", "en-US" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 189a7e04-3179-5f45-916d-32dbfa78b1ca

	/// F3 band tooltip, line: the band's response-weighted NPS by year.
	measure 'NPS Band (line)' = [NPS (weighted)]
		formatString: +0.0;-0.0;0.0
		displayFolder: 14 Findings reference and hover detail
		lineageTag: a4e19789-f2e8-53bc-ae5b-d6befc454d02

	/// F3 band tooltip, line: Goodnight Inn's response-weighted NPS by year, every hotel.
	measure 'NPS Brand (line)' = CALCULATE ( [NPS (weighted)], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: +0.0;-0.0;0.0
		displayFolder: 14 Findings reference and hover detail
		lineageTag: c72756bc-a058-5559-98df-82a04c3529ed

	/// F3 band tooltip: the two lowest of the five guest-score dimensions in 2025, response-weighted (what a refresh would have to fix).
	measure 'Weakest Scores (text)' = VAR t = UNION ( ROW ( "@n", "cleanliness", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[CleanlinessScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), ROW ( "@n", "service", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[ServiceScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), ROW ( "@n", "room comfort", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[RoomComfortScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), ROW ( "@n", "amenities", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[AmenitiesScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ), ROW ( "@n", "value for money", "@v", CALCULATE ( DIVIDE ( SUMX ( GuestExperience, GuestExperience[ValueForMoneyScore] * GuestExperience[SurveyResponses] ), SUM ( GuestExperience[SurveyResponses] ) ), REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) ) ) RETURN IF ( ISBLANK ( SELECTEDVALUE ( Hotels[Renovation Age Label] ) ), BLANK (), "Weakest guest scores 2025: " & CONCATENATEX ( TOPN ( 2, t, [@v], ASC ), [@n] & " " & FORMAT ( [@v], "0.0", "en-US" ), ", ", [@v], ASC ) & " (of 10)" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: b6d0a913-af44-5683-aaaf-834c047fad83

	/// The F3 band tooltip's three figures read aloud.
	measure 'Alt Band Nums (text)' = "This band in 2025: NPS " & ( VAR __q = ( [NPS 2025 (signed)] ) RETURN IF ( ROUND ( __q, 1 ) = 0, "0.0", IF ( __q < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __q ), "0.0", "en-US" ) ) ) & ", occupancy " & FORMAT ( [Occupancy % 2025], "0.0%", "en-US" ) & ", revenue per available room " & FORMAT ( [RevPAR 2025], "$#,0", "en-US" ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 0a12882e-b70b-51e1-82d5-2fd9d5d312cf

	/// The F3 band tooltip's line chart read aloud.
	measure 'Alt NPS Band Line (text)' = "Net promoter score by year, 2021 to 2025, this band against the whole brand: the band from " & FORMAT ( [NPS (weighted) 2021], "+0.0;−0.0;0.0", "en-US" ) & " to " & FORMAT ( [NPS (weighted) 2025], "+0.0;−0.0;0.0", "en-US" ) & ", the brand from " & FORMAT ( CALCULATE ( [NPS (weighted) 2021], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "+0.0;−0.0;0.0", "en-US" ) & " to " & FORMAT ( CALCULATE ( [NPS (weighted) 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "+0.0;−0.0;0.0", "en-US" ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 923cef95-153b-571c-9a22-3f2d2c8fbf02

	/// Hover detail card: the NPS 2025 of the hovered band as text, one decimal with its sign.
	measure 'TT NPS 2025 (text)' = VAR v = [NPS 2025 (signed)] RETURN IF ( ISBLANK ( v ), BLANK (), ( VAR __q = ( v ) RETURN IF ( ROUND ( __q, 1 ) = 0, "0.0", IF ( __q < 0, UNICHAR ( 8722 ), "+" ) & FORMAT ( ABS ( __q ), "0.0", "en-US" ) ) ) )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 67ea49dd-db05-586e-a80e-515dfd1cc52e

	/// Hover detail card: occupancy 2025 of the hovered band or hotel as text, one decimal.
	measure 'TT Occupancy 2025 (text)' = VAR v = [Occupancy % 2025] RETURN IF ( ISBLANK ( v ), BLANK (), ( VAR __p = ( v ) * 100 RETURN IF ( ROUND ( __p, 1 ) < 0, UNICHAR ( 8722 ), "" ) & FORMAT ( ABS ( __p ), "0.0", "en-US" ) & "%" ) )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 96bec9e5-f4f0-5275-9bc9-9c433478fd97

	/// Hover detail card: ADR 2025 of the hovered band or hotel as text, in dollars and cents.
	measure 'TT ADR 2025 (text)' = VAR v = [ADR 2025] RETURN IF ( ISBLANK ( v ), BLANK (), FORMAT ( v, "$#,0.00", "en-US" ) )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: b426926e-c5fe-5367-abdd-3716a3bef97d

	/// Hover detail card: RevPAR 2025 of the hovered band or hotel as text, in dollars and cents.
	measure 'TT RevPAR 2025 (text)' = VAR v = [RevPAR 2025] RETURN IF ( ISBLANK ( v ), BLANK (), FORMAT ( v, "$#,0.00", "en-US" ) )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: d5664779-f507-537d-ae8d-adba7445da62

	/// Header of the F4 hotel tooltip: the hotel, its location type and rooms.
	measure 'Hotel Header (text)' = VAR h = SELECTEDVALUE ( Hotels[Hotel Short Name] ) RETURN IF ( ISBLANK ( h ), BLANK (), h & ", " & LOWER ( SELECTEDVALUE ( Hotels[LocationType] ) ) & ", " & FORMAT ( SUM ( Hotels[Rooms] ), "#,0", "en-US" ) & " rooms" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 70cdf61d-21d1-5b34-af2a-575e2efdd1e5

	/// F4 hotel tooltip: the brand's own 2025 figures under the hotel's three.
	measure 'Hotel vs Brand (text)' = "Goodnight Inn, all hotels, 2025: occupancy " & FORMAT ( CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "0.0%", "en-US" ) & ", ADR " & FORMAT ( CALCULATE ( [ADR 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "$#,0.00", "en-US" ) & ", RevPAR " & FORMAT ( CALCULATE ( [RevPAR 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "$#,0.00", "en-US" )
		formatString: @
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 9505e74c-5a93-53e8-9d09-8b4fce534510

	/// F4 hotel tooltip, line: the hotel's occupancy by month.
	measure 'Occupancy Hotel (line)' = [Occupancy %]
		formatString: 0.0%
		displayFolder: 14 Findings reference and hover detail
		lineageTag: e266f597-55d9-505c-8687-222f7c409923

	/// F4 hotel tooltip, line: Goodnight Inn's occupancy by month, every hotel.
	measure 'Occupancy Brand (line)' = CALCULATE ( [Occupancy %], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" )
		formatString: 0.0%
		displayFolder: 14 Findings reference and hover detail
		lineageTag: 86d49a63-98d9-5729-ab1a-c81d6967be2c

	/// The F4 hotel tooltip's three figures read aloud.
	measure 'Alt Hotel Nums (text)' = "This hotel in 2025: occupancy " & FORMAT ( [Occupancy % 2025], "0.0%", "en-US" ) & ", average daily rate " & FORMAT ( [ADR 2025], "$#,0", "en-US" ) & ", revenue per available room " & FORMAT ( [RevPAR 2025], "$#,0", "en-US" ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 53e33675-924d-55a5-a9b7-23235150c360

	/// The F4 hotel tooltip's line chart read aloud.
	measure 'Alt Occupancy Hotel Line (text)' = "Occupancy by month in 2025, this hotel against the whole brand: the hotel averages " & FORMAT ( [Occupancy % 2025], "0.0%", "en-US" ) & ", the brand " & FORMAT ( CALCULATE ( [Occupancy % 2025], REMOVEFILTERS ( Hotels ), REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn" ), "0.0%", "en-US" ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: f94bb586-30d4-5704-bb84-4f2d9497615c

	/// The Definitions chip read aloud: the decision words of the glossary in one breath (under 250 characters), so a keyboard or screen-reader user gets the terms the hover shows.
	measure 'Alt Definitions (text)' = "Definitions. NPV: net present value through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ". Pays back: NPV of zero or more. A year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ": the profit a move adds in a full year. A year on cost: that profit over capex. Tranche: a part of the budget, one Board decision."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 68655a71-0b3f-52d3-838d-22d4ef8672d3

	/// The tooltip's moves table read aloud.
	measure 'Alt TT Moves (text)' = VAR pkg = SELECTEDVALUE ( Package[PackageID] ) RETURN IF ( ISBLANK ( pkg ), BLANK (), "The moves in the hovered package with their net present value: " & [TT Moves (text)] & ". " & [TT Not Included (text)] )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 874feda9-d185-5063-81ed-1386f891513e

	/// The alts comparer read aloud: the three 2032 end points.
	measure 'Alt Cmp Alts (text)' = VAR s = [Selected Scenario] VAR a32 = CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR b32 = CALCULATE ( [Preset B Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR c32 = CALCULATE ( [Preset C Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) RETURN "Cumulative cash, not discounted, 2027 to 2032 against A, " & s & " case, by 2032: A " & ( VAR __v = ( a32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ", B " & ( VAR __v = ( b32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ", C " & ( VAR __v = ( c32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 56305f76-52d9-520c-adb2-7f2221673409

	/// The your-plan numbers read aloud, with the range and the rules check (first version of build step 9; step 10 reviews it).
	measure 'Alt You Nums (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, "Your plan: nothing picked yet. " & [Build Valid (text)], "Your plan, " & [Selected Scenario] & " case: capex " & [Build Capex (text)] & ", net present value through 2032 " & [Build NPV (text)] & ", " & [Build Run-rate (text)] & " a year by 2032, " & [Build A Year on Cost (text)] & " a year on cost. NPV by case: " & [Build Range (text)] & ". " & [Build Valid (text)] )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 2a6a0768-3a95-58cf-9c31-ea296ccf4cda

	/// The build bar chart read aloud: each picked move with its NPV, highest first (first version of build step 9; step 10 reviews it).
	measure 'Alt Build Bars (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR t = ADDCOLUMNS ( ids, "@v", VAR p = [@p] RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) ) RETURN IF ( n = 0, "No moves picked yet.", "Net present value through 2032 of each picked move, " & [Selected Scenario] & " case, highest first: " & CONCATENATEX ( t, LOOKUPVALUE ( InvestmentProjects[Short Name], InvestmentProjects[ProjectID], [@p] ) & " " & ( VAR __v = ( [@v] ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ), ", ", [@v], DESC ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 08e86ed0-9a3e-5926-b8ca-75eb96db587c

	/// The moves table read aloud (build step 10: shortened from the list of all ten, 580 characters): what the rows hold and the first move; the rows are read cell by cell inside the table.
	measure 'Alt Moves (text)' = "The ten moves, " & [Selected Scenario] & " case, in the order of the list beside it, each with the finding it answers, its capex, its NPV through " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & " and what it adds a year by " & LOOKUPVALUE ( FinanceParameters[Value], FinanceParameters[Parameter], "Impact horizon" ) & ". First: " & CONCATENATEX ( TOPN ( 1, ALLNOBLANKROW ( BuildMove ), BuildMove[Sort], ASC ), BuildMove[Short Name] & ", " & [Move Capex (text)] & ", NPV " & [Move NPV (text)], "; " ) & "."
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 31c3284f-5e52-5692-b4b0-c3791dedec66

	/// The build comparer read aloud.
	measure 'Alt Cmp Build (text)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 VAR s = [Selected Scenario] VAR a32 = CALCULATE ( [Preset A Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) VAR y32 = CALCULATE ( [Build Cumulative Net (sel)], REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2032 ) RETURN IF ( n = 0, "Cumulative cash of A, not discounted, 2027 to 2032, " & s & " case, ends at " & ( VAR __v = ( a32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "; pick moves to add your plan.", "Cumulative cash, not discounted, 2027 to 2032, " & s & " case, by 2032: your plan " & ( VAR __v = ( y32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & ", A " & ( VAR __v = ( a32 ) / 1000000 VAR __a = ABS ( __v ) + 0 VAR __r1 = ROUND ( __a, 1 ) VAR __r2 = ROUND ( __a, 2 ) VAR __m = "$" & IF ( __r1 = 0 && __r2 > 0, FORMAT ( __r2, "0.00", "en-US" ), FORMAT ( __r1, "#,0.0", "en-US" ) ) & "M" RETURN IF ( __r2 = 0, "$0.0M", IF ( __v < 0, UNICHAR ( 8722 ), "+" ) & UNICHAR ( 8288 ) & __m ) ) & "." )
		formatString: @
		displayFolder: 11 Accessibility
		lineageTag: 059d365b-3752-553d-8900-9a2d063f4e0e

	/// A year on cost: the annual operating-profit impact by 2032 of the moves in context over their capex, scenario in view. A derived ratio, not a valuation (no discounting, no ramp-up, no disruption).
	measure 'A Year on Cost' = DIVIDE ( [2032 Run-rate], SUM ( InvestmentProjects[CapexUSD] ) )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: f8b85be7-81db-5f2f-bfa6-022c3480525f

	/// A year on cost of the package(s) in context: 2032 run-rate over capex, scenario in view.
	measure 'Package A Year on Cost (sel)' = DIVIDE ( [Package Run-rate (sel)], [Package Capex] )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 7da727ac-7189-5cf9-a25a-4f3c216e0a96

	/// A year on cost of the recommendation (package A), scenario in view.
	measure 'Rec A Year on Cost (sel)' = VAR a = [Recommended Package] RETURN CALCULATE ( [Package A Year on Cost (sel)], REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 4367b6fa-822a-5401-ae46-7c660db1e660

	/// NPV through 2032 of the recommendation in the Low case, whatever the toggle says (the worst-case line).
	measure 'Rec NPV Low' = VAR a = [Recommended Package] RETURN CALCULATE ( SUM ( Package[NPV Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: d3a6946b-42ed-5201-b6ef-747eecbc9523

	/// Profit a year by 2032 of the recommendation in the Low case, whatever the toggle says (the worst-case line).
	measure 'Rec Run-rate Low' = VAR a = [Recommended Package] RETURN CALCULATE ( SUM ( Package[RunRate Low] ), REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: f732fc14-eb89-5490-9e18-2481fa853a10

	/// NPV through 2032 of the recommendation in the Expected case, whatever the toggle says (the tile's first line in the Low view).
	measure 'Rec NPV Expected' = VAR a = [Recommended Package] RETURN CALCULATE ( SUM ( Package[NPV Expected] ), REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 56b64ce1-80ed-5836-b26d-97c619bb01b7

	/// Profit a year by 2032 of the recommendation in the Expected case, whatever the toggle says (the tile's first line in the Low view).
	measure 'Rec Run-rate Expected' = VAR a = [Recommended Package] RETURN CALCULATE ( SUM ( Package[RunRate Expected] ), REMOVEFILTERS ( Package ), Package[PackageID] = a )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 5630dd7d-3c56-5ebc-9736-8c6562530075

	/// Profit a year by 2032 of the plan being built, scenario in view; blank while nothing is picked.
	measure 'Build Run-rate (sel)' = VAR act = CALCULATE ( ISFILTERED ( BuildMove[ProjectID] ) || ISFILTERED ( BuildMove[Short Name] ) || ISFILTERED ( BuildMove[Sort] ), ALLSELECTED ( BuildMove ) ) VAR ids = SELECTCOLUMNS ( FILTER ( CALCULATETABLE ( VALUES ( BuildMove[ProjectID] ), ALLSELECTED ( BuildMove ) ), act ), "@p", BuildMove[ProjectID] ) VAR n = COUNTROWS ( ids ) + 0 RETURN IF ( n = 0, BLANK (), CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: bb637438-f737-5875-b7de-65fe788b654f

	/// A year on cost of the plan being built, scenario in view; blank while nothing is picked.
	measure 'Build A Year on Cost (sel)' = DIVIDE ( [Build Run-rate (sel)], [Build Capex] )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 481db454-6907-5420-8836-882564496c32

	/// Selector row (BuildMove): profit a year by 2032 of the move alone, scenario in view.
	measure 'Move Run-rate (num)' = VAR p = COALESCE ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ), SELECTEDVALUE ( BuildMove[ProjectID] ) ) RETURN IF ( ISBLANK ( p ), BLANK (), CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), InvestmentProjects[ProjectID] = p ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: e42f9d6e-9b04-5238-8f15-9515076ba125

	/// Mark colour of a move by its decision status (MoveDecision): Coffee Blue for package A, Night for the 2028 gate, Warm Grey for not now. A mark colour (3.5:1 at the lightest): the status word carries the state.
	measure 'Move Status Color' = VAR st = LOOKUPVALUE ( MoveDecision[Status], MoveDecision[ProjectID], SELECTEDVALUE ( InvestmentProjects[ProjectID] ) ) RETURN IF ( ISBLANK ( st ), BLANK (), SWITCH ( st, "A", "#2589D8", "2028 gate", "#12233D", "#8E897D" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 89662495-368d-5a7a-a5db-d8073d45c822

	/// Hero table, NPV panel: Coffee Blue for the moves of package A, the light neutral for every other move (a labelled background mark: the value stands beside the bar, the status in its own column).
	measure 'Move NPV Bar Color' = VAR st = LOOKUPVALUE ( MoveDecision[Status], MoveDecision[ProjectID], SELECTEDVALUE ( InvestmentProjects[ProjectID] ) ) RETURN IF ( ISBLANK ( st ), BLANK (), IF ( st = "A", "#2589D8", "#C9C4B7" ) )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		lineageTag: 1965f6c5-9131-534d-b776-be43d2dbc98d

	/// Hero table, bar cell of 'a year on cost' for the move in the row (scenario in view): a bar from 0 in the move's status colour and the 8 % line (our cost of money). Fixed domain -10 % to 90 %. Decorative: the value stands in the column beside it.
	measure 'Hero Yield Bar SVG' = VAR v = [A Year on Cost] VAR c = MIN ( MAX ( v, -0.1 ), 0.9 ) VAR xv = -3.0 + ( c - ( -0.1 ) ) / 1.0 * 188 VAR x0 = 15.8 VAR fill = SUBSTITUTE ( [Move Status Color], "#", "%23" ) RETURN IF ( ISBLANK ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ) ) || ISBLANK ( v ), BLANK (), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='173' height='34' viewBox='0 0 173 34'><rect x='" & FORMAT ( MIN ( x0, xv ), "0.0", "en-US" ) & "' y='3' width='" & FORMAT ( ABS ( xv - x0 ), "0.0", "en-US" ) & "' height='18' fill='" & fill & "'/><rect x='30.34' y='0' width='1' height='34' fill='%2312233D' shape-rendering='crispEdges'/></svg>" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		dataCategory: ImageUrl
		lineageTag: f249eec3-edc6-5b60-94d4-e7ff202368b1

	/// Hero table, bar cell of the NPV through 2032 for the move in the row (scenario in view): a bar from 0, Coffee Blue for package A's moves and the light neutral for the rest, and the zero line (pays back by 2032 to its right). Fixed domain -$32M to +$12M. Decorative: the value stands in the column beside it.
	measure 'Hero NPV Bar SVG' = VAR v = [NPV @ 8%] VAR c = MIN ( MAX ( v, -32000000.0 ), 12000000.0 ) VAR xv = -3.0 + ( c - ( -32000000.0 ) ) / 44000000.0 * 172 VAR x0 = 122.0909090909091 VAR fill = SUBSTITUTE ( [Move NPV Bar Color], "#", "%23" ) RETURN IF ( ISBLANK ( SELECTEDVALUE ( InvestmentProjects[ProjectID] ) ) || ISBLANK ( v ), BLANK (), "data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='173' height='34' viewBox='0 0 173 34'><rect x='" & FORMAT ( MIN ( x0, xv ), "0.0", "en-US" ) & "' y='3' width='" & FORMAT ( ABS ( xv - x0 ), "0.0", "en-US" ) & "' height='18' fill='" & fill & "'/><rect x='121.59' y='0' width='1' height='34' fill='%2312233D' shape-rendering='crispEdges'/></svg>" )
		formatString: @
		displayFolder: 15 Storytelling rebuild
		dataCategory: ImageUrl
		lineageTag: 7461fb07-bd4e-5113-8920-80090fafab9b

	/// Capex of tranche 1 (package A, funded now); a segment of the plan bar.
	measure 'Tranche 1 Capex' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 1 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 8341e038-37b6-5c53-b9c1-1501cd321515

	/// Capex of tranche 2 (the airport extensions, decided at the 2028 gate); a segment of the plan bar.
	measure 'Tranche 2 Capex' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: fd012a28-1416-5d64-93c5-bffcb55fdc24

	/// Profit a year once live of tranche 2 (the airport extensions, decided at the 2028 gate), scenario in view.
	measure 'Tranche 2 Run-rate' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 2 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: e7053bfd-3004-5612-9a56-a0f1d8653d97

	/// A year on cost of tranche 2 (the airport extensions, decided at the 2028 gate), scenario in view.
	measure 'Tranche 2 Year on Cost' = DIVIDE ( [Tranche 2 Run-rate], [Tranche 2 Capex] )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 1c35e2b2-a3ae-54d1-b79a-492b330eb1ff

	/// Capex of tranche 3 (the refresh, decided at the 2028 gate); a segment of the plan bar.
	measure 'Tranche 3 Capex' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 3 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( SUM ( InvestmentProjects[CapexUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: e4d07ab2-bd69-554f-a41e-151b99a26b96

	/// Profit a year once live of tranche 3 (the refresh, decided at the 2028 gate), scenario in view.
	measure 'Tranche 3 Run-rate' = VAR ids = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Tranche] = 3 ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( ids, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: b7121f10-9072-5062-9443-51407f1bb50f

	/// A year on cost of tranche 3 (the refresh, decided at the 2028 gate), scenario in view.
	measure 'Tranche 3 Year on Cost' = DIVIDE ( [Tranche 3 Run-rate], [Tranche 3 Capex] )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 00f4c9a4-9565-5b70-9fa0-a79771c8e5f2

	/// The part of the Goodnight Inn budget no tranche asks for; the last segment of the plan bar (the four segments add up to the budget by construction).
	measure 'Not Needed Capex' = CALCULATE ( SUM ( Brands[InvestmentBudgetUSD] ), REMOVEFILTERS ( Brands ), Brands[Brand] = "Goodnight Inn" ) - [Tranche 1 Capex] - [Tranche 2 Capex] - [Tranche 3 Capex]
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: d1cb8915-932f-5c17-abd9-c1a47fdd8062

	/// Goodnight Inn distribution cost as a share of room revenue, 2025 (the ledger's F2 start).
	measure 'Dist Cost % 2025 GI' = CALCULATE ( [Distribution Cost % of Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: e4beb3e1-22fa-5b88-8ccd-2faaaa4f7fee

	/// Ledger F2: the 2025 distribution cost share of room revenue plus the organisers' change in points for the moves of package A, scenario in view. 2025 brand, A at full effect; not a forecast of 2032.
	measure 'Dist Cost % 2032 with A (sel)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] RETURN [Dist Cost % 2025 GI] + CALCULATE ( SUM ( InvestmentScenarios[DistributionCostChangePts] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( aIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = s )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: e4ac6146-04ee-5e85-b862-f4ec220a65d7

	/// Ledger F1: operating margin after commissions of the 2025 brand with package A's full yearly profit and revenue impact added, scenario in view. In 2025 dollars; not a forecast of 2032.
	measure 'Margin after 2032 with A (sel)' = VAR a = [Recommended Package] VAR aIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( PackageProject ), PackageProject[PackageID] = a ), "@p", PackageProject[ProjectID] ) VAR s = [Selected Scenario] VAR tot = CALCULATE ( [Total Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) VAR gopa = CALCULATE ( [GOP after Distribution], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN DIVIDE ( gopa + CALCULATE ( SUM ( InvestmentScenarios[AnnualOperatingProfitImpactUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( aIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = s ), tot + CALCULATE ( SUM ( InvestmentScenarios[AnnualRevenueImpactUSD] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( aIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = s ) )
		formatString: 0.0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: 78a53f86-1a35-56dd-9770-d4bd19a108d3

	/// Ledger F2 status: the share of the 2021 to 2025 rise in distribution cost (points of room revenue) that package A undoes, scenario in view.
	measure 'Dist Cost Rise Undone % (sel)' = VAR d21 = CALCULATE ( [Distribution Cost % of Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2021 ) VAR d25 = [Dist Cost % 2025 GI] RETURN DIVIDE ( d25 - [Dist Cost % 2032 with A (sel)], d25 - d21 )
		formatString: 0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: b8ac6276-1c70-58da-acee-a5e473a265f9

	/// Ledger F1 status: the share of the 2023 to 2025 fall in the margin after commissions that package A recovers, scenario in view.
	measure 'Margin Fall Recovered % (sel)' = VAR m23 = CALCULATE ( [GOP Margin after Distribution %], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2023 ) VAR m25 = [KPI Margin after GI] RETURN DIVIDE ( [Margin after 2032 with A (sel)] - m25, m23 - m25 )
		formatString: 0%
		displayFolder: 15 Storytelling rebuild
		lineageTag: e7f73313-18fe-5f26-8e76-7475f63f4c50

	/// What the booking app saves in commissions a year: its change in distribution cost (points of room revenue, scenario in view) on 2025 room revenue. Also what every year without it leaves with the agencies.
	measure 'App Commission Saving (sel)' = VAR appIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "II" ), "@p", MoveDecision[ProjectID] ) VAR s = [Selected Scenario] VAR rr = CALCULATE ( [Channel Room Revenue], REMOVEFILTERS ( Brands ), REMOVEFILTERS ( Hotels ), Brands[Brand] = "Goodnight Inn", REMOVEFILTERS ( 'Date' ), 'Date'[Year] = 2025 ) RETURN - CALCULATE ( SUM ( InvestmentScenarios[DistributionCostChangePts] ), REMOVEFILTERS ( InvestmentProjects ), TREATAS ( appIds, InvestmentProjects[ProjectID] ), InvestmentScenarios[Scenario] = s ) * rr
		formatString: \$#,0,,.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: 845720ab-573a-58ac-b14c-a95c8f27e7f1

	/// NPV through 2032 of the booking app alone (the move of A that answers F2), scenario in view.
	measure 'App NPV (sel)' = VAR appIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "II" ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [NPV @ 8%], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( appIds, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
		displayFolder: 15 Storytelling rebuild
		lineageTag: e01070e9-d7fc-5965-a2cc-fa141c227a1b

	/// Profit a year by 2032 of the booking app alone, scenario in view.
	measure 'App Run-rate (sel)' = VAR appIds = SELECTCOLUMNS ( FILTER ( ALLNOBLANKROW ( MoveDecision ), MoveDecision[Status] = "A" && MoveDecision[Finding] = "II" ), "@p", MoveDecision[ProjectID] ) RETURN CALCULATE ( [2032 Run-rate], REMOVEFILTERS ( InvestmentProjects ), TREATAS ( appIds, InvestmentProjects[ProjectID] ) )
		formatString: +\$#,0,,.0\M;−\$#,0,,.0\M;\$0.0\M
