/// Axis table 2021-2032 that joins actuals (via Date) and the outlook (via HotelOutlook) on one chart.
table Timeline
	lineageTag: 12bd514f-cbef-58af-b68b-d4fe18ebeb3c

	column Year
		dataType: int64
		formatString: 0
		lineageTag: a0cca3b2-d617-5b4d-8290-1ce8eb426532
		summarizeBy: none
		isNameInferred
		isDataTypeInferred
		sourceColumn: [Year]

	partition Timeline = calculated
		mode: import
		source = ```
				SELECTCOLUMNS ( GENERATESERIES ( 2021, 2032, 1 ), "Year", [Value] )
				```

	annotation PBI_ResultType = Table
