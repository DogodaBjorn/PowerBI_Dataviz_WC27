/// Disconnected year stepper 2027-2032 for the wall: it relights the matrix without filtering any fact.
table PlanYear
	lineageTag: c14e12b0-df1f-5eb3-9fb7-4c2ee57e5720

	column Year
		formatString: 0
		lineageTag: 0a193b03-f989-5fdf-8735-69ec62aa0bc1
		summarizeBy: none
		isNameInferred
		sourceColumn: [Year]

	partition PlanYear = calculated
		mode: import
		source = SELECTCOLUMNS ( GENERATESERIES ( 2027, 2032, 1 ), "Year", [Value] )

	annotation PBI_ResultType = Table

