/// Disconnected package selector (no relationships, by design): the three named packages A, B and C (Package[Preset]). The slicer on Label is single-select; DAX reads Key.
table PlanSelector
	lineageTag: f406f644-e976-5b4e-9e67-459c5452eae8

	column Key
		lineageTag: 805d065f-c570-51c6-ac4b-5ce0542bed48
		summarizeBy: none
		isNameInferred
		sourceColumn: [Key]

	column Label
		lineageTag: 033f80bc-9e47-565b-9103-fe515e438f31
		summarizeBy: none
		isNameInferred
		sourceColumn: [Label]
		sortByColumn: Sort

	column Sort
		formatString: 0
		lineageTag: 3fdccaaf-cbb8-5398-a162-3bdd042880b4
		summarizeBy: none
		isNameInferred
		sourceColumn: [Sort]

	partition PlanSelector = calculated
		mode: import
		source =
				DATATABLE (
				    "Key", STRING, "Label", STRING, "Sort", INTEGER,
				    {
				        { "A", "A · Our recommendation", 1 },
				        { "B", "B · Breakfast instead of kiosks", 2 },
				        { "C", "C · Why not renovate? For comparison", 3 }
				    }
				)

	annotation PBI_ResultType = Table

