model Model
	culture: en-US
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-US
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Facts

	annotation PBI_QueryGroupOrder = 0

queryGroup Dimensions

	annotation PBI_QueryGroupOrder = 1

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_QueryOrder = ["DataFile","Date","Scenario","Brands","Hotels","Renovations","MonthlyPerformance","BookingChannels","GuestExperience","GuestComplaints","InvestmentProjects","InvestmentProjectProperties","InvestmentScenarios","FinanceParameters","_Measures"]

annotation PBI_ProTooling = ["DevMode"]

ref table Date
ref table Scenario
ref table Brands
ref table Hotels
ref table Renovations
ref table MonthlyPerformance
ref table BookingChannels
ref table GuestExperience
ref table GuestComplaints
ref table InvestmentProjects
ref table InvestmentProjectProperties
ref table InvestmentScenarios
ref table FinanceParameters
ref table _Measures
ref table ProjectCashflow
ref table FolioLine
ref table Package
ref table PackageProject
ref table PlanSelector
ref table BuildMove
ref table BuildBar
ref table TTMove
ref table BuildPoint
ref table MoveDecision
ref table Finding
ref table WaitOption
