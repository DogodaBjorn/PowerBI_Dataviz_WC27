          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Table of every listing rated exactly 10.0, sorted fewest votes first, then by title so the order is stable. Columns: poster, title, raw rating, vote count, and a verdict column that prints thin evidence in words beside the colour. The finding is that a perfect score says nothing on its own, because the top of this table is listings carrying a single vote. Selecting a bar in the vote-band chart filters this table.'"
                }
              }
            }
