          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Line chart of the share of listings with credible financials, by decade of release. Credible means a budget of at least $10,000 with revenue above zero. Listings with no release date are absent from this chart and are counted in the sentence above it. The finding is that coverage is an archive effect: recent decades are far better covered than early ones, so a low overall coverage figure describes the record, not the industry.'"
                }
              }
            }
          }
        }
      ]
