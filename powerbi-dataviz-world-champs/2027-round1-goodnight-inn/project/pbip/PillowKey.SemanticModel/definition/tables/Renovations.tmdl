/// Grain: one renovation per row (1985-2023). Used for renovation spend per hotel only.
table Renovations
	lineageTag: ef621b43-0bc1-5ba8-8d4a-da19f306b6f4

	column HotelID
		dataType: string
		isHidden
		lineageTag: 1d48291f-b7f8-571c-9e7a-8f317afe98a4
		summarizeBy: none
		sourceColumn: HotelID

	column StartDate
		dataType: dateTime
		formatString: Short Date
		lineageTag: 156609d4-20a8-516b-aeb5-da68091ec150
		summarizeBy: none
		sourceColumn: StartDate

		annotation UnderlyingDateTimeDataType = Date

	column CostUSD
		dataType: int64
		formatString: 0
		lineageTag: 22aa808a-837a-5d0e-82e2-c118bca1e8a5
		summarizeBy: none
		sourceColumn: CostUSD


	partition Renovations = m
		mode: import
		queryGroup: Facts
		source =
				let
				    Source = Excel.Workbook(Web.Contents(DataFile), null, true),
				    Sheet = Source{[Item="Renovations",Kind="Sheet"]}[Data],
				    Promoted = Table.PromoteHeaders(Sheet, [PromoteAllScalars=true]),
				    Selected = Table.SelectColumns(Promoted, {"HotelID", "StartDate", "CostUSD"}),
				    Typed = Table.TransformColumnTypes(Selected, {{"HotelID", type text}, {"StartDate", type date}, {"CostUSD", Int64.Type}})
				in
				    Typed


	annotation PBI_ResultType = Table
