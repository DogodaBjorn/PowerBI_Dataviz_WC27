table Keyword
	lineageTag: b5c96294-b2f5-483c-9024-2cb6ca0c54a5

	column Keywords
		dataType: string
		lineageTag: bcf6265d-2945-4326-82ee-bbe25d639279
		summarizeBy: none
		sourceColumn: Keywords

		annotation SummarizationSetBy = Automatic

	column 'Keyword ID'
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 76b5abd6-b631-4953-8b4f-2ab73733b007
		summarizeBy: none
		sourceColumn: Keyword ID

		changedProperty = IsHidden

		annotation SummarizationSetBy = Automatic

	partition Keyword = m
		mode: import
		queryGroup: Dimensions
		source =
				let
				    Source = Source,
				    Keywords =
				        Table.SelectColumns(Source, {"keywords"}),
				
				    SplitKeywords =
				        Table.ExpandListColumn(
				            Table.TransformColumns(
				                Keywords,
				                {
				                    {
				                        "keywords",
				                        each List.Transform(
				                            Splitter.SplitTextByDelimiter(",", QuoteStyle.Csv)(_),
				                            each Text.Clean(Text.Trim(_))
				                        ),
				                        type {text}
				                    }
				                }
				            ),
				            "keywords"
				        ),
				
				    KeywordDimension =
				        Table.AddIndexColumn(
				            Table.Sort(
				                Table.Distinct(
				                    Table.SelectRows(
				                        SplitKeywords,
				                        each [keywords] <> null and [keywords] <> ""
				                    )
				                ),
				                {{"keywords", Order.Ascending}}
				            ),
				            "KeywordID",
				            1,
				            1,
				            Int64.Type
				        ),
				    #"Renamed Columns" = Table.RenameColumns(KeywordDimension,{{"keywords", "Keywords"}, {"KeywordID", "Keyword ID"}})
				in
				    #"Renamed Columns"

	annotation PBI_NavigationStepName = Navigation

	annotation PBI_ResultType = Table

