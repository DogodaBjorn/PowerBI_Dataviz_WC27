# Contests: one repository, one folder per contest. Each project folder keeps its
# own .gitignore for what is particular to it; this file holds what goes for all.

# --- OS / editor noise ---
Thumbs.db
.DS_Store
desktop.ini

# --- Power BI Desktop's local state (never commit) ---
**/.pbi/cache.abf
**/.pbi/localSettings.json

# --- Build leftovers ---
node_modules/
__pycache__/
*.pyc
